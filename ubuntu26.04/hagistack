cmd_all_in_one() {
    log_step "hagistack $HAGISTACK_VERSION — all-in-one"
    log_info "stage: $HAGISTACK_STAGE"
    _need_privilege
    phase_preflight
    if [ "$DRY_RUN" -eq 1 ]; then
        print_resolved_config
        echo
        log_ok "--check: preflight only, no changes made"
        return 0
    fi
    phase_secrets
    phase_base_packages
    phase_database
    phase_rabbitmq
    phase_memcached
    phase_keystone
    phase_glance
    phase_placement
    phase_ovn
    phase_neutron
    phase_nova
    phase_nova_compute
    phase_horizon
    phase_bootstrap_resources
    print_stage_banner
    # `exit` rather than `return`: a non-zero return would trip the ERR trap and
    # print an "aborted" line, which this is not.
    [ -z "$SKIPPED_PHASES" ] || exit 4
}

cmd_compute_add() {
    log_step "hagistack $HAGISTACK_VERSION — compute-add"
    log_info "stage: $HAGISTACK_STAGE"
    log_info "this adds a COMPUTE node. Run it on the new machine, not on the controller."
    _need_privilege
    phase_compute_preflight
    if [ "$DRY_RUN" -eq 1 ]; then
        print_resolved_config
        echo
        log_ok "--check: preflight only, no changes made"
        return 0
    fi
    phase_compute_secrets
    phase_compute_packages
    phase_compute_ovn
    phase_compute_nova
    phase_compute_metadata
    print_compute_banner
    [ -z "$SKIPPED_PHASES" ] || exit 4
}

# Emit exactly the credentials a compute node needs — and nothing else. Run on
# the CONTROLLER. Refuses to write to a terminal: these are live secrets and a
# terminal keeps scrollback.
cmd_compute_secrets() {
    _need_privilege
    if [ -t 1 ]; then
        die "refusing to print credentials to a terminal.
     Redirect them to a file instead:
         sudo ${SELF##*/} compute-secrets > compute-secrets.env
         chmod 600 compute-secrets.env"
    fi
    $SUDO test -f "$SECRETS_FILE" \
        || die "$SECRETS_FILE does not exist. Run 'all-in-one' on this machine first."
    # shellcheck disable=SC1090
    . <($SUDO cat "$SECRETS_FILE")
    local k lacking=""
    for k in $COMPUTE_SECRET_KEYS; do
        [ -n "${!k:-}" ] || lacking="${lacking}${lacking:+ }$k"
    done
    [ -z "$lacking" ] || die "$SECRETS_FILE is missing: $lacking"
    echo "# hagistack compute-node credentials — generated $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    echo "# Install on the compute node as $SECRETS_FILE, mode 0600, and delete this copy."
    echo "# Deliberately NOT included: every database password, MYSQL_ROOT_PASS and"
    echo "# ADMIN_PASSWORD. A compute node reaches the cell database only through"
    echo "# nova-conductor, and nothing on it authenticates as admin."
    for k in $COMPUTE_SECRET_KEYS; do
        printf '%s=%s\n' "$k" "${!k}"
    done
    log_ok "wrote $(echo "$COMPUTE_SECRET_KEYS" | wc -w | tr -d ' ') credentials (values not echoed here)" >&2
}

# Map any compute host that has registered itself into a cell. Run on the
# CONTROLLER after compute-add: a compute node has no database access, so it
# cannot do this for itself.
cmd_discover_hosts() {
    _need_privilege
    $SUDO test -f "$SECRETS_FILE" \
        || die "$SECRETS_FILE does not exist. This command belongs on the controller."
    # shellcheck disable=SC1090
    . <($SUDO cat "$SECRETS_FILE")
    [ -n "$MGMT_IP" ] || MGMT_IP="$(ip -4 -o route get 1.1.1.1 2>/dev/null \
        | awk '{for(i=1;i<=NF;i++) if($i=="src") print $(i+1)}' | head -1 || true)"
    valid_ipv4 "${MGMT_IP:-}" || die "could not determine MGMT_IP; pass --mgmt-ip"
    REGION_NAME="${REGION_NAME:-RegionOne}"

    log_step "cell host discovery"
    log_info "compute services currently registered:"
    openstack_admin compute service list --service nova-compute 2>/dev/null \
        | sed 's/^/    /' || log_warn "could not read the compute service list"
    if nova_manage cell_v2 discover_hosts --by-service >/dev/null 2>&1; then
        log_ok "discovery ran (hosts already mapped are left alone)"
    else
        die "'nova-manage cell_v2 discover_hosts' failed. Check nova-conductor and the
     cell databases on this controller."
    fi
    log_info "hypervisors visible to the compute API:"
    openstack_admin hypervisor list 2>/dev/null | sed 's/^/    /' \
        || log_warn "could not read the hypervisor list"
    log_warn "a mapped hypervisor is not a booted guest. Guest boot stays unverified."
}

cmd_status() {
    detect_os; detect_container; detect_init
    echo "hagistack $HAGISTACK_VERSION"
    echo "stage    : $HAGISTACK_STAGE"
    echo "os       : ${OS_PRETTY:-unknown}"
    echo "init     : $([ "$HAS_SYSTEMD" -eq 1 ] && echo systemd || echo 'no systemd')"
    echo "secrets  : $([ -f "$SECRETS_FILE" ] && echo "$SECRETS_FILE (mode $($SUDO stat -c '%a' "$SECRETS_FILE" 2>/dev/null || echo '?'))" || echo 'not created yet')"
    echo
    echo "IMPLEMENTED (the code exists and runs) and VERIFIED (observed working on"
    echo "real hardware) are different claims. This command prints both, separately."
    echo
    echo "implemented, all-in-one : $IMPLEMENTED_PHASES"
    echo "implemented, compute-add: $COMPUTE_ADD_PHASES"
    echo "not implemented         : ${PENDING_PHASES:-nothing}"
    echo "verified on hardware    : $VERIFIED_ON_HARDWARE"
    echo "still unverified        : $UNVERIFIED_ITEMS"
    echo
    echo "phase markers on THIS host:"
    local p incomplete="" role_aio=0 role_compute=0
    for p in $IMPLEMENTED_PHASES; do
        if phase_done "$p"; then
            printf '  %-20s %s\n' "$p" "done"; role_aio=1
        else
            printf '  %-20s %s\n' "$p" "not done"
            incomplete="${incomplete}${incomplete:+ }$p"
        fi
    done
    for p in $COMPUTE_ADD_PHASES; do
        if phase_done "$p"; then printf '  %-20s %s\n' "$p" "done (compute-add)"; role_compute=1; fi
    done
    echo
    if [ "$role_compute" -eq 1 ] && [ "$role_aio" -eq 0 ]; then
        echo "role: this host looks like a COMPUTE node added with 'compute-add'."
        echo "      It holds no database or admin credential, so it cannot report"
        echo "      whether the controller has mapped it. Run 'hagistack discover-hosts'"
        echo "      on the controller to find out."
    elif [ -z "$incomplete" ]; then
        echo "all-in-one: every implemented phase carries a state marker."
        echo "            That means the code ran, NOT that the cloud works."
    else
        echo "all-in-one: INCOMPLETE — missing: $incomplete"
        echo "            'all-in-one' exits 4 while any of these is missing."
    fi
    echo "NOTE: no guest VM has been booted or verified by anything in this repository,"
    echo "      and nobody has logged in to the dashboard. The provider bridge has no"
    echo "      NIC attached and no address, so provider networks reach no physical"
    echo "      LAN, and node-to-node Geneve is untested until a second node joins."
    echo
    echo "identity:"
    printf '  %-16s %s\n' "keystone pkg" \
        "$(dpkg-query -W -f='${Version}' keystone 2>/dev/null || echo 'not installed')"
    printf '  %-16s %s\n' "served by" "apache2 + mod_wsgi (no keystone systemd unit exists)"
    printf '  %-16s %s\n' "admin openrc" \
        "$($SUDO test -f "$ADMIN_OPENRC" && echo "$ADMIN_OPENRC (mode $($SUDO stat -c '%a' "$ADMIN_OPENRC"))" || echo 'not created yet')"
    printf '  %-16s %s\n' "fernet keys" \
        "$($SUDO test -s "$KEYSTONE_FERNET_DIR/0" && echo present || echo absent)"
    printf '  %-16s %s\n' "credential keys" \
        "$($SUDO test -s "$KEYSTONE_CRED_DIR/0" && echo present || echo absent)"
    echo
    echo "image / placement:"
    printf '  %-16s %s\n' "glance pkg" \
        "$(dpkg-query -W -f='${Version}' glance 2>/dev/null || echo 'not installed')"
    printf '  %-16s %s\n' "  served by" "glance-api.service (its own systemd unit)"
    printf '  %-16s %s\n' "placement pkg" \
        "$(dpkg-query -W -f='${Version}' placement-api 2>/dev/null || echo 'not installed')"
    printf '  %-16s %s\n' "  served by" "apache2 + mod_wsgi on :8778 (no placement systemd unit)"
    echo
    echo "networking:"
    printf '  %-16s %s\n' "neutron pkg" \
        "$(dpkg-query -W -f='${Version}' neutron-api 2>/dev/null || echo 'not installed')"
    printf '  %-16s %s\n' "  API" "apache2 + mod_wsgi on :9696 (from neutron-api; no API unit)"
    printf '  %-16s %s\n' "  other units" "$NEUTRON_UNITS"
    printf '  %-16s %s\n' "ovn pkg" \
        "$(dpkg-query -W -f='${Version}' ovn-central 2>/dev/null || echo 'not installed')"
    printf '  %-16s %s\n' "  real units" "$OVN_CENTRAL_UNITS $OVN_HOST_UNITS"
    printf '  %-16s %s\n' "mgmt / geneve" "$MGMT_IP"
    printf '  %-16s %s\n' "provider" "${PROVIDER_PHYSNET}:${PROVIDER_BRIDGE} (no NIC, no address)"
    echo
    echo "compute:"
    printf '  %-16s %s\n' "nova pkg" \
        "$(dpkg-query -W -f='${Version}' nova-common 2>/dev/null || echo 'not installed')"
    printf '  %-16s %s\n' "  API" "apache2 + mod_wsgi on :8774 (nova-api ships no unit)"
    printf '  %-16s %s\n' "  metadata" "apache2 + mod_wsgi on :8775 (nova-api-metadata)"
    printf '  %-16s %s\n' "  units" "$NOVA_UNITS $NOVA_COMPUTE_UNITS"
    printf '  %-16s %s\n' "  virt type" "${VIRT_TYPE:-unresolved} (guest boot NOT verified)"
    echo
    echo "dashboard:"
    printf '  %-16s %s\n' "horizon pkg" \
        "$(dpkg-query -W -f='${Version}' openstack-dashboard 2>/dev/null || echo 'not installed')"
    printf '  %-16s %s\n' "  served by" "apache2 + mod_wsgi at ${HORIZON_PATH} (conf-available, not a vhost)"
    printf '  %-16s %s\n' "  settings" \
        "$($SUDO test -f "$HORIZON_SNIPPET" && echo "$HORIZON_SNIPPET" || echo 'not written yet')"
    printf '  %-16s %s\n' "  conffile" "$HORIZON_LOCAL_SETTINGS (never edited by hagistack)"
    printf '  %-16s %s\n' "  login tested" "NO — never, by anyone"
    echo
    echo "initial resources (names hagistack owns):"
    printf '  %-16s %s\n' "flavor"   "$BS_FLAVOR"
    printf '  %-16s %s\n' "image"    "${IMAGE_NAME:-<unresolved>}"
    printf '  %-16s %s\n' "networks" "$BS_PROVIDER_NET, $BS_TENANT_NET"
    printf '  %-16s %s\n' "router"   "$BS_ROUTER"
    printf '  %-16s %s\n' "keypair"  "$BS_KEYPAIR ($KEYPAIR_PRIVATE)"
    if [ "$HAS_SYSTEMD" -eq 1 ]; then
        echo
        local u
        for u in mariadb rabbitmq-server memcached apache2 glance-api \
                 ovn-ovsdb-server-nb ovn-ovsdb-server-sb ovn-northd ovn-controller \
                 neutron-rpc-server neutron-periodic-workers neutron-ovn-maintenance-worker \
                 neutron-ovn-metadata-agent \
                 nova-conductor nova-scheduler nova-compute libvirtd; do
            printf '  %-16s %s\n' "$u" "$(systemctl is-active "$u" 2>/dev/null || echo inactive)"
        done
    else
        echo
        echo "  (service state unavailable: no systemd in this environment)"
    fi
}

usage() {
    cat <<EOF
hagistack $HAGISTACK_VERSION — OpenStack deployment shell for Ubuntu Server 26.04 LTS

  STAGE: $HAGISTACK_STAGE

  IMPLEMENTED and VERIFIED are different claims and this shell keeps them apart:

    implemented : every phase of 'all-in-one' and of 'compute-add' exists here
                  and runs — base layer, Keystone, Glance, Placement, OVS/OVN,
                  Neutron, Nova, Horizon, and the initial resources a guest
                  needs. Nothing is left as a stub.
    verified    : $VERIFIED_ON_HARDWARE
                  Container work proved syntax, configuration generation and
                  re-run safety. It cannot prove any of:
                    $UNVERIFIED_ITEMS
                  Treat this as untested software until those are observed.

  Every phase being implemented does NOT give you a working OpenStack. It gives
  you one that has never been shown to work. The difference is the whole point
  of the two labels above.

  See README.md in this directory.

usage:
  hagistack all-in-one      [options]  controller + compute on one host
  hagistack compute-add     [options]  configure THIS host as an extra compute
                                       node; needs --controller-ip
  hagistack compute-secrets            (controller) emit only the credentials a
                                       compute node needs; refuses a terminal
  hagistack discover-hosts             (controller) map newly registered compute
                                       hosts into a cell
  hagistack status                     stage, phase markers and service state
  hagistack --help                     this text
  hagistack --version                  version string

options for all-in-one:
  --ext-nic NAME            provider/external interface            (required)
  --provider-cidr CIDR      external network, e.g. 172.24.4.0/24   (required)
  --provider-gateway IP     gateway on that network                (required)
  --floating-start IP       first floating IP                      (required)
  --floating-end IP         last floating IP                       (required)
  --tenant-cidr CIDR        demo tenant subnet      (default: 10.10.10.0/24)
  --dns-server IP           tenant DNS              (default: provider gateway)
  --provider-physnet NAME   provider physical-network label   (default: physnet1)
  --provider-bridge NAME    OVS bridge for that physnet       (default: br-ex)
  --image-name NAME         initial image name    (default: cirros-0.6.3-<arch>)
  --image-url URL           where to fetch it     (default: the cirros project)
  --image-sha256 HEX        its digest; a URL is never fetched without one
  --image-file PATH         use a local file instead of downloading

options for compute-add:
  --controller-ip IP        the controller's MANAGEMENT address    (required)
                            None of the provider-network options apply here.

options for both:
  --mgmt-ip IP              management IP           (default: autodetected)
  --virt-type kvm|qemu      hypervisor mode         (default: autodetected)
  --region-name NAME        Keystone region         (default: RegionOne)
  --env-file PATH           read settings from PATH (default: ./hagistack.env)
  --check                   run preflight only, change nothing
  -h, --help                this text

configuration precedence:
  command line  >  environment  >  ./hagistack.env  >  defaults/autodetect
  Applies to every option above. Giving a key an empty value on any tier is an
  error, so "set to blank" is never mistaken for "not given".
  '--check' prints the resolved value and its source for each key.

config file:
  Parsed, never executed. Only blank lines, '#' comments and KEY=VALUE are
  accepted; KEY must be a known setting and VALUE may contain only
  letters, digits and . _ - : / @ + = — shell metacharacters are refused.
  Use --env-file /dev/null to ignore all config files.

exit status:
  0  success
  1  configuration or preflight error
  2  usage error
  3  (unused: no subcommand is a stub any more)
  4  ran to the end, but the deployment is incomplete (a service was
     unreachable, so its phase was skipped and carries no state marker)

secrets:
  all-in-one generates them on first run into $SECRETS_FILE (mode 0600) and
  reuses them unchanged afterwards. No password is hard-coded in this shell and
  no secret is ever written into the repository.

  compute-add NEVER generates secrets: a compute node that invented its own
  RabbitMQ password could not talk to anything. Deliver them explicitly —
      controller:  sudo hagistack compute-secrets > compute-secrets.env
      copy over :  scp compute-secrets.env NODE:/tmp/
      node      :  sudo install -o root -g root -m 0600 /tmp/compute-secrets.env \
                       $SECRETS_FILE && shred -u /tmp/compute-secrets.env
  That file carries $COMPUTE_SECRET_KEYS
  and nothing else. No database password and no admin password ever reaches a
  compute node.

initial resources:
  all-in-one creates a flavor, image, provider and tenant networks, a router,
  two security group rules and a keypair — each show-or-create by name, none
  ever deleted or recreated. The image is downloaded only against a pinned
  sha256 and is tagged with that digest, so an image that hagistack did not
  upload (a leftover test image, say) is never mistaken for the initial one.

re-running:
  Safe. Databases are never dropped, existing secrets are never rotated,
  configuration is edited key-by-key rather than appended, and no initial
  resource is recreated.
EOF
}

# Record that a flag was GIVEN, separately from its value, so that an explicit
# empty value is distinguishable from an absent flag.
_cli_set() {
    [ $# -eq 2 ] || die "option $1 requires a value"
    CLI_VAL[$1]="$2"; CLI_SET[$1]=1
}

parse_args() {
    while [ $# -gt 0 ]; do
        case "$1" in
            --ext-nic)          [ $# -ge 2 ] || die "--ext-nic requires a value"
                                _cli_set EXT_NIC "$2"; shift 2 ;;
            --provider-cidr)    [ $# -ge 2 ] || die "--provider-cidr requires a value"
                                _cli_set PROVIDER_CIDR "$2"; shift 2 ;;
            --provider-gateway) [ $# -ge 2 ] || die "--provider-gateway requires a value"
                                _cli_set PROVIDER_GATEWAY "$2"; shift 2 ;;
            --floating-start)   [ $# -ge 2 ] || die "--floating-start requires a value"
                                _cli_set FLOATING_START "$2"; shift 2 ;;
            --floating-end)     [ $# -ge 2 ] || die "--floating-end requires a value"
                                _cli_set FLOATING_END "$2"; shift 2 ;;
            --mgmt-ip)          [ $# -ge 2 ] || die "--mgmt-ip requires a value"
                                _cli_set MGMT_IP "$2"; shift 2 ;;
            --tenant-cidr)      [ $# -ge 2 ] || die "--tenant-cidr requires a value"
                                _cli_set TENANT_CIDR "$2"; shift 2 ;;
            --dns-server)       [ $# -ge 2 ] || die "--dns-server requires a value"
                                _cli_set DNS_SERVER "$2"; shift 2 ;;
            --virt-type)        [ $# -ge 2 ] || die "--virt-type requires a value"
                                _cli_set VIRT_TYPE "$2"; shift 2 ;;
            --region-name)      [ $# -ge 2 ] || die "--region-name requires a value"
                                _cli_set REGION_NAME "$2"; shift 2 ;;
            --provider-physnet) [ $# -ge 2 ] || die "--provider-physnet requires a value"
                                _cli_set PROVIDER_PHYSNET "$2"; shift 2 ;;
            --provider-bridge)  [ $# -ge 2 ] || die "--provider-bridge requires a value"
                                _cli_set PROVIDER_BRIDGE "$2"; shift 2 ;;
            --controller-ip)    [ $# -ge 2 ] || die "--controller-ip requires a value"
                                _cli_set CONTROLLER_IP "$2"; shift 2 ;;
            --image-name)       [ $# -ge 2 ] || die "--image-name requires a value"
                                _cli_set IMAGE_NAME "$2"; shift 2 ;;
            --image-url)        [ $# -ge 2 ] || die "--image-url requires a value"
                                _cli_set IMAGE_URL "$2"; shift 2 ;;
            --image-sha256)     [ $# -ge 2 ] || die "--image-sha256 requires a value"
                                _cli_set IMAGE_SHA256 "$2"; shift 2 ;;
            --image-file)       [ $# -ge 2 ] || die "--image-file requires a value"
                                _cli_set IMAGE_FILE "$2"; shift 2 ;;
            --env-file)         [ $# -ge 2 ] || die "--env-file requires a value"
                                ENV_FILE="$2"; shift 2 ;;
            --check)            DRY_RUN=1; shift ;;
            -h|--help)          usage; exit 0 ;;
            --version)          echo "hagistack $HAGISTACK_VERSION"; exit 0 ;;
            --) shift; break ;;
            -*) log_error "unknown option: $1"; echo; usage >&2; exit 2 ;;
            *)  log_error "unexpected argument: $1"; echo; usage >&2; exit 2 ;;
        esac
    done
}

main() {
    local cmd="${1:-}"
    [ $# -gt 0 ] && shift || true
    case "$cmd" in
        all-in-one|compute-add|compute-secrets|discover-hosts|status) ;;
        ""|-h|--help)  usage; exit 0 ;;
        --version)     echo "hagistack $HAGISTACK_VERSION"; exit 0 ;;
        *) log_error "unknown command: $cmd"
           log_error "valid commands: all-in-one, compute-add, compute-secrets, discover-hosts, status"
           echo; usage >&2; exit 2 ;;
    esac

    # Collect the three tiers, then resolve once. No tier overwrites another
    # by side effect; precedence lives entirely in resolve_config().
    local saved=("$@")
    # `compute-secrets` writes a FILE to stdout. log_info and friends print to
    # stdout too, so the config-file line landed as the first line of the
    # credentials file — and because it reads
    #     config file: ./hagistack.env (parsed, not executed)
    # sourcing it on the compute node is a bash syntax error. Measured on GCE:
    #     /dev/fd/63: line 1: syntax error near unexpected token `('
    # For that one command every diagnostic goes to stderr instead.
    if [ "$cmd" = "compute-secrets" ]; then
        { parse_args "${saved[@]+"${saved[@]}"}"; load_env_file; resolve_config; } >&2
    else
        parse_args "${saved[@]+"${saved[@]}"}"
        load_env_file
        resolve_config
    fi

    case "$cmd" in
        all-in-one)      cmd_all_in_one ;;
        compute-add)     cmd_compute_add ;;
        compute-secrets) cmd_compute_secrets ;;
        discover-hosts)  cmd_discover_hosts ;;
        status)          cmd_status ;;
    esac
}

main "$@"
