#!/usr/bin/env bash
#
# hagistack — OpenStack deployment shell for Ubuntu Server 26.04 LTS
#
# Target : OpenStack 2026.1 Gazpacho, from the Ubuntu 26.04 distro archive.
# Engine : plain Bash. Not OpenStack-Ansible, Kolla-Ansible, Packstack or DevStack.
#
# STATUS — read the two words carefully, they are not the same claim:
#
#   IMPLEMENTED : the code to do it exists here and runs.
#                 all-in-one now covers the whole controller+compute path —
#                 MariaDB, RabbitMQ, memcached, Keystone, Glance, Placement,
#                 OVS/OVN, Neutron, Nova (API/conductor/scheduler/compute),
#                 Horizon, and the initial resources a guest needs.
#                 `compute-add` is implemented for a second compute node.
#
#   VERIFIED    : observed working on a real machine. That is still NOTHING.
#                 Nothing in this file has ever run on Ubuntu 26.04 hardware or
#                 on a GCE VM. The container work proves syntax, configuration
#                 generation and re-run safety — not that a guest boots.
#
# So: "implemented" does not mean "it works". Horizon login, guest boot,
# compute-add / Placement registration, the OVN chassis and node-to-node Geneve
# are all still unverified and are the GCE acceptance items.
#
set -Eeuo pipefail   # -E: the ERR trap must fire inside functions too

# Associative arrays and other bash 4 features are used throughout. Say so
# plainly instead of failing later with "declare: -A: invalid option" — which
# is what macOS's bash 3.2 produces.
if [ -z "${BASH_VERSINFO[0]:-}" ] || [ "${BASH_VERSINFO[0]}" -lt 4 ]; then
    echo "hagistack: needs bash 4 or newer; this is ${BASH_VERSION:-unknown}." >&2
    echo "  Ubuntu Server 26.04 (the only supported target) ships bash 5." >&2
    exit 1
fi

HAGISTACK_VERSION="0.7.0-step7"
HAGISTACK_STAGE="step7: all-in-one + compute-add implemented; guest boot and cross-node traffic VERIFIED on GCE 2026-09-28"

# Phases implemented in this step. `all-in-one` runs exactly these.
IMPLEMENTED_PHASES="preflight base_packages database rabbitmq memcached keystone glance placement ovn neutron nova nova_compute horizon bootstrap_resources"
# Phases `compute-add` runs on a second compute node.
COMPUTE_ADD_PHASES="compute_preflight compute_secrets compute_packages compute_ovn compute_nova compute_metadata"
# Nothing is left unimplemented for either command.
PENDING_PHASES=""

# What has actually been observed working on a real machine. Kept as a separate
# string from IMPLEMENTED_PHASES on purpose: `status`, `--help` and the closing
# banner all print both, and they must never be collapsed into one claim.
VERIFIED_ON_HARDWARE="on two GCE VMs 2026-09-28: guest boot on BOTH nodes, cloud-init, cross-node guest ping over a captured Geneve tunnel, Horizon login, cells v2, Placement, compute-add and re-run safety all PASSED"
# The specific behaviours a container cannot settle. Printed verbatim wherever
# the shell reports what it did, so that no reader has to infer it.
UNVERIFIED_ITEMS="any physical-LAN path (br-ex has no NIC on GCE, so floating IPs were never routed off-host); live migration; volumes/Cinder; more than two nodes"

