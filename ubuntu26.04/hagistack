# ---------------------------------------------------------------------------
# configuration
#
# Precedence: CLI flags > environment > ./hagistack.env > defaults/autodetect.
# ---------------------------------------------------------------------------
# Every value the operator can set, in one place. Used by the argument parser,
# the config-file parser (as its key allowlist) and the precedence resolver.
CONFIG_KEYS="MGMT_IP EXT_NIC PROVIDER_CIDR PROVIDER_GATEWAY FLOATING_START
             FLOATING_END DNS_SERVER TENANT_CIDR VIRT_TYPE REGION_NAME
             PROVIDER_PHYSNET PROVIDER_BRIDGE CONTROLLER_IP
             IMAGE_NAME IMAGE_URL IMAGE_SHA256 IMAGE_FILE"

# The same list with every run of whitespace collapsed to one space, and a
# space at each end, so that `case "$CONFIG_KEYS_FLAT" in *" $key "*)` works for
# every key regardless of where the line breaks fall.
CONFIG_KEYS_FLAT=" $(printf '%s' "$CONFIG_KEYS" | tr -s '[:space:]' ' ') "

declare -A CLI_VAL=()  CLI_SET=()
declare -A ENV_VAL=()  ENV_SET=()
declare -A FILE_VAL=() FILE_SET=()
declare -A CONFIG_SOURCE=()

# Capture the inherited environment BEFORE the defaults below blank these
# variables, otherwise the environment tier can never be observed.
# `printenv` succeeds only for a variable that is actually exported, and it
# distinguishes "exported but empty" from "not set" — which the resolver needs.
_capture_env() {
    local k
    for k in $CONFIG_KEYS; do
        if printenv "$k" >/dev/null 2>&1; then
            ENV_VAL[$k]="$(printenv "$k")"
            ENV_SET[$k]=1
        fi
    done
}
_capture_env

MGMT_IP="" EXT_NIC="" PROVIDER_CIDR="" PROVIDER_GATEWAY=""
FLOATING_START="" FLOATING_END="" DNS_SERVER="" TENANT_CIDR="" VIRT_TYPE=""
REGION_NAME="" PROVIDER_PHYSNET="" PROVIDER_BRIDGE="" CONTROLLER_IP=""
IMAGE_NAME="" IMAGE_URL="" IMAGE_SHA256="" IMAGE_FILE=""
DRY_RUN=0 ENV_FILE=""

# ---------------------------------------------------------------------------
# config file
#
# The file is PARSED, never sourced. Sourcing it made every value a shell
# command: `TENANT_CIDR=$(...)` or a backquoted value executed on load, even
# though each line looked like a harmless KEY=VALUE assignment.
#
# Accepted: blank lines, `#` comments, and `KEY=VALUE` where KEY is one of
# CONFIG_KEYS and VALUE contains only [A-Za-z0-9._:/@+=-]. One optional layer
# of matching quotes is stripped. Unknown keys, duplicate keys, malformed
# lines and values with any other character are refused.
# ---------------------------------------------------------------------------
ENVFILE_VALUE_RE='^[A-Za-z0-9._:/@+=-]*$'

load_env_file() {
    local f="${ENV_FILE:-}"
    if [ -z "$f" ]; then
        if   [ -f "./hagistack.env" ];             then f="./hagistack.env"
        elif [ -f "$SELF_DIR/hagistack.env" ];     then f="$SELF_DIR/hagistack.env"
        elif [ -f "$HAGISTACK_ETC/hagistack.env" ];then f="$HAGISTACK_ETC/hagistack.env"
        fi
    fi
    [ -n "$f" ] || return 0
    # Any readable path, not just a regular file, so --env-file /dev/null works.
    [ -r "$f" ] || die "env file not readable: $f"

    local -A seen=()
    local lineno=0 line key val
    while IFS= read -r line || [ -n "$line" ]; do
        lineno=$((lineno + 1))
        line="${line%$'\r'}"                       # tolerate CRLF
        [[ "$line" =~ ^[[:space:]]*(#|$) ]] && continue

        if [[ ! "$line" =~ ^[[:space:]]*([A-Za-z_][A-Za-z0-9_]*)[[:space:]]*=(.*)$ ]]; then
            die "$f line $lineno: not a KEY=VALUE assignment.
     Only blank lines, '#' comments and KEY=VALUE are allowed."
        fi
        key="${BASH_REMATCH[1]}"
        val="${BASH_REMATCH[2]}"
        val="${val%"${val##*[![:space:]]}"}"        # trim trailing blanks
        # strip one matching quote pair, if present
        if   [[ "$val" =~ ^\"(.*)\"$ ]]; then val="${BASH_REMATCH[1]}"
        elif [[ "$val" =~ ^\'(.*)\'$ ]]; then val="${BASH_REMATCH[1]}"
        fi

        # CONFIG_KEYS is written over several lines, so a key that happens to sit
        # at the end of one is followed by a NEWLINE, not a space. Matching
        # against " $CONFIG_KEYS " therefore missed those keys and reported them
        # as unknown — which is how FLOATING_START and REGION_NAME were refused
        # from a config file while working perfectly on the command line. The
        # list is normalised to single spaces before it is searched.
        case "$CONFIG_KEYS_FLAT" in
            *" $key "*) ;;
            *) die "$f line $lineno: unknown key '$key'.
     Allowed keys:${CONFIG_KEYS_FLAT%?}" ;;
        esac
        [ -z "${seen[$key]:-}" ] || die "$f line $lineno: duplicate key '$key'"
        seen[$key]=1

        # The value is deliberately NOT echoed back on failure.
        if [[ ! "$val" =~ $ENVFILE_VALUE_RE ]]; then
            die "$f line $lineno: the value of '$key' contains characters that are
     not allowed. Permitted: letters, digits and . _ - : / @ + =
     (the value itself is not shown). Shell metacharacters such as \$ \` ( ) ; & |
     are refused because this file is configuration, not a script."
        fi
        FILE_VAL[$key]="$val"
        FILE_SET[$key]=1
    done < "$f"
    log_info "config file: $f (parsed, not executed)"
}

# Precedence: command line > environment > config file > default.
# A tier that sets a key to the empty string is an error rather than a silent
# fall-through, so "explicitly blank" can never be mistaken for "not given".
resolve_config() {
    local k val src
    for k in $CONFIG_KEYS; do
        if   [ -n "${CLI_SET[$k]:-}" ];  then val="${CLI_VAL[$k]}";  src="command line"
        elif [ -n "${ENV_SET[$k]:-}" ];  then val="${ENV_VAL[$k]}";  src="environment"
        elif [ -n "${FILE_SET[$k]:-}" ]; then val="${FILE_VAL[$k]}"; src="config file"
        else                                  val="";                src="default"
        fi
        if [ "$src" != "default" ] && [ -z "$val" ]; then
            die "$k was given an empty value on the $src.
     Remove it to fall back to the default, or give it a real value."
        fi
        CONFIG_SOURCE[$k]="$src"
        printf -v "$k" '%s' "$val"
    done
}

print_resolved_config() {
    local k
    echo
    log_step "resolved configuration"
    for k in $CONFIG_KEYS; do
        printf '    %-18s %-22s [%s]\n' "$k" "${!k:-<unset>}" "${CONFIG_SOURCE[$k]:-default}"
    done
}

# ---------------------------------------------------------------------------
# input validation
# ---------------------------------------------------------------------------
valid_ipv4() {
    local ip="$1" o
    [[ "$ip" =~ ^([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})$ ]] || return 1
    for o in "${BASH_REMATCH[@]:1:4}"; do
        [ "$o" -le 255 ] 2>/dev/null || return 1
        # reject 01, 007 and friends
        [ "${#o}" -eq 1 ] || [ "${o#0}" = "$o" ] || return 1
    done
    return 0
}

valid_cidr() {
    local cidr="$1" ip prefix
    case "$cidr" in */*) ;; *) return 1 ;; esac
    ip="${cidr%%/*}"; prefix="${cidr#*/}"
    valid_ipv4 "$ip" || return 1
    [[ "$prefix" =~ ^[0-9]{1,2}$ ]] || return 1
    [ "$prefix" -ge 8 ] && [ "$prefix" -le 30 ] || return 1
    return 0
}

ip_to_int() {
    local IFS=. ; read -r a b c d <<< "$1"
    echo $(( (a<<24) + (b<<16) + (c<<8) + d ))
}

ip_in_cidr() {
    local ip="$1" cidr="$2" net prefix mask ipi neti
    net="${cidr%%/*}"; prefix="${cidr#*/}"
    mask=$(( 0xFFFFFFFF ^ ((1 << (32-prefix)) - 1) ))
    ipi=$(ip_to_int "$ip"); neti=$(ip_to_int "$net")
    [ $(( ipi & mask )) -eq $(( neti & mask )) ]
}

valid_nic_name() {
    local n="$1"
    [ -n "$n" ] || return 1
    [ "${#n}" -le 15 ] || return 1
    [[ "$n" =~ ^[A-Za-z0-9_.-]+$ ]] || return 1
    case "$n" in .|..) return 1 ;; esac
    return 0
}

nic_exists() { [ -e "/sys/class/net/$1" ]; }

valid_region_name() {
    [ -n "$1" ] || return 1
    [ "${#1}" -le 64 ] || return 1
    [[ "$1" =~ ^[A-Za-z0-9._-]+$ ]]
}

# A name hagistack gives to something it creates in OpenStack (image, network,
# router, flavor, keypair). Deliberately narrow: these values end up in
# `openstack ... create` arguments, so no whitespace and no shell metacharacter
# is allowed through, even though the client is exec'd without a shell.
valid_resource_name() {
    [ -n "$1" ] || return 1
    [ "${#1}" -le 64 ] || return 1
    [[ "$1" =~ ^[A-Za-z0-9._-]+$ ]]
}

valid_sha256() { [[ "$1" =~ ^[0-9a-f]{64}$ ]]; }

# An absolute path with no traversal and no shell metacharacter. Used for
# IMAGE_FILE, which is read by root.
valid_abs_path() {
    local p="$1"
    case "$p" in /*) ;; *) return 1 ;; esac
    case "$p" in *..*) return 1 ;; esac
    [[ "$p" =~ ^[A-Za-z0-9._/-]+$ ]]
}

# http(s) URL restricted to the characters the config-file parser already
# allows, so a URL that survives the file cannot smuggle anything new in.
valid_http_url() {
    local u="$1"
    [[ "$u" =~ ^https?://[A-Za-z0-9._~:/@+=-]+$ ]] || return 1
    [ "${#u}" -le 512 ]
}

# An address that is supposed to belong to ANOTHER machine. Rejects the values
# that are never a peer: this catches "--controller-ip 127.0.0.1" and
# "--controller-ip 0.0.0.0", which otherwise fail much later with an opaque
# connection error. Caller must still compare it against MGMT_IP.
valid_peer_ipv4() {
    local ip="$1" a
    valid_ipv4 "$ip" || return 1
    a="${ip%%.*}"
    case "$ip" in
        0.*|127.*|255.255.255.255|169.254.*) return 1 ;;
    esac
    [ "$a" -lt 224 ] || return 1      # multicast / reserved
    return 0
}

# ---------------------------------------------------------------------------
# preflight
# ---------------------------------------------------------------------------
detect_os() {
    [ -r /etc/os-release ] || die "cannot read /etc/os-release; unsupported system"
    # shellcheck disable=SC1091
    OS_ID="$(. /etc/os-release; echo "${ID:-}")"
    OS_VERSION_ID="$(. /etc/os-release; echo "${VERSION_ID:-}")"
    OS_PRETTY="$(. /etc/os-release; echo "${PRETTY_NAME:-unknown}")"
}

detect_container() {
    IN_CONTAINER=0; CONTAINER_KIND=""
    if [ -f /.dockerenv ]; then IN_CONTAINER=1; CONTAINER_KIND="docker"; fi
    if [ -f /run/.containerenv ]; then IN_CONTAINER=1; CONTAINER_KIND="podman"; fi
    if have systemd-detect-virt; then
        local v; v="$(systemd-detect-virt --container 2>/dev/null || true)"
        if [ -n "$v" ] && [ "$v" != "none" ]; then IN_CONTAINER=1; CONTAINER_KIND="$v"; fi
    fi
    if [ "$IN_CONTAINER" -eq 0 ] && grep -qaE '(docker|containerd|libpod|lxc)' /proc/1/cgroup 2>/dev/null; then
        IN_CONTAINER=1; CONTAINER_KIND="cgroup-hint"
    fi
}

# systemd may be absent (container) or present but not PID 1.
detect_init() {
    HAS_SYSTEMD=0
    if [ -d /run/systemd/system ] && have systemctl; then HAS_SYSTEMD=1; fi
}

service_start_enable() {
    local unit="$1"
    if [ "$HAS_SYSTEMD" -eq 1 ]; then
        $SUDO systemctl enable --now "$unit" >/dev/null 2>&1 \
            || die "failed to start $unit under systemd"
        log_ok "$unit active (systemd)"
        SERVICE_START_METHOD[$unit]="systemd"
        return 0
    fi
    log_warn "systemd is not running here; cannot start '$unit' as a managed service"
    log_warn "  -> unit ordering/startup stays a GCE acceptance item (B0a/B0b)"
    SERVICE_START_METHOD[$unit]="not-started-no-systemd"
    return 0
}

# Host facts and gates shared by `all-in-one` and `compute-add`. Everything in
# here is true of any hagistack node; the per-role checks live in the two
# preflight phases that call it.
_preflight_host() {
    detect_os; detect_container; detect_init

    log_info "os        : $OS_PRETTY"
    log_info "arch      : $(dpkg --print-architecture 2>/dev/null || uname -m)"
    log_info "init      : $([ "$HAS_SYSTEMD" -eq 1 ] && echo systemd || echo 'no systemd (container-style)')"
    [ "$IN_CONTAINER" -eq 1 ] && log_info "container : yes ($CONTAINER_KIND)"

    # --- OS gate ---
    if [ "$OS_ID" != "ubuntu" ]; then
        die "unsupported OS '$OS_ID'. This shell targets Ubuntu Server 26.04 LTS.
     Rocky Linux 10.2 is NOT implemented here. That is a statement about this
     file, not a claim that Rocky cannot work: see ../rocky10.2/README.md for
     what was measured, what is missing, and what would change the answer."
    fi
    if [ "$OS_VERSION_ID" != "26.04" ]; then
        die "unsupported Ubuntu version '$OS_VERSION_ID'. hagistack targets 26.04 LTS.
     The package names and OpenStack release differ on other versions."
    fi
    log_ok "Ubuntu 26.04 confirmed"

    # --- architecture / qemu package selection ---
    ARCH="$(dpkg --print-architecture 2>/dev/null || echo unknown)"
    local arch="$ARCH"
    case "$arch" in
        amd64) QEMU_PKG="qemu-system-x86" ;;
        arm64) QEMU_PKG="qemu-system-arm"
               log_warn "arm64: guest images must be arm64 too. Not an acceptance target in this step." ;;
        *)     die "unsupported architecture '$arch' (expected amd64 or arm64)" ;;
    esac
    log_ok "architecture $arch -> $QEMU_PKG"

    # --- KVM vs QEMU emulation ---
    if [ -z "$VIRT_TYPE" ]; then
        if [ -e /dev/kvm ] && [ -r /dev/kvm ] && [ -w /dev/kvm ]; then
            VIRT_TYPE="kvm"
        else
            VIRT_TYPE="qemu"
        fi
    fi
    case "$VIRT_TYPE" in
        kvm)  log_ok "/dev/kvm usable -> virt_type=kvm" ;;
        qemu) log_warn "no usable /dev/kvm -> virt_type=qemu (software emulation)."
              log_warn "  guests will be 10-50x slower; suitable only for a boot smoke test." ;;
        *)    die "VIRT_TYPE must be 'kvm' or 'qemu', got '$VIRT_TYPE'" ;;
    esac

    # --- resources ---
    local mem_kb mem_gb free_gb
    mem_kb="$(awk '/^MemTotal:/{print $2}' /proc/meminfo 2>/dev/null || echo 0)"
    mem_gb=$(( mem_kb / 1024 / 1024 ))
    if [ "$mem_gb" -lt 8 ]; then
        log_warn "memory ${mem_gb}GiB is below the 8GiB recommended for all-in-one"
    else
        log_ok "memory ${mem_gb}GiB"
    fi
    free_gb="$(df -BG --output=avail / 2>/dev/null | tail -1 | tr -dc '0-9' || echo 0)"
    if [ -n "$free_gb" ] && [ "$free_gb" -lt 20 ]; then
        log_warn "only ${free_gb}GiB free on /; 40GiB+ recommended once Glance images land"
    else
        log_ok "disk ${free_gb}GiB free on /"
    fi

}

# Start a unit, or RESTART it when the configuration it reads is newer than the
# running process.
#
# Measured on a GCE Ubuntu 26.04 host, and invisible in a container because a
# container has no systemd: every one of these packages starts its unit at
# install time, which is BEFORE hagistack writes any configuration —
#   memcached, glance-api, neutron-rpc-server, neutron-periodic-workers,
#   neutron-ovn-metadata-agent, nova-conductor, nova-scheduler, nova-compute.
# `systemctl enable --now` is a no-op on an already-active unit, so the daemon
# keeps running on the stock configuration (sqlite, 127.0.0.1) while the file on
# disk says otherwise, and `systemctl is-active` cheerfully reports success.
#
# Comparing the unit's start time with the mtime of the files it reads is what
# makes this self-correcting: ini_set only rewrites a file when its content
# actually changes, so an unchanged re-run restarts nothing.
_unit_started_epoch() {
    local t; t="$($SUDO systemctl show -p ExecMainStartTimestamp --value "$1" 2>/dev/null || true)"
    [ -n "$t" ] || return 1
    date -d "$t" +%s 2>/dev/null || return 1
}

_newest_mtime() {
    local f newest=0 m
    for f in "$@"; do
        $SUDO test -f "$f" || continue
        m="$($SUDO stat -c %Y "$f" 2>/dev/null || echo 0)"
        [ "$m" -gt "$newest" ] && newest="$m"
    done
    printf '%s\n' "$newest"
}

# Wait, bounded, for something to become true.
#
# `systemctl restart` returns as soon as the unit is active, which is seconds
# before the socket is listening. Probing immediately after a restart is a race,
# and on GCE it lost: memcached, glance-api and the Apache vhosts were each
# reported as "active but not answering" while they were simply still starting.
# Nothing here waits forever — that is the point of the bound.
wait_for() {   # wait_for <seconds> <what> <command...>
    local limit="$1" what="$2"; shift 2
    local waited=0
    while : ; do
        if "$@"; then
            [ "$waited" -gt 0 ] && log_info "$what became ready after ${waited}s"
            return 0
        fi
        [ "$waited" -lt "$limit" ] || return 1
        sleep 2; waited=$((waited + 2))
    done
}

# Ubuntu 26.04 ships /usr/lib/systemd/system/apache2.service with
#     ProtectProc=invisible
#     ProcSubset=pid
# ProcSubset=pid hides every non-pid file in /proc from the Apache workers,
# /proc/meminfo among them. Neutron's ML2/OVN driver runs inside those workers
# and calls neutron/service.py:_get_worker_count(), which does
# psutil.virtual_memory() -> open('/proc/meminfo'). That call sits inside
# OvnIdlDistributedLock.notify(), so the FileNotFoundError escapes the notify
# handler and EVERY northbound OVN row event is dropped:
#
#   ERROR ... ovsdb_monitor  File ".../ovsdb_monitor.py", line 884, in notify
#   FileNotFoundError: [Errno 2] No such file or directory: '/proc/meminfo'
#
# The consequence is silent and looks like something else entirely. OVN binds
# the port and sets Logical_Switch_Port.up=true, but Neutron never runs
# set_port_status_up(), so the "L2" provisioning block is never released, the
# port stays DOWN, and the nova notifier logs
#   Ignoring state change previous_port_status: DOWN current_port_status: DOWN
# and sends only network-changed — never network-vif-plugged. nova-compute
# waits out vif_plugging_timeout and every guest dies with
#   nova.exception.VirtualInterfaceCreateException: Virtual Interface creation failed
#
# Measured on GCE on 2026-09-28: with ProcSubset=pid the guest reached ERROR
# after 300 s; with ProcSubset=all it reached ACTIVE in 18 s and cloud-init
# completed. ProtectProc=invisible is left alone — it hides other processes'
# directories, which is not what breaks this, so the hardening that still
# applies is kept.
APACHE_DROPIN="/etc/systemd/system/apache2.service.d/10-hagistack-procsubset.conf"

apache_allow_proc_subset() {
    local want='[Service]
# See hagistack: Neutron ML2/OVN reads /proc/meminfo inside the Apache workers.
# ProcSubset=pid (Ubuntu 26.04 default) hides it and every OVN event is dropped.
ProcSubset=all'
    local cur=""
    [ -f "$APACHE_DROPIN" ] && cur="$($SUDO cat "$APACHE_DROPIN" 2>/dev/null)"
    if [ "$cur" = "$want" ]; then
        log_ok "apache2 ProcSubset override already in place (unchanged)"
        return 1
    fi
    $SUDO install -d -m 0755 "$(dirname "$APACHE_DROPIN")"
    printf '%s\n' "$want" | $SUDO tee "$APACHE_DROPIN" >/dev/null
    $SUDO chmod 0644 "$APACHE_DROPIN"
    [ "$HAS_SYSTEMD" -eq 1 ] && $SUDO systemctl daemon-reload
    log_ok "apache2 ProcSubset=all written ($APACHE_DROPIN)"
    log_info "  without it Neutron's OVN driver drops every port-up event and no guest can boot"
    return 0
}

# Report whether the running Apache can actually see /proc/meminfo. This is the
# thing that matters, so it is measured rather than assumed.
apache_sees_meminfo() {
    local pid
    pid="$($SUDO pgrep -f 'wsgi:neutron' 2>/dev/null | head -1)"
    [ -n "$pid" ] || return 2   # no neutron worker yet; nothing to say
    $SUDO nsenter -t "$pid" -m -- test -r /proc/meminfo 2>/dev/null
}

service_apply() {   # service_apply <unit> <config-file>...
    local unit="$1"; shift
    if [ "$HAS_SYSTEMD" -ne 1 ]; then
        service_start_enable "$unit"
        return 0
    fi
    $SUDO systemctl enable "$unit" >/dev/null 2>&1 || true
    if ! service_active "$unit"; then
        service_start_enable "$unit"
        return 0
    fi
    local started conf
    started="$(_unit_started_epoch "$unit" || echo 0)"
    conf="$(_newest_mtime "$@")"
    if [ "${conf:-0}" -gt "${started:-0}" ]; then
        $SUDO systemctl restart "$unit" \
            || die "$unit failed to restart after its configuration changed"
        log_ok "$unit restarted (its configuration is newer than the running process)"
        SERVICE_START_METHOD[$unit]="systemd (restarted)"
    else
        log_ok "$unit already running with the current configuration"
        SERVICE_START_METHOD[$unit]="systemd"
    fi
    return 0
}

phase_preflight() {
    log_step "preflight"
    _preflight_host

    # --- required settings ---
    local missing=()
    [ -n "$EXT_NIC" ]          || missing+=("EXT_NIC")
    [ -n "$PROVIDER_CIDR" ]    || missing+=("PROVIDER_CIDR")
    [ -n "$PROVIDER_GATEWAY" ] || missing+=("PROVIDER_GATEWAY")
    [ -n "$FLOATING_START" ]   || missing+=("FLOATING_START")
    [ -n "$FLOATING_END" ]     || missing+=("FLOATING_END")
    if [ "${#missing[@]}" -gt 0 ]; then
        die "missing required settings: ${missing[*]}
     Set them on the command line, in the environment, or in ./hagistack.env
     (see hagistack.env.example). Run '${SELF##*/} --help' for the flags."
    fi

    valid_nic_name "$EXT_NIC" \
        || die "EXT_NIC '$EXT_NIC' is not a valid interface name
     (allowed: letters, digits, '_', '.', '-'; at most 15 characters)"
    if ! nic_exists "$EXT_NIC"; then
        local available
        available="$(ls /sys/class/net 2>/dev/null | tr '\n' ' ')"
        die "EXT_NIC '$EXT_NIC' does not exist on this host.
     interfaces present: ${available:-none}"
    fi
    log_ok "EXT_NIC $EXT_NIC exists"

    valid_cidr "$PROVIDER_CIDR" \
        || die "PROVIDER_CIDR '$PROVIDER_CIDR' is not a valid IPv4 CIDR (e.g. 172.24.4.0/24; prefix 8-30)"
    valid_ipv4 "$PROVIDER_GATEWAY" \
        || die "PROVIDER_GATEWAY '$PROVIDER_GATEWAY' is not a valid IPv4 address"
    valid_ipv4 "$FLOATING_START" \
        || die "FLOATING_START '$FLOATING_START' is not a valid IPv4 address"
    valid_ipv4 "$FLOATING_END" \
        || die "FLOATING_END '$FLOATING_END' is not a valid IPv4 address"

    ip_in_cidr "$PROVIDER_GATEWAY" "$PROVIDER_CIDR" \
        || die "PROVIDER_GATEWAY $PROVIDER_GATEWAY is outside PROVIDER_CIDR $PROVIDER_CIDR"
    ip_in_cidr "$FLOATING_START" "$PROVIDER_CIDR" \
        || die "FLOATING_START $FLOATING_START is outside PROVIDER_CIDR $PROVIDER_CIDR"
    ip_in_cidr "$FLOATING_END" "$PROVIDER_CIDR" \
        || die "FLOATING_END $FLOATING_END is outside PROVIDER_CIDR $PROVIDER_CIDR"
    [ "$(ip_to_int "$FLOATING_START")" -le "$(ip_to_int "$FLOATING_END")" ] \
        || die "FLOATING_START $FLOATING_START is above FLOATING_END $FLOATING_END"
    if ip_in_cidr "$PROVIDER_GATEWAY" "$PROVIDER_CIDR" \
       && [ "$(ip_to_int "$PROVIDER_GATEWAY")" -ge "$(ip_to_int "$FLOATING_START")" ] \
       && [ "$(ip_to_int "$PROVIDER_GATEWAY")" -le "$(ip_to_int "$FLOATING_END")" ]; then
        die "PROVIDER_GATEWAY $PROVIDER_GATEWAY falls inside the floating IP pool
     $FLOATING_START-$FLOATING_END; the gateway must be outside the pool"
    fi
    log_ok "provider network $PROVIDER_CIDR gw=$PROVIDER_GATEWAY pool=$FLOATING_START-$FLOATING_END"

    TENANT_CIDR="${TENANT_CIDR:-10.10.10.0/24}"
    valid_cidr "$TENANT_CIDR" || die "TENANT_CIDR '$TENANT_CIDR' is not a valid IPv4 CIDR"
    DNS_SERVER="${DNS_SERVER:-$PROVIDER_GATEWAY}"
    valid_ipv4 "$DNS_SERVER" || die "DNS_SERVER '$DNS_SERVER' is not a valid IPv4 address"
    REGION_NAME="${REGION_NAME:-RegionOne}"
    valid_region_name "$REGION_NAME" \
        || die "REGION_NAME '$REGION_NAME' is not valid
     (allowed: letters, digits, '.', '_', '-'; at most 64 characters)"
    PROVIDER_PHYSNET="${PROVIDER_PHYSNET:-physnet1}"
    valid_region_name "$PROVIDER_PHYSNET" \
        || die "PROVIDER_PHYSNET '$PROVIDER_PHYSNET' is not a valid label
     (allowed: letters, digits, '.', '_', '-')"
    PROVIDER_BRIDGE="${PROVIDER_BRIDGE:-br-ex}"
    valid_nic_name "$PROVIDER_BRIDGE" \
        || die "PROVIDER_BRIDGE '$PROVIDER_BRIDGE' is not a valid bridge name"

    # --- management IP ---
    if [ -z "$MGMT_IP" ]; then
        have ip || die "cannot autodetect MGMT_IP: iproute2 is not installed.
     Install iproute2 or pass --mgmt-ip explicitly."
        MGMT_IP="$(ip -4 -o route get 1.1.1.1 2>/dev/null | awk '{for(i=1;i<=NF;i++) if($i=="src") print $(i+1)}' | head -1 || true)"
    fi
    [ -n "$MGMT_IP" ] || die "could not determine MGMT_IP automatically; pass --mgmt-ip explicitly"
    valid_ipv4 "$MGMT_IP" || die "MGMT_IP '$MGMT_IP' is not a valid IPv4 address"
    log_ok "MGMT_IP $MGMT_IP"

    # --- single-NIC warning ---
    local mgmt_nic=""
    if have ip; then
        mgmt_nic="$(ip -4 -o addr show 2>/dev/null | awk -v ip="$MGMT_IP" '$4 ~ "^"ip"/" {print $2}' | head -1 || true)"
    else
        log_warn "iproute2 not available; skipping the single-NIC layout check"
    fi
    if [ -n "$mgmt_nic" ] && [ "$mgmt_nic" = "$EXT_NIC" ]; then
        log_warn "single-NIC layout: EXT_NIC ($EXT_NIC) also carries the management IP."
        log_warn "  Putting $EXT_NIC onto $PROVIDER_BRIDGE would move $MGMT_IP with it and can drop your SSH session."
        log_warn "  hagistack never does that. Provider networks therefore reach no physical LAN"
        log_warn "  until an operator attaches a NIC by hand. Use a console or a second NIC."
    fi

    # --- initial guest image -------------------------------------------------
    # There is no cirros package in the Ubuntu archive (checked: `cirros` and
    # `cirros-testvm` have no candidate), so the initial image has to come from
    # a URL or a local file. The default URL and digest below were measured on
    # 2026-09-27 by downloading the file and comparing it against the publisher's
    # own SHA256SUMS; both matched. A URL is never fetched without a digest.
    case "$ARCH" in
        amd64) IMAGE_NAME="${IMAGE_NAME:-cirros-0.6.3-x86_64}"
               IMAGE_URL="${IMAGE_URL:-https://download.cirros-cloud.net/0.6.3/cirros-0.6.3-x86_64-disk.img}"
               IMAGE_SHA256="${IMAGE_SHA256:-7d6355852aeb6dbcd191bcda7cd74f1536cfe5cbf8a10495a7283a8396e4b75b}" ;;
        arm64) IMAGE_NAME="${IMAGE_NAME:-cirros-0.6.3-aarch64}"
               IMAGE_URL="${IMAGE_URL:-https://download.cirros-cloud.net/0.6.3/cirros-0.6.3-aarch64-disk.img}"
               IMAGE_SHA256="${IMAGE_SHA256:-611879b8299363fe60ff0f84982e4da08e63f476e8481170223db982959783cb}" ;;
    esac
    valid_resource_name "$IMAGE_NAME" \
        || die "IMAGE_NAME '$IMAGE_NAME' is not a valid name
     (allowed: letters, digits, '.', '_', '-'; at most 64 characters)"
    if [ -n "$IMAGE_FILE" ]; then
        valid_abs_path "$IMAGE_FILE" \
            || die "IMAGE_FILE must be an absolute path without '..' and without
     shell metacharacters; got '$IMAGE_FILE'"
        [ -f "$IMAGE_FILE" ] || die "IMAGE_FILE '$IMAGE_FILE' does not exist or is not a regular file"
        log_ok "initial image from a local file: $IMAGE_FILE"
    else
        valid_http_url "$IMAGE_URL" \
            || die "IMAGE_URL is not an acceptable http/https URL.
     Permitted characters: letters, digits and . _ ~ - : / @ + =
     (a query string is deliberately refused; mirror the file instead)"
        case "$IMAGE_URL" in
            http://*) log_warn "IMAGE_URL uses plain http. The digest below is what makes this safe,"
                      log_warn "  not the transport: a modified download is refused, not installed." ;;
        esac
        valid_sha256 "$IMAGE_SHA256" \
            || die "IMAGE_SHA256 must be 64 lowercase hex characters.
     hagistack will not download an image it cannot verify. Get the publisher's
     digest (for cirros: the SHA256SUMS file next to the image) and pass it with
     --image-sha256, or supply the image yourself with --image-file."
        log_ok "initial image $IMAGE_NAME from $IMAGE_URL (digest pinned)"
    fi

    log_ok "preflight passed"
}

# ---------------------------------------------------------------------------
# secrets
#
# Generated once, stored 0600 outside the repo, and reused verbatim on every
# later run so that re-running never rotates a live credential.
# ---------------------------------------------------------------------------
# One credential per DB *user*. The `nova` user owns both the `nova` and the
# `nova_api` databases, so it has one password: generating a second one only
# produced an unused key, because `CREATE USER IF NOT EXISTS` for the second
# database is a no-op and the user keeps the first password.
SECRET_KEYS="MYSQL_ROOT_PASS RABBIT_PASS KEYSTONE_DB_PASS GLANCE_DB_PASS
             PLACEMENT_DB_PASS NOVA_DB_PASS NEUTRON_DB_PASS
             ADMIN_PASSWORD SERVICE_PASSWORD METADATA_PROXY_SECRET
             GLANCE_SERVICE_PASS PLACEMENT_SERVICE_PASS NEUTRON_SERVICE_PASS
             NOVA_SERVICE_PASS"

# Keys written by an earlier version that are no longer used. They are reported
# and then left alone: rewriting a live secrets file to drop a key is a bigger
# risk than carrying a stale line, and removing it could not rotate anything.
OBSOLETE_SECRET_KEYS="NOVA_API_DB_PASS"

phase_secrets() {
    log_step "secrets"
    $SUDO mkdir -p "$HAGISTACK_ETC"
    $SUDO chmod 0750 "$HAGISTACK_ETC"

    local created=0
    if [ ! -f "$SECRETS_FILE" ]; then
        log_info "generating $SECRETS_FILE"
        local tmp; tmp="$(mktemp)"
        chmod 0600 "$tmp"
        {
            echo "# hagistack secrets — generated $(date -u +%Y-%m-%dT%H:%M:%SZ)"
            echo "# Never commit this file. Never copy it into the repository."
            local k
            for k in $SECRET_KEYS; do
                printf '%s=%s\n' "$k" "$(gen_secret 32)"
            done
        } > "$tmp"
        $SUDO cp "$tmp" "$SECRETS_FILE"
        rm -f "$tmp"
        created=1
    fi
    $SUDO chmod 0600 "$SECRETS_FILE"
    $SUDO chown "$(id -u)":"$(id -g)" "$SECRETS_FILE" 2>/dev/null || true

    # Fill in any key added by a later version, without touching existing ones.
    local k added=0
    for k in $SECRET_KEYS; do
        if ! $SUDO grep -q "^${k}=" "$SECRETS_FILE"; then
            printf '%s=%s\n' "$k" "$(gen_secret 32)" | $SUDO tee -a "$SECRETS_FILE" >/dev/null
            added=$((added+1))
        fi
    done

    # shellcheck disable=SC1090
    . <($SUDO cat "$SECRETS_FILE")

    local ok
    for ok in ${OBSOLETE_SECRET_KEYS:-}; do
        if $SUDO grep -q "^${ok}=" "$SECRETS_FILE"; then
            log_warn "$SECRETS_FILE still contains '$ok', which this version no longer uses."
            log_warn "  It is left in place and ignored. The 'nova' user has a single"
            log_warn "  credential (NOVA_DB_PASS) covering both the nova and nova_api databases."
        fi
    done

    local perm; perm="$($SUDO stat -c '%a' "$SECRETS_FILE")"
    [ "$perm" = "600" ] || die "$SECRETS_FILE has mode $perm; expected 600"

    if [ "$created" -eq 1 ]; then
        log_ok "secrets created (mode $perm)"
    elif [ "$added" -gt 0 ]; then
        log_ok "secrets reused, $added new key(s) added (mode $perm)"
    else
        log_ok "secrets reused unchanged (mode $perm)"
    fi
    log_info "values are never printed and never written into the repository"
}

# ---------------------------------------------------------------------------
# base packages
# ---------------------------------------------------------------------------
phase_base_packages() {
    log_step "base packages"
    if phase_done base_packages && [ "${HAGISTACK_REDO:-0}" != "1" ]; then
        log_skip "already done (state marker); re-run with HAGISTACK_REDO=1 to force"
        return 0
    fi
    local pkgs="ca-certificates curl gnupg openssl chrony mariadb-server rabbitmq-server memcached python3-pymysql"
    log_info "apt-get update"
    $SUDO env DEBIAN_FRONTEND=noninteractive apt-get update -qq
    log_info "installing: $pkgs"
    # shellcheck disable=SC2086
    $SUDO env DEBIAN_FRONTEND=noninteractive apt-get install -y -qq $pkgs
    log_ok "base packages installed"
    phase_mark_done base_packages
}

# ---------------------------------------------------------------------------
# MariaDB
#
# The old shells issued an unconditional database drop on every run, which
# wiped a live cloud. Nothing here drops anything; a pre-existing database is
# detected and reused, and there is no flag to bypass that.
# ---------------------------------------------------------------------------
declare -A SERVICE_START_METHOD

# Phases that could not be carried out. A run with any of these is NOT a
# completed run, however far the rest of it got.
SKIPPED_PHASES=""
note_skip() {
    SKIPPED_PHASES="${SKIPPED_PHASES}${SKIPPED_PHASES:+ }$1"
    log_warn "phase '$1' SKIPPED: $2"
    log_warn "  -> this run will NOT be reported as complete"
}

# True only when we can positively observe the unit running.
service_active() {
    [ "$HAS_SYSTEMD" -eq 1 ] || return 1
    $SUDO systemctl is-active --quiet "$1"
}

# Raised from the stock 151: several OpenStack services with SQLAlchemy pools
# share this one server. Overridable for a constrained host.
MYSQL_MAX_CONNECTIONS="${HAGISTACK_MYSQL_MAX_CONNECTIONS:-1024}"

# Each service's SQLAlchemy pool, per WSGI process. The oslo.db defaults are
# max_pool_size=5 with max_overflow=50, and Keystone exhausted exactly that on a
# GCE host after about forty minutes of ordinary use:
#
#   sqlalchemy.exc.TimeoutError: QueuePool limit of size 5 overflow 50 reached,
#   connection timed out, timeout 30.00
#
# after which POST /v3/auth/tokens answered 500 and every other service's API
# answered 500 or 503 behind it, because they all validate tokens against
# Keystone. Restarting apache2 cleared it until the next time.
#
# The step 4 write-up guessed this was disk pressure. It was not: when this was
# reproduced the host had 53 GB free, MariaDB was at 338 of 1024 connections and
# Aborted_connects was 0. The SERVER had plenty of room; the per-process POOL
# did not. So the pool is sized explicitly rather than left at a default that is
# smaller than the number of workers in front of it.
DB_MAX_POOL_SIZE="${HAGISTACK_DB_MAX_POOL_SIZE:-25}"
DB_MAX_OVERFLOW="${HAGISTACK_DB_MAX_OVERFLOW:-50}"

# Apply the pool settings to a service configuration file.
write_db_pool() {   # write_db_pool <conf> [section]
    local conf="$1" sec="${2:-database}"
    ini_set "$conf" "$sec" max_pool_size "$DB_MAX_POOL_SIZE"    >/dev/null || true
    ini_set "$conf" "$sec" max_overflow  "$DB_MAX_OVERFLOW"     >/dev/null || true
    ini_set "$conf" "$sec" pool_timeout  30                     >/dev/null || true
    return 0
}

mysql_root() { $SUDO mariadb -uroot "$@"; }

# Reachability probes are bounded. `rabbitmqctl status` in particular can sit
# for many minutes on a node that is starting up or wedged, and an unbounded
# probe turns "service not ready" into "the installer hangs forever".
PROBE_TIMEOUT="${HAGISTACK_PROBE_TIMEOUT:-20}"
_probe() {
    # -k: escalate to SIGKILL. `rabbitmqctl` does not die on SIGTERM, so a
    # plain `timeout` waits forever on it — measured in a container where the
    # node never became ready.
    if have timeout; then $SUDO timeout -k 5 "$PROBE_TIMEOUT" "$@"
    else                  $SUDO "$@"
    fi
}
mariadb_reachable()  { _probe mariadb -uroot -e "SELECT 1" >/dev/null 2>&1; }
rabbitmq_reachable() { _probe rabbitmqctl status >/dev/null 2>&1; }
# A token cache that is not listening is worse than no token cache: every
# validation blocks on it. Plain TCP connect — no data exchange, so no race.
memcached_reachable() {
    _probe timeout 5 bash -c "exec 3<>/dev/tcp/${MGMT_IP}/11211" >/dev/null 2>&1
}

phase_database() {
    log_step "database (MariaDB)"

    local dbconf=/etc/mysql/mariadb.conf.d/99-hagistack.cnf
    local db_cfg_changed=0
    ini_set "$dbconf" mysqld bind-address "127.0.0.1" >/dev/null \
        && { db_cfg_changed=1; log_ok "bind-address pinned to 127.0.0.1"; } \
        || log_ok "bind-address already 127.0.0.1 (unchanged)"
    # An all-in-one runs Keystone, Glance, Placement (and later Nova/Neutron)
    # against one server, each with its own connection pool. The stock 151 is
    # not enough and shows up as HTTP 500 / "Too many connections".
    ini_set "$dbconf" mysqld max_connections "$MYSQL_MAX_CONNECTIONS" >/dev/null \
        && { db_cfg_changed=1; log_ok "max_connections set to $MYSQL_MAX_CONNECTIONS"; } \
        || log_ok "max_connections already $MYSQL_MAX_CONNECTIONS (unchanged)"

    service_start_enable mariadb
    if [ "$db_cfg_changed" = "1" ] && [ "$HAS_SYSTEMD" -eq 1 ] && service_active mariadb; then
        log_info "restarting mariadb so the new server settings take effect"
        $SUDO systemctl restart mariadb || die "mariadb failed to restart after a configuration change"
        log_ok "mariadb restarted"
    elif [ "$db_cfg_changed" = "1" ]; then
        log_warn "server settings changed but MariaDB was not restarted here"
        log_warn "  (no systemd). They take effect on the next restart."
    fi
    if ! mariadb_reachable; then
        note_skip database "MariaDB is not reachable (start method: ${SERVICE_START_METHOD[mariadb]}).
     Database and grant setup was NOT performed. Covered by the GCE acceptance (B0b)."
        return 0
    fi
    log_ok "MariaDB reachable (started via ${SERVICE_START_METHOD[mariadb]})"

    local db user
    # nova_cell0 holds instances that never reached a cell; nova derives its
    # name by appending _cell0 to the [database] connection, so it must be
    # exactly this and owned by the same nova credential.
    for db in keystone glance placement nova nova_api nova_cell0 neutron; do
        user="${db%%_*}"
        local passvar
        case "$db" in
            keystone) passvar="KEYSTONE_DB_PASS" ;;
            glance)   passvar="GLANCE_DB_PASS" ;;
            placement)passvar="PLACEMENT_DB_PASS" ;;
            nova)     passvar="NOVA_DB_PASS" ;;
            nova_api) passvar="NOVA_DB_PASS"; user="nova" ;;
            nova_cell0) passvar="NOVA_DB_PASS"; user="nova" ;;
            neutron)  passvar="NEUTRON_DB_PASS" ;;
        esac
        local pass="${!passvar}"

        if mysql_root -e "USE \`$db\`" >/dev/null 2>&1; then
            log_ok "database '$db' already exists — left untouched"
        else
            mysql_root -e "CREATE DATABASE \`$db\` CHARACTER SET utf8mb4;"
            log_ok "database '$db' created"
        fi
        # CREATE USER IF NOT EXISTS keeps an existing password intact.
        mysql_root -e "CREATE USER IF NOT EXISTS '$user'@'localhost' IDENTIFIED BY '$pass';"
        mysql_root -e "CREATE USER IF NOT EXISTS '$user'@'%' IDENTIFIED BY '$pass';"
        mysql_root -e "GRANT ALL PRIVILEGES ON \`$db\`.* TO '$user'@'localhost';"
        mysql_root -e "GRANT ALL PRIVILEGES ON \`$db\`.* TO '$user'@'%';"
    done
    mysql_root -e "FLUSH PRIVILEGES;"
    log_ok "databases and grants in place (no DROP was issued)"
    phase_mark_done database
}

# ---------------------------------------------------------------------------
# RabbitMQ
# ---------------------------------------------------------------------------
phase_rabbitmq() {
    log_step "message queue (RabbitMQ)"
    service_start_enable rabbitmq-server
    if ! rabbitmq_reachable; then
        note_skip rabbitmq "RabbitMQ is not reachable (start method: ${SERVICE_START_METHOD[rabbitmq-server]}).
     Queue user and permissions were NOT configured. Covered by the GCE acceptance (B0b)."
        return 0
    fi
    log_ok "RabbitMQ reachable (started via ${SERVICE_START_METHOD[rabbitmq-server]})"

    if $SUDO rabbitmqctl list_users 2>/dev/null | awk '{print $1}' | grep -qx openstack; then
        log_ok "rabbitmq user 'openstack' already exists — password left unchanged"
    else
        $SUDO rabbitmqctl add_user openstack "$RABBIT_PASS" >/dev/null
        log_ok "rabbitmq user 'openstack' created"
    fi
    $SUDO rabbitmqctl set_permissions openstack ".*" ".*" ".*" >/dev/null
    log_ok "rabbitmq permissions set"
    phase_mark_done rabbitmq
}

# ---------------------------------------------------------------------------
# memcached
# ---------------------------------------------------------------------------
MEMCACHED_CONF="/etc/memcached.conf"

phase_memcached() {
    log_step "cache (memcached)"
    # Listen on the management IP for Keystone/Horizon, never on 0.0.0.0.
    #
    # /etc/memcached.conf is NOT a dpkg conffile on Ubuntu 26.04: `dpkg -S` finds
    # no owner. The package ships /usr/share/memcached/memcached.conf.default and
    # its postinst copies it into place, and the default carries TWO -l lines
    # (127.0.0.1 and ::1). A blanket `sed -E s/^-l .*/-l $MGMT_IP/` therefore
    # rewrote BOTH and left the same address listed twice — measured on GCE.
    # Every -l line is replaced by exactly one, in the first one's place.
    if $SUDO test -f "$MEMCACHED_CONF"; then
        local tmp; tmp="$(mktemp)"
        $SUDO cat "$MEMCACHED_CONF" | awk -v ip="$MGMT_IP" '
            /^[[:space:]]*-l[[:space:]]/ { if (!seen) { print "-l " ip; seen=1 } ; next }
            { print }
            END { if (!seen) print "-l " ip }' > "$tmp"
        if $SUDO cmp -s "$tmp" "$MEMCACHED_CONF"; then
            log_ok "memcached already bound to $MGMT_IP (unchanged)"
        else
            $SUDO cp "$tmp" "$MEMCACHED_CONF"
            log_ok "memcached bound to $MGMT_IP (exactly one -l line; the package ships two)"
        fi
        rm -f "$tmp"
    else
        log_warn "$MEMCACHED_CONF does not exist; memcached keeps its built-in defaults"
    fi
    service_apply memcached "$MEMCACHED_CONF"
    if ! service_active memcached; then
        note_skip memcached "service is not running (start method: ${SERVICE_START_METHOD[memcached]})."
        return 0
    fi
    # `is-active` is not the question. The question is whether the cache is
    # listening where it was configured to listen, which is what every other
    # phase depends on.
    if ! wait_for 60 "memcached" memcached_reachable; then
        note_skip memcached "memcached is active but is not answering on ${MGMT_IP}:11211.
     An active unit is not a listening cache: the package starts memcached at
     install time, before this configuration exists, so a stale process can be
     serving 127.0.0.1 while the file on disk says otherwise.
     Check:  ss -lntp | grep 11211
             systemctl restart memcached"
        return 0
    fi
    log_ok "memcached answering on ${MGMT_IP}:11211"
    phase_mark_done memcached
}

# ---------------------------------------------------------------------------
# Keystone (identity)
#
# Packaging facts verified against Ubuntu 26.04 (keystone 2:29.0.0-0ubuntu1.2),
# not assumed — see STEP2_KEYSTONE_EVIDENCE.md:
#
#   * The `keystone` binary package ships exactly one file:
#     /etc/apache2/sites-available/keystone.conf. There is NO keystone
#     systemd unit of any kind, and no uwsgi anywhere. Keystone is served by
#     **apache2.service** through libapache2-mod-wsgi-py3.
#   * That vhost carries its own `Listen 5000` and `<VirtualHost *:5000>`,
#     pointing at /usr/bin/keystone-wsgi-public. Installing the package also
#     enables the site, so /etc/apache2/sites-enabled/keystone.conf already
#     exists. There is no separate admin port (the old 35357 is long gone).
#   * /etc/keystone/keystone.conf comes from the `keystone-common` package,
#     mode 0640 keystone:keystone, and ships
#     `connection = sqlite:////var/lib/keystone/keystone.db` — which must be
#     replaced. `[token] provider` and `[credential] provider` already default
#     to fernet, so we set them explicitly only to pin the behaviour.
#   * Default key repositories are /etc/keystone/fernet-keys/ (created by the
#     package, 0700 keystone:keystone) and /etc/keystone/credential-keys/
#     (NOT created by the package).
#   * `keystone-manage bootstrap` accepts OS_BOOTSTRAP_* environment
#     variables, so the admin password never has to appear in argv.
# ---------------------------------------------------------------------------
KEYSTONE_CONF="/etc/keystone/keystone.conf"
KEYSTONE_FERNET_DIR="/etc/keystone/fernet-keys"
KEYSTONE_CRED_DIR="/etc/keystone/credential-keys"
ADMIN_OPENRC="$HAGISTACK_ETC/admin-openrc"

# Run a command as the keystone system user so that logs and key files do not
# end up owned by root.
as_keystone() {
    if have runuser; then $SUDO runuser -u keystone -- "$@"
    else                  $SUDO su -s /bin/sh -c "$(printf '%q ' "$@")" keystone
    fi
}

keystone_pkgs_installed() {
    dpkg-query -W -f='${Status}' keystone 2>/dev/null | grep -q "install ok installed" \
    && dpkg-query -W -f='${Status}' python3-openstackclient 2>/dev/null | grep -q "install ok installed"
}

# The identity endpoint answers. Bounded, like every other probe.
keystone_serving() {
    _probe curl -s -o /dev/null -m 10 "http://${MGMT_IP}:5000/v3" 2>/dev/null
}

phase_keystone() {
    log_step "identity (Keystone)"

    # --- packages -------------------------------------------------------
    if keystone_pkgs_installed; then
        log_ok "keystone and python3-openstackclient already installed"
    else
        log_info "installing keystone (pulls apache2 + libapache2-mod-wsgi-py3) and python3-openstackclient"
        $SUDO env DEBIAN_FRONTEND=noninteractive apt-get install -y -qq \
            keystone python3-openstackclient
        log_ok "packages installed"
    fi
    log_info "keystone $(dpkg-query -W -f='${Version}' keystone 2>/dev/null || echo '?') \
served by apache2 + mod_wsgi (no keystone systemd unit exists on Ubuntu)"

    # --- the database must be there before anything else ----------------
    if ! mariadb_reachable; then
        note_skip keystone "MariaDB is not reachable, so the identity schema cannot be created.
     Nothing was changed. Covered by the GCE acceptance (B0b)."
        return 0
    fi
    if ! mysql_root -e "USE keystone" >/dev/null 2>&1; then
        note_skip keystone "the 'keystone' database does not exist; the database phase did not complete."
        return 0
    fi

    # --- keystone.conf ---------------------------------------------------
    # The value carries the DB password, so it is never echoed. ini_set is a
    # shell function, so it forks no process whose argv could expose it.
    # 127.0.0.1, not MGMT_IP: the database phase pins MariaDB to
    # `bind-address = 127.0.0.1`, so anything aimed at the management address is
    # refused. all-in-one keeps Keystone on the same host as its database, and
    # loopback also keeps the credential off the wire.
    local conn="mysql+pymysql://keystone:${KEYSTONE_DB_PASS}@127.0.0.1/keystone?charset=utf8mb4"
    local changed=0
    ini_set "$KEYSTONE_CONF" database   connection "$conn"       && changed=1
    write_db_pool "$KEYSTONE_CONF"
    ini_set "$KEYSTONE_CONF" token      provider   fernet        && changed=1
    ini_set "$KEYSTONE_CONF" credential provider   fernet        && changed=1
    if [ "$changed" -eq 1 ]; then
        log_ok "keystone.conf updated (database credentials not shown)"
    else
        log_ok "keystone.conf already correct (unchanged)"
    fi
    $SUDO chown keystone:keystone "$KEYSTONE_CONF" 2>/dev/null || true
    $SUDO chmod 0640 "$KEYSTONE_CONF"

    # --- can Keystone actually reach the database the way it is configured? --
    # keystone-manage logs to its own file and writes nothing useful to stderr,
    # so probe first and fail with something actionable. The password goes in a
    # 0600 defaults file: not argv, not the environment.
    local dbf; dbf="$(mktemp)"; chmod 0600 "$dbf"
    printf '[client]\npassword=%s\n' "$KEYSTONE_DB_PASS" > "$dbf"
    if ! _probe mariadb --defaults-extra-file="$dbf" --protocol=TCP \
            -h 127.0.0.1 -ukeystone -e "SELECT 1" >/dev/null 2>&1; then
        rm -f "$dbf"
        # Consistent with every other unreachable-service path: report it and
        # leave the run incomplete (exit 4) rather than aborting. Nothing has
        # been changed beyond keystone.conf, which is idempotent.
        note_skip keystone "the keystone DB user cannot reach MariaDB over TCP at 127.0.0.1:3306.
     Keystone connects with mysql+pymysql, which needs a TCP listener; a server
     started with --skip-networking, or bound elsewhere, will refuse it.
     Check:  ss -ltn | grep 3306
             mariadb --protocol=TCP -h 127.0.0.1 -ukeystone -p -e 'SELECT 1'"
        return 0
    fi
    rm -f "$dbf"
    log_ok "keystone DB user can reach MariaDB over TCP on 127.0.0.1"

    # --- schema ----------------------------------------------------------
    local before after
    before="$(mysql_root -N -B -e \
        "SELECT COUNT(*) FROM information_schema.tables WHERE table_schema='keystone'" 2>/dev/null || echo 0)"
    log_info "running keystone-manage db_sync (idempotent migration)"
    local syncerr; syncerr="$(mktemp)"; chmod 0600 "$syncerr"
    if ! as_keystone keystone-manage db_sync 2>"$syncerr"; then
        log_error "keystone-manage db_sync failed. Diagnostics (credentials redacted):"
        # stderr is usually empty: keystone-manage logs to /var/log/keystone.
        {
            $SUDO cat "$syncerr" 2>/dev/null
            $SUDO tail -20 /var/log/keystone/keystone.log 2>/dev/null
        } | $SUDO sed "s/${KEYSTONE_DB_PASS}/<redacted>/g" \
          | grep -viE 'password|secret' | tail -12 | sed 's/^/     /' >&2
        rm -f "$syncerr"
        die "the identity schema could not be created.
     The usual cause is that [database] connection cannot reach MariaDB.
     The database phase pins MariaDB to 127.0.0.1, so the connection must
     use 127.0.0.1 as well. Check: mariadb -uroot -e 'SELECT 1'"
    fi
    rm -f "$syncerr"
    after="$(mysql_root -N -B -e \
        "SELECT COUNT(*) FROM information_schema.tables WHERE table_schema='keystone'" 2>/dev/null || echo 0)"
    if [ "$before" = "0" ]; then
        log_ok "identity schema created ($after tables)"
    elif [ "$before" = "$after" ]; then
        log_ok "identity schema already current ($after tables, unchanged)"
    else
        log_ok "identity schema migrated ($before -> $after tables)"
    fi

    # --- fernet / credential keys ----------------------------------------
    # Guarded: re-running fernet_setup on a live deployment must never rotate
    # keys, because that invalidates every issued token.
    if $SUDO test -s "$KEYSTONE_FERNET_DIR/0"; then
        log_ok "fernet token keys already present — not touched"
    else
        as_keystone keystone-manage fernet_setup \
            --keystone-user keystone --keystone-group keystone
        log_ok "fernet token keys created in $KEYSTONE_FERNET_DIR"
    fi
    if $SUDO test -s "$KEYSTONE_CRED_DIR/0"; then
        log_ok "credential keys already present — not touched"
    else
        as_keystone keystone-manage credential_setup \
            --keystone-user keystone --keystone-group keystone
        log_ok "credential keys created in $KEYSTONE_CRED_DIR"
    fi

    # --- bootstrap --------------------------------------------------------
    # Writes straight to the database, so it does not need Apache running.
    # The password goes through the environment, never argv.
    local auth_url="http://${MGMT_IP}:5000/v3/"
    log_info "keystone-manage bootstrap (admin user, project, role, endpoints)"
    $SUDO env \
        OS_BOOTSTRAP_PASSWORD="$ADMIN_PASSWORD" \
        OS_BOOTSTRAP_USERNAME=admin \
        OS_BOOTSTRAP_PROJECT_NAME=admin \
        OS_BOOTSTRAP_ROLE_NAME=admin \
        OS_BOOTSTRAP_SERVICE_NAME=keystone \
        OS_BOOTSTRAP_REGION_ID="$REGION_NAME" \
        OS_BOOTSTRAP_PUBLIC_URL="$auth_url" \
        OS_BOOTSTRAP_INTERNAL_URL="$auth_url" \
        OS_BOOTSTRAP_ADMIN_URL="$auth_url" \
        keystone-manage bootstrap
    log_ok "bootstrap applied (idempotent; the stored admin password is reused, never regenerated)"

    # --- admin credentials file ------------------------------------------
    write_admin_openrc

    # --- serve it ----------------------------------------------------------
    configure_apache_servername
    $SUDO a2ensite keystone >/dev/null 2>&1 || true

    if [ "$HAS_SYSTEMD" -eq 1 ]; then
        if service_active apache2; then
            $SUDO systemctl reload-or-restart apache2 \
                || die "apache2 failed to reload after the keystone configuration change"
            log_ok "apache2 reloaded"
        else
            service_start_enable apache2
        fi
    else
        service_start_enable apache2
    fi

    if ! service_active apache2; then
        note_skip keystone "apache2 is not running, so the identity endpoint is not being served.
     The schema, fernet keys, credential keys and bootstrap ARE in place, but an
     administrator cannot authenticate yet. Startup under systemd is a GCE
     acceptance item (B0a/B0b)."
        return 0
    fi

    if ! wait_for 60 "the identity endpoint" keystone_serving; then
        note_skip keystone "apache2 is active but http://${MGMT_IP}:5000/v3 did not answer."
        return 0
    fi
    log_ok "identity endpoint answering on http://${MGMT_IP}:5000/v3"

    # --- prove an administrator can actually authenticate -------------------
    if openstack_admin token issue >/dev/null 2>&1; then
        log_ok "admin authentication verified (token issued; value not shown)"
    else
        note_skip keystone "the identity endpoint answers but 'openstack token issue' failed as admin."
        return 0
    fi

    phase_mark_done keystone
}

# ServerName keeps apache from complaining that it cannot determine the FQDN.
configure_apache_servername() {
    local f=/etc/apache2/conf-available/hagistack-servername.conf
    local want="ServerName ${MGMT_IP}"
    if $SUDO test -f "$f" && [ "$($SUDO cat "$f")" = "$want" ]; then
        log_ok "apache ServerName already set (unchanged)"
    else
        printf '%s\n' "$want" | $SUDO tee "$f" >/dev/null
        log_ok "apache ServerName set to $MGMT_IP"
    fi
    $SUDO a2enconf hagistack-servername >/dev/null 2>&1 || true
}

# The admin credentials live outside the repository, 0600, and are rewritten
# only when their content would actually change.
write_admin_openrc() {
    local tmp; tmp="$(mktemp)"; chmod 0600 "$tmp"
    cat > "$tmp" <<RCEOF
# hagistack admin credentials — generated, do not commit.
export OS_AUTH_URL=http://${MGMT_IP}:5000/v3
export OS_IDENTITY_API_VERSION=3
export OS_PROJECT_DOMAIN_NAME=Default
export OS_USER_DOMAIN_NAME=Default
export OS_PROJECT_NAME=admin
export OS_USERNAME=admin
export OS_PASSWORD=${ADMIN_PASSWORD}
export OS_REGION_NAME=${REGION_NAME}
RCEOF
    if $SUDO cmp -s "$tmp" "$ADMIN_OPENRC" 2>/dev/null; then
        log_ok "$ADMIN_OPENRC already current (unchanged)"
    else
        $SUDO cp "$tmp" "$ADMIN_OPENRC"
        log_ok "admin credentials written to $ADMIN_OPENRC"
    fi
    rm -f "$tmp"
    $SUDO chmod 0600 "$ADMIN_OPENRC"
    local perm; perm="$($SUDO stat -c '%a' "$ADMIN_OPENRC")"
    [ "$perm" = "600" ] || die "$ADMIN_OPENRC has mode $perm; expected 600"
}

# Run the openstack client as admin. Credentials go through the environment so
# that they never appear in argv or in any log line.
openstack_admin() {
    $SUDO env \
        OS_AUTH_URL="http://${MGMT_IP}:5000/v3" \
        OS_IDENTITY_API_VERSION=3 \
        OS_PROJECT_DOMAIN_NAME=Default \
        OS_USER_DOMAIN_NAME=Default \
        OS_PROJECT_NAME=admin \
        OS_USERNAME=admin \
        OS_PASSWORD="$ADMIN_PASSWORD" \
        OS_REGION_NAME="$REGION_NAME" \
        openstack "$@"
}

# ---------------------------------------------------------------------------
# Keystone registration helpers
#
# Every one is show-or-create: an existing user, service or endpoint is reused,
# never deleted and never recreated. Passwords go through the environment.
# ---------------------------------------------------------------------------
ks_ensure_project() {
    if openstack_admin project show "$1" >/dev/null 2>&1; then
        log_ok "project '$1' already exists"
    else
        openstack_admin project create --domain default "$1" >/dev/null
        log_ok "project '$1' created"
    fi
}

# ks_ensure_user <name> <password-value>
ks_ensure_user() {
    local name="$1" pass="$2"
    if openstack_admin user show "$name" >/dev/null 2>&1; then
        log_ok "service user '$name' already exists — password left unchanged"
    else
        # --password-prompt would block; the value is passed as an argument to a
        # function, which forks no process, and openstack reads it from stdin.
        printf '%s\n' "$pass" | openstack_admin user create --domain default \
            --password-prompt "$name" >/dev/null 2>&1 \
            || openstack_admin user create --domain default --password "$pass" "$name" >/dev/null
        log_ok "service user '$name' created"
    fi
}

ks_ensure_role_assignment() {
    local user="$1" project="$2" role="$3"
    if openstack_admin role assignment list --user "$user" --project "$project" \
         --role "$role" --names -f value 2>/dev/null | grep -q .; then
        log_ok "role '$role' already granted to '$user' on '$project'"
    else
        openstack_admin role add --project "$project" --user "$user" "$role" >/dev/null
        log_ok "role '$role' granted to '$user' on '$project'"
    fi
}

# ks_ensure_service <name> <type> <description>
ks_ensure_service() {
    if openstack_admin service show "$1" >/dev/null 2>&1; then
        log_ok "service '$1' already registered"
    else
        openstack_admin service create --name "$1" --description "$3" "$2" >/dev/null
        log_ok "service '$1' (type $2) registered"
    fi
}

# ks_ensure_endpoint <service> <interface> <url>
ks_ensure_endpoint() {
    local svc="$1" iface="$2" url="$3" existing
    existing="$(openstack_admin endpoint list --service "$svc" --interface "$iface" \
                  --region "$REGION_NAME" -f value -c URL 2>/dev/null | head -1)"
    if [ -n "$existing" ]; then
        if [ "$existing" = "$url" ]; then
            log_ok "endpoint $svc/$iface already correct"
        else
            log_warn "endpoint $svc/$iface exists with a different URL and is left as-is:"
            log_warn "  current: $existing"
            log_warn "  wanted : $url"
            log_warn "  hagistack does not delete endpoints; fix it by hand if that is wrong."
        fi
    else
        openstack_admin endpoint create --region "$REGION_NAME" "$svc" "$iface" "$url" >/dev/null
        log_ok "endpoint $svc/$iface created"
    fi
}

# Common [keystone_authtoken] block for a service. The password is written into
# a root-owned 0640 config file and is never echoed.
write_authtoken() {
    local conf="$1" user="$2" pass="$3"
    ini_set "$conf" keystone_authtoken www_authenticate_uri "http://${MGMT_IP}:5000" >/dev/null || true
    ini_set "$conf" keystone_authtoken auth_url             "http://${MGMT_IP}:5000" >/dev/null || true
    # Always written, so the file is byte-identical on every run. The phases
    # refuse to run at all unless memcached is actually listening, so this can
    # never point at a dead cache (which would block every token validation).
    ini_set "$conf" keystone_authtoken memcached_servers "${MGMT_IP}:11211" >/dev/null || true
    ini_set "$conf" keystone_authtoken auth_type            password                 >/dev/null || true
    ini_set "$conf" keystone_authtoken project_domain_name  Default                  >/dev/null || true
    ini_set "$conf" keystone_authtoken user_domain_name     Default                  >/dev/null || true
    ini_set "$conf" keystone_authtoken project_name         service                  >/dev/null || true
    ini_set "$conf" keystone_authtoken username             "$user"                  >/dev/null || true
    ini_set "$conf" keystone_authtoken password             "$pass"                  >/dev/null || true
}

# Guard shared by the Glance and Placement phases: the identity service has to
# be answering before anything can be registered against it.
keystone_ready_for_registration() {
    keystone_serving && openstack_admin token issue >/dev/null 2>&1
}

# ---------------------------------------------------------------------------
# Glance (image service)
#
# Packaging verified on Ubuntu 26.04 (glance 2:32.0.0-0ubuntu1), not assumed —
# see STEP3_GLANCE_PLACEMENT_EVIDENCE.md:
#   * Unlike Keystone, Glance DOES ship its own unit:
#     /usr/lib/systemd/system/glance-api.service (User=glance, Group=glance).
#     There is no Apache vhost for Glance at all.
#   * /etc/glance/glance-api.conf comes from `glance-common`, mode 0640
#     root:glance, and ships connection = sqlite:////var/lib/glance/glance.sqlite.
#   * bind_port has NO default (`#bind_port = <None>`), so it must be set
#     explicitly or Glance will not listen on 9292.
#   * The store is the multi-backend layout: [DEFAULT] enabled_backends,
#     [glance_store] default_backend, [file] filesystem_store_datadir.
#     /var/lib/glance/images already exists as glance:glance 0750.
#   * Both `glance-manage db_sync` and `glance-manage db sync` are accepted.
# ---------------------------------------------------------------------------
GLANCE_CONF="/etc/glance/glance-api.conf"
GLANCE_PORT=9292

glance_serving() {
    _probe curl -s -o /dev/null -m 10 "http://${MGMT_IP}:${GLANCE_PORT}/" 2>/dev/null
}

phase_glance() {
    log_step "image service (Glance)"

    if dpkg-query -W -f='${Status}' glance 2>/dev/null | grep -q "install ok installed"; then
        log_ok "glance already installed"
    else
        log_info "installing glance"
        $SUDO env DEBIAN_FRONTEND=noninteractive apt-get install -y -qq glance
        log_ok "glance installed"
    fi
    log_info "glance $(dpkg-query -W -f='${Version}' glance 2>/dev/null || echo '?') \
served by glance-api.service (its own unit; Glance has no Apache vhost)"

    if ! mariadb_reachable; then
        note_skip glance "MariaDB is not reachable; the image schema cannot be created."
        return 0
    fi
    if ! mysql_root -e "USE glance" >/dev/null 2>&1; then
        note_skip glance "the 'glance' database does not exist; the database phase did not complete."
        return 0
    fi
    if ! keystone_ready_for_registration; then
        note_skip glance "Keystone is not answering, so the image service cannot be registered.
     Glance was not configured. Bring identity up first."
        return 0
    fi
    if ! memcached_reachable; then
        note_skip glance "memcached is not listening on ${MGMT_IP}:11211.
     Glance's token validation is configured to use it, so configuring Glance
     against a dead cache would make every authenticated call block. Nothing
     was changed. Bring the cache up (it is part of the base layer) and re-run."
        return 0
    fi

    # --- configuration ---------------------------------------------------
    local changed=0
    ini_set "$GLANCE_CONF" database connection \
        "mysql+pymysql://glance:${GLANCE_DB_PASS}@127.0.0.1/glance?charset=utf8mb4" && changed=1
    write_db_pool "$GLANCE_CONF"
    ini_set "$GLANCE_CONF" DEFAULT bind_host        "$MGMT_IP"       && changed=1
    ini_set "$GLANCE_CONF" DEFAULT bind_port        "$GLANCE_PORT"   && changed=1
    ini_set "$GLANCE_CONF" DEFAULT enabled_backends "file:file"      && changed=1
    ini_set "$GLANCE_CONF" glance_store default_backend file         && changed=1
    ini_set "$GLANCE_CONF" file filesystem_store_datadir /var/lib/glance/images && changed=1
    ini_set "$GLANCE_CONF" paste_deploy flavor keystone              && changed=1
    write_authtoken "$GLANCE_CONF" glance "$GLANCE_SERVICE_PASS"
    if [ "$changed" -eq 1 ]; then
        log_ok "glance-api.conf updated (credentials not shown)"
    else
        log_ok "glance-api.conf already correct (unchanged)"
    fi
    # The package ships this file root:glance 0640 — keep it that way.
    $SUDO chown root:glance "$GLANCE_CONF" 2>/dev/null || true
    $SUDO chmod 0640 "$GLANCE_CONF"

    # --- schema ------------------------------------------------------------
    local before after
    before="$(mysql_root -N -B -e \
        "SELECT COUNT(*) FROM information_schema.tables WHERE table_schema='glance'" 2>/dev/null || echo 0)"
    log_info "running glance-manage db_sync (idempotent migration)"
    local gerr; gerr="$(mktemp)"; chmod 0600 "$gerr"
    if ! $SUDO runuser -u glance -- glance-manage db_sync >"$gerr" 2>&1; then
        log_error "glance-manage db_sync failed. Diagnostics (credentials redacted):"
        $SUDO sed "s/${GLANCE_DB_PASS}/<redacted>/g; s/${GLANCE_SERVICE_PASS}/<redacted>/g" "$gerr" \
          | grep -viE 'password|secret' | tail -12 | sed 's/^/     /' >&2
        rm -f "$gerr"
        note_skip glance "the image schema could not be created (see the diagnostics above)."
        return 0
    fi
    rm -f "$gerr"
    after="$(mysql_root -N -B -e \
        "SELECT COUNT(*) FROM information_schema.tables WHERE table_schema='glance'" 2>/dev/null || echo 0)"
    if [ "$before" = "0" ]; then log_ok "image schema created ($after tables)"
    elif [ "$before" = "$after" ]; then log_ok "image schema already current ($after tables, unchanged)"
    else log_ok "image schema migrated ($before -> $after tables)"; fi

    # --- identity registration ---------------------------------------------
    ks_ensure_project service
    ks_ensure_user glance "$GLANCE_SERVICE_PASS"
    ks_ensure_role_assignment glance service admin
    ks_ensure_service glance image "OpenStack Image"
    local url="http://${MGMT_IP}:${GLANCE_PORT}"
    ks_ensure_endpoint glance public   "$url"
    ks_ensure_endpoint glance internal "$url"
    ks_ensure_endpoint glance admin    "$url"

    # --- run it --------------------------------------------------------------
    # glance-api is started by its own package at install time, i.e. before the
    # configuration above existed; service_apply restarts it only when the file
    # it reads is newer than the running process.
    service_apply glance-api "$GLANCE_CONF"
    if ! service_active glance-api; then
        note_skip glance "glance-api is not running, so the image API is not being served.
     The schema, configuration and identity registration ARE in place.
     Startup under systemd is a GCE acceptance item (B0a/B0b)."
        return 0
    fi
    if ! wait_for 90 "the image API" glance_serving; then
        note_skip glance "glance-api is active but http://${MGMT_IP}:${GLANCE_PORT}/ did not answer."
        return 0
    fi
    if ! wait_for 60 "an authenticated image list" openstack_admin image list >/dev/null 2>&1; then
        note_skip glance "the image endpoint answers but 'openstack image list' failed as admin."
        return 0
    fi
    log_ok "image API verified (openstack image list succeeded)"
    phase_mark_done glance
}

# ---------------------------------------------------------------------------
# Placement
#
# Packaging verified on Ubuntu 26.04 (placement-api 1:15.0.0-0ubuntu1):
#   * placement-api ships exactly TWO files: the Apache vhost
#     /etc/apache2/sites-available/placement-api.conf and /usr/bin/placement-api.
#     There is NO placement systemd unit — like Keystone, it runs under
#     apache2.service, on a second vhost alongside identity.
#   * That vhost carries its own `Listen 8778` and <VirtualHost *:8778>, and the
#     package enables the site on install.
#   * /etc/placement/placement.conf comes from `placement-common`, 0640
#     root:placement, and its database key is [placement_database] connection —
#     NOT [database]. Writing to [database] would silently leave it on sqlite.
#   * The migration command is `placement-manage db sync`; `db_sync` is NOT a
#     valid subcommand here (it is for glance-manage — the two differ).
# ---------------------------------------------------------------------------
PLACEMENT_CONF="/etc/placement/placement.conf"
PLACEMENT_PORT=8778

placement_serving() {
    _probe curl -s -o /dev/null -m 10 "http://${MGMT_IP}:${PLACEMENT_PORT}/" 2>/dev/null
}

phase_placement() {
    log_step "placement service"

    if dpkg-query -W -f='${Status}' placement-api 2>/dev/null | grep -q "install ok installed"; then
        log_ok "placement-api already installed"
    else
        log_info "installing placement-api (Apache vhost + WSGI entry point)"
        $SUDO env DEBIAN_FRONTEND=noninteractive apt-get install -y -qq placement-api
        log_ok "placement-api installed"
    fi
    log_info "placement $(dpkg-query -W -f='${Version}' placement-api 2>/dev/null || echo '?') \
served by apache2 + mod_wsgi on :${PLACEMENT_PORT} (no placement systemd unit exists)"

    if ! mariadb_reachable; then
        note_skip placement "MariaDB is not reachable; the placement schema cannot be created."
        return 0
    fi
    if ! mysql_root -e "USE placement" >/dev/null 2>&1; then
        note_skip placement "the 'placement' database does not exist; the database phase did not complete."
        return 0
    fi
    if ! keystone_ready_for_registration; then
        note_skip placement "Keystone is not answering, so placement cannot be registered."
        return 0
    fi
    if ! memcached_reachable; then
        note_skip placement "memcached is not listening on ${MGMT_IP}:11211; see the glance
     phase for why configuring against a dead token cache is refused."
        return 0
    fi

    # --- configuration -------------------------------------------------------
    # NOTE the section name: [placement_database], not [database].
    local changed=0
    ini_set "$PLACEMENT_CONF" placement_database connection \
        "mysql+pymysql://placement:${PLACEMENT_DB_PASS}@127.0.0.1/placement?charset=utf8mb4" && changed=1
    write_db_pool "$PLACEMENT_CONF" placement_database
    ini_set "$PLACEMENT_CONF" api auth_strategy keystone && changed=1
    write_authtoken "$PLACEMENT_CONF" placement "$PLACEMENT_SERVICE_PASS"
    if [ "$changed" -eq 1 ]; then
        log_ok "placement.conf updated (credentials not shown)"
    else
        log_ok "placement.conf already correct (unchanged)"
    fi
    $SUDO chown root:placement "$PLACEMENT_CONF" 2>/dev/null || true
    $SUDO chmod 0640 "$PLACEMENT_CONF"

    # --- schema ---------------------------------------------------------------
    local before after
    before="$(mysql_root -N -B -e \
        "SELECT COUNT(*) FROM information_schema.tables WHERE table_schema='placement'" 2>/dev/null || echo 0)"
    log_info "running placement-manage db sync (idempotent migration)"
    local perr; perr="$(mktemp)"; chmod 0600 "$perr"
    if ! $SUDO runuser -u placement -- placement-manage db sync >"$perr" 2>&1; then
        log_error "placement-manage db sync failed. Diagnostics (credentials redacted):"
        $SUDO sed "s/${PLACEMENT_DB_PASS}/<redacted>/g; s/${PLACEMENT_SERVICE_PASS}/<redacted>/g" "$perr" \
          | grep -viE 'password|secret' | tail -12 | sed 's/^/     /' >&2
        rm -f "$perr"
        note_skip placement "the placement schema could not be created (see the diagnostics above)."
        return 0
    fi
    rm -f "$perr"
    after="$(mysql_root -N -B -e \
        "SELECT COUNT(*) FROM information_schema.tables WHERE table_schema='placement'" 2>/dev/null || echo 0)"
    if [ "$before" = "0" ]; then log_ok "placement schema created ($after tables)"
    elif [ "$before" = "$after" ]; then log_ok "placement schema already current ($after tables, unchanged)"
    else log_ok "placement schema migrated ($before -> $after tables)"; fi

    # --- identity registration -------------------------------------------------
    ks_ensure_project service
    ks_ensure_user placement "$PLACEMENT_SERVICE_PASS"
    ks_ensure_role_assignment placement service admin
    ks_ensure_service placement placement "Placement API"
    local url="http://${MGMT_IP}:${PLACEMENT_PORT}"
    ks_ensure_endpoint placement public   "$url"
    ks_ensure_endpoint placement internal "$url"
    ks_ensure_endpoint placement admin    "$url"

    # --- serve it ----------------------------------------------------------------
    $SUDO a2ensite placement-api >/dev/null 2>&1 || true
    if [ "$HAS_SYSTEMD" -eq 1 ] && service_active apache2; then
        $SUDO systemctl reload-or-restart apache2 \
            || die "apache2 failed to reload after the placement configuration change"
        log_ok "apache2 reloaded (now serving identity on 5000 and placement on ${PLACEMENT_PORT})"
    else
        service_start_enable apache2
    fi
    if ! service_active apache2; then
        note_skip placement "apache2 is not running, so the placement API is not being served.
     The schema, configuration and identity registration ARE in place.
     Startup under systemd is a GCE acceptance item (B0a/B0b)."
        return 0
    fi
    if ! wait_for 60 "the placement endpoint" placement_serving; then
        note_skip placement "apache2 is active but http://${MGMT_IP}:${PLACEMENT_PORT}/ did not answer."
        return 0
    fi
    if ! wait_for 60 "an authenticated placement request" placement_api_authenticated; then
        note_skip placement "the placement endpoint answers but an authenticated request failed."
        return 0
    fi
    log_ok "placement API verified (authenticated /resource_providers answered)"
    phase_mark_done placement
}

# An authenticated GET against /resource_providers. The token goes into a 0600
# curl config file rather than argv, so it never shows up in the process list.
placement_api_authenticated() {
    local tok cfg rc
    tok="$(openstack_admin token issue -f value -c id 2>/dev/null)" || return 1
    [ -n "$tok" ] || return 1
    cfg="$(mktemp)"; chmod 0600 "$cfg"
    printf 'header = "X-Auth-Token: %s"\nheader = "OpenStack-API-Version: placement latest"\n' "$tok" > "$cfg"
    _probe curl -sS -m 15 -o /dev/null -w '%{http_code}' -K "$cfg" \
        "http://${MGMT_IP}:${PLACEMENT_PORT}/resource_providers" 2>/dev/null | grep -q '^200$'
    rc=$?
    rm -f "$cfg"
    return $rc
}

# ---------------------------------------------------------------------------
# OVN (network infrastructure)
#
# Packaging verified on Ubuntu 26.04, not assumed — see
# STEP4_NEUTRON_OVN_EVIDENCE.md. openvswitch-switch 3.7.1-2, ovn-central and
# ovn-host 26.03.0-2:
#   * `ovn-central.service` and `ovn-host.service` are oneshot wrappers whose
#     ExecStart is /bin/true. They only pull real units in via Wants=:
#       ovn-central -> ovn-ovsdb-server-nb, ovn-ovsdb-server-sb, ovn-northd
#       ovn-host    -> ovn-controller
#     So liveness must be checked on the real units, never on the wrapper.
#   * Startup order comes from the units' own After=:
#       openvswitch-switch -> ovn-ovsdb-server-nb/sb -> ovn-northd -> ovn-controller
#   * The DB servers run with --ovn-manage-ovsdb=no, i.e. they are owned by
#     their own units rather than spawned by northd/controller.
#   * /etc/ovn, /var/lib/ovn, /var/log/ovn and /var/run/ovn do NOT exist until
#     the first start; nothing may assume them.
#   * The NB/SB servers listen on unix sockets only until a connection is set,
#     while ml2's defaults point at tcp:127.0.0.1:6641/6642 — so the listeners
#     have to be established explicitly.
#
# Three concerns are kept deliberately separate:
#   management network  MGMT_IP          API/RPC/OVN southbound reachability
#   Geneve overlay      ovn-encap-ip     inter-node tunnels (compute-add later)
#   provider network    PROVIDER_PHYSNET:PROVIDER_BRIDGE   bridge mapping only
#
# This phase creates the provider bridge but attaches NO port and assigns NO
# address. Enslaving a NIC or moving the management IP onto the bridge is a
# separate, disruptive step and is deliberately not performed here.
# ---------------------------------------------------------------------------
OVN_NB_PORT=6641
OVN_SB_PORT=6642
# The local Open vSwitch database. Ubuntu's openvswitch-switch listens only on
# this unix socket, which is srwxr-x--- root:root — the `nova` user cannot open
# it. os_vif, which plugs each instance's tap device, defaults to
# tcp:127.0.0.1:6640, and nothing listens there either. Both measured on a GCE
# host, where every guest build failed with
#   ERROR os_vif Exception: Could not retrieve schema from tcp:127.0.0.1:6640
# and, after pointing it at the socket instead,
#   ERROR ovsdbapp ... Unable to open stream to unix:/var/run/openvswitch/db.sock
# So the OVN phase asks ovsdb-server for a LOOPBACK-ONLY manager and os_vif is
# pointed at that. No port becomes reachable off the host, and the setting lives
# in the OVSDB, so it survives a restart of the daemon.
OVS_DB_SOCK="/var/run/openvswitch/db.sock"
OVS_MANAGER="ptcp:6640:127.0.0.1"
OVS_DB_TCP="tcp:127.0.0.1:6640"

ovs_vsctl() { _probe ovs-vsctl "$@"; }
ovn_nbctl()  { _probe ovn-nbctl "$@"; }
ovn_sbctl()  { _probe ovn-sbctl "$@"; }

# The real daemons behind the oneshot wrappers.
OVN_CENTRAL_UNITS="ovn-ovsdb-server-nb ovn-ovsdb-server-sb ovn-northd"
OVN_HOST_UNITS="ovn-controller"

ovn_nb_ready() { ovn_nbctl --timeout=10 show >/dev/null 2>&1; }
ovn_sb_ready() { ovn_sbctl --timeout=10 show >/dev/null 2>&1; }
ovs_ready()    { ovs_vsctl --timeout=10 show >/dev/null 2>&1; }

phase_ovn() {
    log_step "network infrastructure (OVS + OVN)"

    local pkgs="openvswitch-switch ovn-central ovn-host"
    local absent=""
    local p
    for p in $pkgs; do
        dpkg-query -W -f='${Status}' "$p" 2>/dev/null | grep -q "install ok installed" || absent="$absent $p"
    done
    if [ -n "$absent" ]; then
        log_info "installing:$absent"
        # shellcheck disable=SC2086
        $SUDO env DEBIAN_FRONTEND=noninteractive apt-get install -y -qq $pkgs
        log_ok "OVS and OVN installed"
    else
        log_ok "OVS and OVN already installed"
    fi
    log_info "openvswitch $(dpkg-query -W -f='${Version}' openvswitch-switch 2>/dev/null || echo '?'), \
ovn $(dpkg-query -W -f='${Version}' ovn-central 2>/dev/null || echo '?')"
    log_info "ovn-central/ovn-host are oneshot wrappers; the real units are:"
    log_info "  $OVN_CENTRAL_UNITS $OVN_HOST_UNITS"

    # --- start the data/control plane, in the order the units declare -------
    if [ "$HAS_SYSTEMD" -eq 1 ]; then
        service_start_enable openvswitch-switch
        local u
        for u in $OVN_CENTRAL_UNITS $OVN_HOST_UNITS; do service_start_enable "$u"; done
    else
        log_warn "systemd is not running here; OVS/OVN cannot be started as managed services"
        log_warn "  -> unit startup and ordering stay a GCE acceptance item (B0a/B0b)"
    fi

    if ! ovs_ready; then
        note_skip ovn "the Open vSwitch database is not answering (ovs-vsctl show failed).
     Nothing was configured. OVS must be running before OVN can be set up."
        return 0
    fi
    log_ok "Open vSwitch database reachable"

    if ! ovn_nb_ready || ! ovn_sb_ready; then
        note_skip ovn "the OVN northbound/southbound databases are not answering.
     Checked the real units ($OVN_CENTRAL_UNITS), not the oneshot wrapper.
     Nothing was configured."
        return 0
    fi
    log_ok "OVN northbound and southbound databases reachable"

    # --- OVN DB listeners --------------------------------------------------
    # Northbound stays on loopback: only the local Neutron talks to it.
    # Southbound listens on the management address because compute nodes will
    # need it at compute-add.
    local want_nb="ptcp:${OVN_NB_PORT}:127.0.0.1"
    local want_sb="ptcp:${OVN_SB_PORT}:${MGMT_IP}"
    local have_nb have_sb
    # Read the target column, not `get-connection`: on the southbound DB the
    # latter also prints the role and read-write flags, so a plain string
    # comparison against it never matches and the listener would be re-set on
    # every run. Measured: `read-write role="" ptcp:6642:<ip>`.
    have_nb="$(ovn_nbctl --bare --columns=target list connection 2>/dev/null | tr -d '[:space:]')"
    have_sb="$(ovn_sbctl --bare --columns=target list connection 2>/dev/null | tr -d '[:space:]')"
    if [ "$have_nb" = "$want_nb" ]; then
        log_ok "OVN northbound listener already $want_nb"
    else
        ovn_nbctl set-connection "$want_nb" || die "could not set the OVN northbound listener"
        log_ok "OVN northbound listener set to $want_nb"
    fi
    if [ "$have_sb" = "$want_sb" ]; then
        log_ok "OVN southbound listener already $want_sb"
    else
        ovn_sbctl set-connection "$want_sb" || die "could not set the OVN southbound listener"
        log_ok "OVN southbound listener set to $want_sb (reachable by future compute nodes)"
    fi

    # --- local ovsdb manager, for os_vif ------------------------------------
    local have_mgr
    have_mgr="$(ovs_vsctl --bare --columns=target list manager 2>/dev/null | tr -d '[:space:]' || true)"
    if [ "$have_mgr" = "$OVS_MANAGER" ]; then
        log_ok "Open vSwitch manager already $OVS_MANAGER"
    else
        ovs_vsctl set-manager "$OVS_MANAGER" \
            || die "could not set the Open vSwitch manager to $OVS_MANAGER"
        log_ok "Open vSwitch manager set to $OVS_MANAGER (loopback only; os_vif needs it)"
    fi

    # --- provider bridge: created, but deliberately left empty -------------
    if ovs_vsctl br-exists "$PROVIDER_BRIDGE" 2>/dev/null; then
        log_ok "provider bridge $PROVIDER_BRIDGE already exists"
    else
        ovs_vsctl --may-exist add-br "$PROVIDER_BRIDGE" \
            || die "could not create the provider bridge $PROVIDER_BRIDGE"
        log_ok "provider bridge $PROVIDER_BRIDGE created"
    fi
    local ports
    ports="$(ovs_vsctl list-ports "$PROVIDER_BRIDGE" 2>/dev/null | tr '\n' ' ')"
    log_info "ports on $PROVIDER_BRIDGE: ${ports:-<none, by design>}"
    log_warn "no NIC is enslaved to $PROVIDER_BRIDGE and no address is assigned to it."
    log_warn "  Attaching a physical NIC and moving the management IP is a separate,"
    log_warn "  disruptive step that hagistack does not perform here. Until it is done,"
    log_warn "  provider networks exist in Neutron but have no path to a physical LAN."

    # --- local chassis configuration ---------------------------------------
    # ovn-encap-ip is the Geneve tunnel endpoint: the management address.
    # ovn-bridge-mappings is the provider-network concern, kept separate.
    _ovs_extid() {  # _ovs_extid <key> <value>
        local cur
        cur="$(ovs_vsctl --if-exists get open_vswitch . "external_ids:$1" 2>/dev/null | tr -d '"')"
        if [ "$cur" = "$2" ]; then return 1; fi
        ovs_vsctl set open_vswitch . "external_ids:$1=$2"
        return 0
    }
    local changed=0
    _ovs_extid ovn-remote        "tcp:${MGMT_IP}:${OVN_SB_PORT}"            && changed=1
    _ovs_extid ovn-encap-type    geneve                                     && changed=1
    _ovs_extid ovn-encap-ip      "$MGMT_IP"                                 && changed=1
    _ovs_extid ovn-bridge-mappings "${PROVIDER_PHYSNET}:${PROVIDER_BRIDGE}" && changed=1
    _ovs_extid ovn-cms-options   enable-chassis-as-gw                       && changed=1
    if [ "$changed" -eq 1 ]; then
        log_ok "local chassis configured (ovn-remote, geneve encap on $MGMT_IP, ${PROVIDER_PHYSNET}:${PROVIDER_BRIDGE})"
    else
        log_ok "local chassis already configured (unchanged)"
    fi

    # --- did this host register itself as a chassis? ------------------------
    local sysid chassis
    sysid="$(ovs_vsctl --if-exists get open_vswitch . external_ids:system-id 2>/dev/null | tr -d '"')"
    chassis="$(ovn_sbctl --bare --columns=name list chassis 2>/dev/null | tr '\n' ' ')"
    if [ -n "$chassis" ]; then
        log_ok "chassis registered in the OVN southbound DB: $chassis"
    else
        log_warn "no chassis is registered in the southbound DB yet (system-id: ${sysid:-unset})."
        log_warn "  ovn-controller may still be starting, or it cannot reach ${MGMT_IP}:${OVN_SB_PORT}."
    fi

    phase_mark_done ovn
}

# ---------------------------------------------------------------------------
# Neutron (networking API)
#
# Packaging verified on Ubuntu 26.04 (neutron 2:28.0.2-0ubuntu1):
#   * The API is served by Apache: the `neutron-api` package ships
#     /etc/apache2/sites-available/neutron-api.conf with its own `Listen 9696`
#     and WSGIScriptAlias to /usr/share/neutron/neutron-api.wsgi, and the site
#     is enabled on install.
#   * Four further units are separate processes, each from its own package:
#       neutron-rpc-server.service        User=neutron
#       neutron-periodic-workers.service
#       neutron-ovn-maintenance-worker.service
#       neutron-ovn-metadata-agent.service  User=root (it manipulates netns)
#   * neutron-ovn-maintenance-worker is, in the package's own words, what
#     "should be used when running Neutron API under WSGI for OVN deployments":
#     the only process that runs the ML2/OVN maintenance worker (the NB/SB sync
#     at start and the periodic repair of Neutron/OVN inconsistencies).
#   * `neutron-server` is "a dummy transitional package that can be removed
#     after upgrade" (it only depends on neutron-api, -rpc-server and
#     -periodic-workers), and neutron-ovn-maintenance-worker Conflicts with it.
#     So the real packages are installed by name and neutron-server is not.
#   * neutron.conf and plugins/ml2/ml2_conf.ini both come from
#     `neutron-common`, mode 0640 root:neutron.
#   * Config loading was checked in neutron/server/__init__.py: with no
#     OS_NEUTRON_CONFIG_FILES set, the WSGI app defaults to
#     ['neutron.conf', 'plugins/ml2/ml2_conf.ini'] — so the API and the RPC
#     server read the same pair and cannot disagree about the mechanism driver.
#   * There is no /etc/neutron/plugin.ini convention in this packaging.
#   * DB schema is managed by `neutron-db-manage ... upgrade head`.
# ---------------------------------------------------------------------------
NEUTRON_CONF="/etc/neutron/neutron.conf"
ML2_CONF="/etc/neutron/plugins/ml2/ml2_conf.ini"
OVN_META_CONF="/etc/neutron/neutron_ovn_metadata_agent.ini"
NEUTRON_PORT=9696
NEUTRON_UNITS="neutron-rpc-server neutron-periodic-workers neutron-ovn-maintenance-worker neutron-ovn-metadata-agent"

neutron_serving() {
    _probe curl -s -o /dev/null -m 10 "http://${MGMT_IP}:${NEUTRON_PORT}/" 2>/dev/null
}

phase_neutron() {
    log_step "networking API (Neutron, ML2/OVN)"

    # Checked package by package rather than behind one sentinel package: a host
    # built by an earlier hagistack has the transitional neutron-server and no
    # maintenance worker, and a re-run must converge it. Naming the whole set
    # also marks neutron-api and friends as manually installed, so they do not
    # become autoremovable when neutron-server goes (apt removes it because the
    # maintenance worker Conflicts with it). Nothing already present is reinstalled.
    local neutron_pkgs="neutron-api neutron-rpc-server neutron-periodic-workers
                        neutron-ovn-maintenance-worker neutron-plugin-ml2
                        neutron-ovn-metadata-agent"
    local pkg absent=""
    for pkg in $neutron_pkgs; do
        dpkg-query -W -f='${Status}' "$pkg" 2>/dev/null | grep -q "install ok installed" \
            || absent="${absent} $pkg"
    done
    if dpkg-query -W -f='${Status}' neutron-server 2>/dev/null | grep -q "install ok installed"; then
        absent="${absent} (replacing the transitional neutron-server)"
    fi
    if [ -z "$absent" ]; then
        log_ok "neutron already installed"
    else
        log_info "installing:$absent"
        # shellcheck disable=SC2086
        $SUDO env DEBIAN_FRONTEND=noninteractive apt-get install -y -qq $neutron_pkgs
        log_ok "neutron installed"
    fi
    log_info "neutron $(dpkg-query -W -f='${Version}' python3-neutron 2>/dev/null || echo '?'): \
API via apache2 on :${NEUTRON_PORT} (from neutron-api), plus $NEUTRON_UNITS"

    # --- dependencies -------------------------------------------------------
    if ! mariadb_reachable; then
        note_skip neutron "MariaDB is not reachable; the networking schema cannot be created."
        return 0
    fi
    if ! mysql_root -e "USE neutron" >/dev/null 2>&1; then
        note_skip neutron "the 'neutron' database does not exist; the database phase did not complete."
        return 0
    fi
    if ! keystone_ready_for_registration; then
        note_skip neutron "Keystone is not answering, so networking cannot be registered."
        return 0
    fi
    if ! memcached_reachable; then
        note_skip neutron "memcached is not listening on ${MGMT_IP}:11211; see the glance phase."
        return 0
    fi
    if ! phase_done ovn; then
        note_skip neutron "the OVN phase did not complete, so ML2/OVN has nothing to drive.
     Neutron was not configured."
        return 0
    fi

    # --- neutron.conf --------------------------------------------------------
    local changed=0
    ini_set "$NEUTRON_CONF" DEFAULT core_plugin     ml2                     && changed=1
    ini_set "$NEUTRON_CONF" DEFAULT service_plugins ovn-router              && changed=1
    ini_set "$NEUTRON_CONF" DEFAULT auth_strategy   keystone                && changed=1
    ini_set "$NEUTRON_CONF" DEFAULT transport_url \
        "rabbit://openstack:${RABBIT_PASS}@${MGMT_IP}:5672/"                && changed=1
    ini_set "$NEUTRON_CONF" database connection \
        "mysql+pymysql://neutron:${NEUTRON_DB_PASS}@127.0.0.1/neutron?charset=utf8mb4" && changed=1
    write_db_pool "$NEUTRON_CONF"
    write_authtoken "$NEUTRON_CONF" neutron "$NEUTRON_SERVICE_PASS"
    # Neutron has to call Nova back. When a port becomes ACTIVE it posts
    # os-server-external-events (network-vif-plugged) to the compute API, and
    # Nova blocks the instance in BUILD until that arrives.
    #
    # The packaged neutron.conf ships an EMPTY [nova] section — comments only —
    # so without this Neutron has no credentials to make that call, Nova waits
    # out [DEFAULT] vif_plugging_timeout (300s by default) and the build dies:
    #   nova.exception.VirtualInterfaceCreateException: Virtual Interface
    #   creation failed
    # Measured on a GCE host: the domain was created and paused, ovn-controller
    # claimed the logical port and set it up in the southbound database, and the
    # instance still went to ERROR after 252 seconds because nobody told Nova.
    write_service_auth "$NEUTRON_CONF" nova nova "$NOVA_SERVICE_PASS"

    # --- ml2_conf.ini --------------------------------------------------------
    # geneve for tenant networks; flat AND vlan offered on the provider physnet
    # so that multiple provider LANs can be added later without re-plumbing.
    ini_set "$ML2_CONF" ml2 type_drivers          "flat,vlan,geneve"        && changed=1
    ini_set "$ML2_CONF" ml2 tenant_network_types   geneve                   && changed=1
    ini_set "$ML2_CONF" ml2 mechanism_drivers      ovn                      && changed=1
    ini_set "$ML2_CONF" ml2 extension_drivers      port_security            && changed=1
    ini_set "$ML2_CONF" ml2 overlay_ip_version     4                        && changed=1
    ini_set "$ML2_CONF" ml2_type_geneve vni_ranges       "1:65536"          && changed=1
    ini_set "$ML2_CONF" ml2_type_geneve max_header_size  38                 && changed=1
    ini_set "$ML2_CONF" ml2_type_flat   flat_networks       "$PROVIDER_PHYSNET" && changed=1
    ini_set "$ML2_CONF" ml2_type_vlan   network_vlan_ranges "$PROVIDER_PHYSNET" && changed=1
    ini_set "$ML2_CONF" securitygroup   enable_security_group true          && changed=1
    ini_set "$ML2_CONF" ovn ovn_nb_connection "tcp:127.0.0.1:${OVN_NB_PORT}" && changed=1
    ini_set "$ML2_CONF" ovn ovn_sb_connection "tcp:${MGMT_IP}:${OVN_SB_PORT}" && changed=1
    ini_set "$ML2_CONF" ovn ovn_l3_scheduler   leastloaded                  && changed=1
    ini_set "$ML2_CONF" ovn ovn_metadata_enabled true                       && changed=1

    # --- metadata agent ------------------------------------------------------
    ini_set "$OVN_META_CONF" DEFAULT nova_metadata_host "$MGMT_IP"          && changed=1
    ini_set "$OVN_META_CONF" DEFAULT metadata_proxy_shared_secret \
        "$METADATA_PROXY_SECRET"                                            && changed=1
    ini_set "$OVN_META_CONF" ovs ovsdb_connection "unix:$OVS_DB_SOCK" && changed=1
    ini_set "$OVN_META_CONF" ovn ovn_sb_connection "tcp:${MGMT_IP}:${OVN_SB_PORT}" && changed=1

    if [ "$changed" -eq 1 ]; then
        log_ok "neutron.conf, ml2_conf.ini and the metadata agent configured (credentials not shown)"
    else
        log_ok "neutron configuration already correct (unchanged)"
    fi
    # The packages ship these root:neutron 0640 — keep it.
    local f
    for f in "$NEUTRON_CONF" "$ML2_CONF" "$OVN_META_CONF"; do
        $SUDO chown root:neutron "$f" 2>/dev/null || true
        $SUDO chmod 0640 "$f"
    done

    # --- schema --------------------------------------------------------------
    local before after
    before="$(mysql_root -N -B -e \
        "SELECT COUNT(*) FROM information_schema.tables WHERE table_schema='neutron'" 2>/dev/null || echo 0)"
    log_info "running neutron-db-manage upgrade head (idempotent migration)"
    local nerr; nerr="$(mktemp)"; chmod 0600 "$nerr"
    if ! $SUDO runuser -u neutron -- neutron-db-manage \
            --config-file "$NEUTRON_CONF" --config-file "$ML2_CONF" upgrade head >"$nerr" 2>&1; then
        log_error "neutron-db-manage failed. Diagnostics (credentials redacted):"
        $SUDO sed "s/${NEUTRON_DB_PASS}/<redacted>/g; s/${NEUTRON_SERVICE_PASS}/<redacted>/g; s/${RABBIT_PASS}/<redacted>/g" "$nerr" \
          | grep -viE 'password|secret' | tail -12 | sed 's/^/     /' >&2
        rm -f "$nerr"
        note_skip neutron "the networking schema could not be created (see the diagnostics above)."
        return 0
    fi
    rm -f "$nerr"
    after="$(mysql_root -N -B -e \
        "SELECT COUNT(*) FROM information_schema.tables WHERE table_schema='neutron'" 2>/dev/null || echo 0)"
    if [ "$before" = "0" ]; then log_ok "networking schema created ($after tables)"
    elif [ "$before" = "$after" ]; then log_ok "networking schema already current ($after tables, unchanged)"
    else log_ok "networking schema migrated ($before -> $after tables)"; fi

    # --- identity registration ------------------------------------------------
    ks_ensure_project service
    ks_ensure_user neutron "$NEUTRON_SERVICE_PASS"
    ks_ensure_role_assignment neutron service admin
    ks_ensure_service neutron network "OpenStack Networking"
    local url="http://${MGMT_IP}:${NEUTRON_PORT}"
    ks_ensure_endpoint neutron public   "$url"
    ks_ensure_endpoint neutron internal "$url"
    ks_ensure_endpoint neutron admin    "$url"

    # --- run it ----------------------------------------------------------------
    $SUDO a2ensite neutron-api >/dev/null 2>&1 || true
    # Must happen before apache2 is (re)started: ProcSubset is a unit property,
    # so a reload does not pick it up and a running Apache keeps the old view
    # of /proc. Returns 0 when it changed the drop-in, which forces a full
    # restart rather than a reload.
    local procsubset_changed=0
    apache_allow_proc_subset && procsubset_changed=1
    if [ "$HAS_SYSTEMD" -eq 1 ]; then
        if [ "$procsubset_changed" -eq 1 ] && service_active apache2; then
            $SUDO systemctl restart apache2 \
                || die "apache2 failed to restart after the ProcSubset override was written"
            log_ok "apache2 restarted so the ProcSubset override takes effect"
        elif service_active apache2; then
            $SUDO systemctl reload-or-restart apache2 \
                || die "apache2 failed to reload after the neutron configuration change"
            log_ok "apache2 reloaded (identity :5000, placement :8778, networking :${NEUTRON_PORT})"
        else
            service_start_enable apache2
        fi
        local u
        # Same trap as glance: these units are started by their packages before
        # neutron.conf and ml2_conf.ini exist, so they would otherwise keep
        # running on the stock sqlite configuration.
        for u in $NEUTRON_UNITS; do service_apply "$u" "$NEUTRON_CONF" "$ML2_CONF" "$OVN_META_CONF"; done
    else
        log_warn "systemd is not running here; the neutron units cannot be started"
        for u in $NEUTRON_UNITS; do SERVICE_START_METHOD[$u]="not-started-no-systemd"; done
    fi

    if ! service_active apache2; then
        note_skip neutron "apache2 is not running, so the networking API is not being served.
     The schema, configuration and identity registration ARE in place.
     Startup under systemd is a GCE acceptance item (B0a/B0b)."
        return 0
    fi
    if ! wait_for 60 "the networking API" neutron_serving; then
        note_skip neutron "apache2 is active but http://${MGMT_IP}:${NEUTRON_PORT}/ did not answer."
        return 0
    fi
    if ! wait_for 60 "an authenticated network list" openstack_admin network list >/dev/null 2>&1; then
        note_skip neutron "the networking endpoint answers but 'openstack network list' failed as admin."
        return 0
    fi
    log_ok "networking API verified (openstack network list succeeded)"
    # Measure the thing the override exists for, rather than trusting that
    # writing a drop-in worked. A neutron worker that cannot read /proc/meminfo
    # drops every OVN event and no guest will ever boot, so this is reported
    # loudly rather than left to be discovered 300 seconds into a build.
    apache_sees_meminfo
    case $? in
      0) log_ok "apache2 workers can read /proc/meminfo (OVN port-up events will be processed)" ;;
      2) log_info "no neutron wsgi worker is up yet; /proc/meminfo visibility is checked on the next run" ;;
      *) log_warn "apache2 workers still cannot read /proc/meminfo."
         log_warn "  Neutron's OVN driver will drop every port-up event and NO GUEST WILL BOOT."
         log_warn "  Check $APACHE_DROPIN and 'systemctl show apache2 -p ProcSubset'." ;;
    esac
    log_warn "the API answers, but no network exists yet and nothing has been routed:"
    log_warn "  the initial resources are created later, by the bootstrap_resources phase."
    phase_mark_done neutron
}

# ---------------------------------------------------------------------------
# Nova (compute)
#
# Packaging verified on Ubuntu 26.04 (nova 3:33.0.0-0ubuntu3.1), by unpacking
# the .deb files rather than by analogy with the other services:
#   * nova-api ships /etc/apache2/sites-available/nova-api.conf with its own
#     `Listen 8774` and WSGIScriptAlias to /usr/bin/nova-api-wsgi, and its
#     postinst runs `apache2_invoke ensite`. There is NO nova-api systemd unit.
#     nova-api-metadata is a separate package with its own vhost on `Listen
#     8775` and /usr/bin/nova-metadata-wsgi.
#   * nova-conductor, nova-scheduler and nova-compute DO ship units, all
#     Type=simple, User=nova, ExecStart=/etc/init.d/<name> systemd-start
#     (the Debian init wrapper). nova-compute's unit also orders itself After=
#     libvirtd.service.
#   * No postinst touches the database: no db sync, no cell_v2. All of that is
#     hagistack's job.
#   * nova-common ships /etc/nova/nova.conf as **0644 root:root** — unlike
#     neutron-common (0640 root:neutron). Since hagistack writes credentials
#     into it, the mode is tightened to 0640 root:nova here.
#   * nova-compute-kvm ships /etc/nova/nova-compute.conf with
#     compute_driver=libvirt.LibvirtDriver and [libvirt] virt_type=kvm, and
#     /etc/init.d/nova-compute passes `--config-file=/etc/nova/nova-compute.conf`
#     in addition to the default nova.conf. That is the file to edit for the
#     virtualisation type.
#   * `nova-manage` categories in the shipped code: api_db, cell_v2, db,
#     placement, libvirt, volume_attachment, image_property, limits.
#     cell_v2 offers map_cell0, create_cell, discover_hosts, list_cells, ...
#     `_map_cell0` with no --database_connection derives the cell0 URL from
#     [database] connection by appending `_cell0` to the database name, so the
#     flag is omitted and no password is ever passed on a command line.
#   * `[api] auth_strategy` does NOT exist in nova 33 (checked in
#     nova/conf/api.py); it is not invented here. `[glance] api_servers` is
#     deprecated since 21.0.0, so the image service is reached through the
#     catalogue with `valid_interfaces` instead.
#   * `[neutron] metadata_proxy_shared_secret` is absent from the shipped
#     sample (oslo hides secret options) but IS defined in
#     nova/conf/neutron.py, which is what this uses.
# ---------------------------------------------------------------------------
NOVA_CONF="/etc/nova/nova.conf"
NOVA_COMPUTE_CONF="/etc/nova/nova-compute.conf"
NOVA_API_PORT=8774
NOVA_METADATA_PORT=8775
NOVA_UNITS="nova-conductor nova-scheduler"
NOVA_COMPUTE_UNITS="nova-compute"

nova_api_serving() {
    _probe curl -s -o /dev/null -m 10 "http://${MGMT_IP}:${NOVA_API_PORT}/" 2>/dev/null
}

# nova-manage as the nova user. Credentials come from nova.conf, never argv.
nova_manage() { $SUDO runuser -u nova -- nova-manage "$@"; }

# A keystoneauth adapter block (placement, neutron, service_user all use the
# same shape). Values are written key-by-key so a re-run rewrites nothing.
#
# The identity host is a parameter rather than MGMT_IP, because the same block
# is written on a compute node, where identity lives on the CONTROLLER. Getting
# that wrong points a compute node at itself and fails at first boot, not at
# configuration time.
write_service_auth_at() {  # <conf> <section> <user> <pass> <interfaces> <identity-host>
    local conf="$1" sec="$2" user="$3" pass="$4" ifaces="${5:-}" host="$6"
    ini_set "$conf" "$sec" auth_url            "http://${host}:5000/v3" >/dev/null || true
    ini_set "$conf" "$sec" auth_type           password                    >/dev/null || true
    ini_set "$conf" "$sec" project_domain_name Default                     >/dev/null || true
    ini_set "$conf" "$sec" user_domain_name    Default                     >/dev/null || true
    ini_set "$conf" "$sec" project_name        service                     >/dev/null || true
    ini_set "$conf" "$sec" region_name         "$REGION_NAME"              >/dev/null || true
    ini_set "$conf" "$sec" username            "$user"                     >/dev/null || true
    ini_set "$conf" "$sec" password            "$pass"                     >/dev/null || true
    [ -n "$ifaces" ] && ini_set "$conf" "$sec" valid_interfaces "$ifaces"  >/dev/null || true
    return 0
}

# Controller-side shorthand: identity is this machine.
write_service_auth() {  # <conf> <section> <user> <pass> [interfaces]
    write_service_auth_at "$1" "$2" "$3" "$4" "${5:-}" "$MGMT_IP"
}

# Is a cell with this name already mapped? `list_cells` prints the database and
# transport URLs, passwords included, so its output is matched but never shown.
nova_cell_exists() {  # nova_cell_exists <name>
    local out
    out="$(nova_manage cell_v2 list_cells 2>/dev/null)" || return 1
    grep -qE "[| ]$1[ |]" <<<"$out"
}

phase_nova() {
    log_step "compute API and control services (Nova)"

    local pkgs="nova-api nova-api-metadata nova-conductor nova-scheduler"
    if dpkg-query -W -f='${Status}' nova-conductor 2>/dev/null | grep -q "install ok installed"; then
        log_ok "nova control services already installed"
    else
        log_info "installing:$pkgs (nova-api provides the :$NOVA_API_PORT vhost)"
        # shellcheck disable=SC2086
        $SUDO env DEBIAN_FRONTEND=noninteractive apt-get install -y -qq $pkgs
        log_ok "nova control services installed"
    fi
    log_info "nova $(dpkg-query -W -f='${Version}' nova-common 2>/dev/null || echo '?'): \
API via apache2 on :${NOVA_API_PORT}, metadata on :${NOVA_METADATA_PORT} (no nova-api unit), plus $NOVA_UNITS"

    # --- dependencies -------------------------------------------------------
    if ! mariadb_reachable; then
        note_skip nova "MariaDB is not reachable; the compute databases cannot be created."
        return 0
    fi
    local d
    for d in nova nova_api nova_cell0; do
        if ! mysql_root -e "USE \`$d\`" >/dev/null 2>&1; then
            note_skip nova "the '$d' database does not exist; the database phase did not complete."
            return 0
        fi
    done
    if ! keystone_ready_for_registration; then
        note_skip nova "Keystone is not answering, so compute cannot be registered."
        return 0
    fi
    if ! memcached_reachable; then
        note_skip nova "memcached is not listening on ${MGMT_IP}:11211; see the glance phase."
        return 0
    fi
    # Placement and Neutron are runtime dependencies rather than configuration
    # ones: nova can be configured without them, but it cannot schedule or
    # network an instance. Say so rather than silently producing a cloud that
    # cannot boot anything.
    phase_done placement || log_warn "the placement phase has not completed; nova cannot schedule until it does"
    phase_done neutron   || log_warn "the neutron phase has not completed; instances will have no network"
    rabbitmq_reachable   || log_warn "RabbitMQ is not reachable; conductor, scheduler and compute cannot talk"

    # --- nova.conf -----------------------------------------------------------
    local changed=0
    ini_set "$NOVA_CONF" DEFAULT my_ip "$MGMT_IP"                            && changed=1
    ini_set "$NOVA_CONF" DEFAULT transport_url \
        "rabbit://openstack:${RABBIT_PASS}@${MGMT_IP}:5672/"                 && changed=1
    ini_set "$NOVA_CONF" api_database connection \
        "mysql+pymysql://nova:${NOVA_DB_PASS}@127.0.0.1/nova_api?charset=utf8mb4" && changed=1
    ini_set "$NOVA_CONF" database connection \
        "mysql+pymysql://nova:${NOVA_DB_PASS}@127.0.0.1/nova?charset=utf8mb4"     && changed=1
    write_db_pool "$NOVA_CONF"
    write_db_pool "$NOVA_CONF" api_database
    write_authtoken "$NOVA_CONF" nova "$NOVA_SERVICE_PASS"
    # nova's own service token, used when it calls glance/neutron/placement
    write_service_auth "$NOVA_CONF" service_user nova "$NOVA_SERVICE_PASS"
    ini_set "$NOVA_CONF" service_user send_service_user_token true           && changed=1
    write_service_auth "$NOVA_CONF" placement placement "$PLACEMENT_SERVICE_PASS" internal
    write_service_auth "$NOVA_CONF" neutron   neutron   "$NEUTRON_SERVICE_PASS"   internal
    # api_servers is deprecated since 21.0.0; reach glance through the catalogue
    ini_set "$NOVA_CONF" glance valid_interfaces internal                    && changed=1
    # the OVN metadata agent proxies instance metadata to nova with this secret
    ini_set "$NOVA_CONF" neutron service_metadata_proxy true                 && changed=1
    ini_set "$NOVA_CONF" neutron metadata_proxy_shared_secret \
        "$METADATA_PROXY_SECRET"                                             && changed=1
    ini_set "$NOVA_CONF" vnc enabled true                                    && changed=1
    ini_set "$NOVA_CONF" vnc server_listen "$MGMT_IP"                        && changed=1
    ini_set "$NOVA_CONF" vnc server_proxyclient_address "$MGMT_IP"           && changed=1
    ini_set "$NOVA_CONF" oslo_concurrency lock_path /var/lib/nova/tmp        && changed=1
    # A compute node that joins later still has to be mapped into a cell. Doing
    # it on a timer means `compute-add` does not depend on someone remembering
    # to run `discover-hosts` by hand — that command stays, because waiting five
    # minutes to find out whether a node joined is not a diagnosis.
    ini_set "$NOVA_CONF" scheduler discover_hosts_in_cells_interval 300       && changed=1
    if [ "$changed" -eq 1 ]; then
        log_ok "nova.conf configured (credentials not shown)"
    else
        log_ok "nova.conf already correct (unchanged)"
    fi
    # The package ships this 0644 root:root and it now holds credentials.
    $SUDO chown root:nova "$NOVA_CONF" 2>/dev/null || true
    $SUDO chmod 0640 "$NOVA_CONF"
    $SUDO install -d -o nova -g nova -m 0750 /var/lib/nova/tmp 2>/dev/null || true

    # --- schema, then cells v2 ------------------------------------------------
    local before after
    before="$(mysql_root -N -B -e \
        "SELECT COUNT(*) FROM information_schema.tables WHERE table_schema='nova'" 2>/dev/null || echo 0)"
    local nerr; nerr="$(mktemp)"; chmod 0600 "$nerr"
    _nova_manage_or_skip() {   # _nova_manage_or_skip <what> <args...>
        local what="$1"; shift
        if nova_manage "$@" >"$nerr" 2>&1; then return 0; fi
        log_error "nova-manage $what failed. Diagnostics (credentials redacted):"
        $SUDO sed "s/${NOVA_DB_PASS}/<redacted>/g; s/${NOVA_SERVICE_PASS}/<redacted>/g; s/${RABBIT_PASS}/<redacted>/g" "$nerr" \
          | grep -viE 'password|secret' | tail -12 | sed 's/^/     /' >&2
        return 1
    }
    log_info "running nova-manage api_db sync (idempotent migration)"
    if ! _nova_manage_or_skip "api_db sync" api_db sync; then
        rm -f "$nerr"; note_skip nova "the nova_api schema could not be created."; return 0
    fi
    # cell0 first: nova derives its URL from [database] connection + _cell0, so
    # no password is passed on the command line. Re-running prints
    # "Cell0 is already setup" and exits 0.
    log_info "mapping cell0 (URL derived from [database] connection, not passed on the command line)"
    if ! _nova_manage_or_skip "cell_v2 map_cell0" cell_v2 map_cell0; then
        rm -f "$nerr"; note_skip nova "cell0 could not be mapped."; return 0
    fi
    log_info "running nova-manage db sync (idempotent migration)"
    if ! _nova_manage_or_skip "db sync" db sync; then
        rm -f "$nerr"; note_skip nova "the nova schema could not be created."; return 0
    fi
    after="$(mysql_root -N -B -e \
        "SELECT COUNT(*) FROM information_schema.tables WHERE table_schema='nova'" 2>/dev/null || echo 0)"
    if [ "$before" = "0" ]; then log_ok "compute schema created ($after tables)"
    elif [ "$before" = "$after" ]; then log_ok "compute schema already current ($after tables, unchanged)"
    else log_ok "compute schema migrated ($before -> $after tables)"; fi

    # cell1 is created only when it is absent: create_cell would otherwise add a
    # second mapping, and an existing cell is never deleted or rewritten.
    local cell_created=0
    if nova_cell_exists cell1; then
        log_ok "cell 'cell1' already mapped — left untouched"
    else
        cell_created=1
        if ! _nova_manage_or_skip "cell_v2 create_cell" cell_v2 create_cell --name cell1; then
            rm -f "$nerr"; note_skip nova "cell1 could not be created."; return 0
        fi
        log_ok "cell 'cell1' created (database and transport taken from nova.conf)"
    fi
    rm -f "$nerr"

    # --- identity registration -------------------------------------------------
    ks_ensure_project service
    ks_ensure_user nova "$NOVA_SERVICE_PASS"
    ks_ensure_role_assignment nova service admin
    ks_ensure_service nova compute "OpenStack Compute"
    local url="http://${MGMT_IP}:${NOVA_API_PORT}/v2.1"
    ks_ensure_endpoint nova public   "$url"
    ks_ensure_endpoint nova internal "$url"
    ks_ensure_endpoint nova admin    "$url"

    # --- run it ------------------------------------------------------------------
    $SUDO a2ensite nova-api >/dev/null 2>&1 || true
    $SUDO a2ensite nova-api-metadata >/dev/null 2>&1 || true
    if [ "$HAS_SYSTEMD" -eq 1 ]; then
        if service_active apache2; then
            $SUDO systemctl reload-or-restart apache2 \
                || die "apache2 failed to reload after the nova configuration change"
            log_ok "apache2 reloaded (identity :5000, placement :8778, networking :9696, compute :${NOVA_API_PORT}, metadata :${NOVA_METADATA_PORT})"
        else
            service_start_enable apache2
        fi
        local u
        for u in $NOVA_UNITS; do service_apply "$u" "$NOVA_CONF"; done
        # nova-scheduler reads the list of cells ONCE, at startup, and caches it.
        # Creating a cell is not a change to any file, so service_apply above has
        # nothing to notice and leaves the process running with the cell list it
        # had. Measured on a GCE host: the scheduler started at 21:21:31 and
        # cell1 was created at 21:21:44 — thirteen seconds later — after which
        # every boot failed with
        #   WARNING nova.scheduler.host_manager ... No cells were found
        #   INFO nova.filters ... Filter ComputeFilter returned 0 hosts
        #   NoValidHost: There are not enough hosts available.
        # on a cloud where the hypervisor was up, registered, and reporting a
        # full inventory to Placement. So the restart is driven by the cell
        # having changed, not by a file mtime.
        if [ "$cell_created" -eq 1 ]; then
            log_info "a cell mapping was created in this run; restarting the scheduler so it sees it"
            for u in $NOVA_UNITS; do
                $SUDO systemctl restart "$u" || die "$u failed to restart after a cell was created"
            done
            log_ok "scheduler and conductor restarted with the new cell list"
        fi
    else
        log_warn "systemd is not running here; the nova units cannot be started"
        for u in $NOVA_UNITS; do SERVICE_START_METHOD[$u]="not-started-no-systemd"; done
    fi

    if ! service_active apache2; then
        note_skip nova "apache2 is not running, so the compute API is not being served.
     The schema, cells, configuration and identity registration ARE in place.
     Startup under systemd is a GCE acceptance item (B0a/B0b)."
        return 0
    fi
    if ! wait_for 60 "the compute API" nova_api_serving; then
        note_skip nova "apache2 is active but http://${MGMT_IP}:${NOVA_API_PORT}/ did not answer."
        return 0
    fi
    if ! wait_for 90 "an authenticated compute service list" openstack_admin compute service list >/dev/null 2>&1; then
        note_skip nova "the compute endpoint answers but 'openstack compute service list' failed.
     conductor and scheduler need RabbitMQ and the cell databases to be reachable."
        return 0
    fi
    log_ok "compute API verified (openstack compute service list succeeded)"
    log_warn "no hypervisor is registered yet and no instance has been booted."
    phase_mark_done nova
}

phase_nova_compute() {
    log_step "hypervisor (nova-compute)"

    # The dependency is checked BEFORE installing: nova-compute pulls
    # libvirt-daemon-system and qemu-system, several hundred megabytes that are
    # useless on a host where the nova control plane is not up yet.
    if ! phase_done nova; then
        note_skip nova_compute "the nova phase did not complete, so there is nothing for a
     hypervisor to register with. Neither libvirt/qemu nor nova-compute was installed."
        return 0
    fi

    local pkgs="nova-compute nova-compute-kvm"
    if dpkg-query -W -f='${Status}' nova-compute 2>/dev/null | grep -q "install ok installed"; then
        log_ok "nova-compute already installed"
    else
        log_info "installing:$pkgs (pulls libvirt-daemon-system and qemu-system)"
        # shellcheck disable=SC2086
        $SUDO env DEBIAN_FRONTEND=noninteractive apt-get install -y -qq $pkgs
        log_ok "nova-compute installed"
    fi

    # --- virtualisation type ---------------------------------------------------
    # VIRT_TYPE was resolved in preflight from /dev/kvm (or given explicitly).
    # It goes into nova-compute.conf, which is the file the packaged init script
    # passes with --config-file in addition to nova.conf.
    local changed=0
    # os_vif plugs the instance's tap device into Open vSwitch, and it looks for
    # the LOCAL ovsdb at its own default, tcp:127.0.0.1:6640. Ubuntu's
    # openvswitch-switch does not listen on TCP at all — only on the unix socket
    # — so every guest build died in os_vif with
    #   Exception: Could not retrieve schema from tcp:127.0.0.1:6640
    # and Nova reported "Exhausted all hosts available for retrying build
    # failures". Measured on a GCE host; a container never gets this far.
    # Pointing os_vif at the socket is better than opening a TCP listener: it
    # adds no reachable port.
    ini_set "$NOVA_CONF" os_vif_ovs ovsdb_connection "$OVS_DB_TCP"            && changed=1
    ini_set "$NOVA_COMPUTE_CONF" DEFAULT compute_driver libvirt.LibvirtDriver && changed=1
    ini_set "$NOVA_COMPUTE_CONF" libvirt virt_type "$VIRT_TYPE"               && changed=1
    if [ "$VIRT_TYPE" = "qemu" ]; then
        # Without hardware virtualisation the generic CPU model is the only one
        # that reliably works; say plainly what this costs.
        ini_set "$NOVA_COMPUTE_CONF" libvirt cpu_mode none                    && changed=1
        log_warn "virt_type=qemu: /dev/kvm is not usable here, so guests run under"
        log_warn "  software emulation (10-50x slower). Usable for a boot smoke test only."
    else
        log_ok "virt_type=kvm (/dev/kvm usable)"
    fi
    [ "$changed" -eq 1 ] && log_ok "nova-compute.conf configured" \
                         || log_ok "nova-compute.conf already correct (unchanged)"
    $SUDO chown root:nova "$NOVA_COMPUTE_CONF" 2>/dev/null || true
    $SUDO chmod 0640 "$NOVA_COMPUTE_CONF"

    # --- run it -----------------------------------------------------------------
    if [ "$HAS_SYSTEMD" -eq 1 ]; then
        service_start_enable libvirtd
        local u
        for u in $NOVA_COMPUTE_UNITS; do
            service_apply "$u" "$NOVA_CONF" "$NOVA_COMPUTE_CONF"
        done
    else
        log_warn "systemd is not running here; libvirtd and nova-compute cannot be started"
        log_warn "  -> a hypervisor cannot be registered, and no guest can be booted"
        for u in $NOVA_COMPUTE_UNITS; do SERVICE_START_METHOD[$u]="not-started-no-systemd"; done
        note_skip nova_compute "nova-compute was configured but not started (no systemd).
     Hypervisor registration, cell host discovery and guest boot are GCE items."
        return 0
    fi

    # --- has the hypervisor actually registered? ---------------------------------
    local i=0 reg_hosts=""
    while [ "$i" -lt 12 ]; do
        reg_hosts="$(openstack_admin compute service list --service nova-compute -f value -c Host 2>/dev/null || true)"
        [ -n "$(tr -d '[:space:]' <<<"$reg_hosts")" ] && break
        i=$((i+1)); sleep 5
    done
    if [ -z "$(tr -d '[:space:]' <<<"$reg_hosts")" ]; then
        note_skip nova_compute "nova-compute is running but did not register a compute service.
     Check RabbitMQ and the conductor; nothing was discovered, so no host was mapped."
        return 0
    fi
    log_ok "compute service registered: $(tr '\n' ' ' <<<"$reg_hosts")"

    # Map the new host into cell1. discover_hosts is idempotent: hosts already
    # mapped are reported as such and nothing is recreated.
    if nova_manage cell_v2 discover_hosts --by-service >/dev/null 2>&1; then
        log_ok "cell host discovery ran (already-mapped hosts are left alone)"
    else
        note_skip nova_compute "'nova-manage cell_v2 discover_hosts' failed; the hypervisor is
     running but is not mapped into a cell, so the scheduler will not use it."
        return 0
    fi
    if ! openstack_admin hypervisor list >/dev/null 2>&1; then
        note_skip nova_compute "the hypervisor list could not be read back after discovery."
        return 0
    fi
    log_ok "hypervisor visible to the compute API"
    log_warn "a registered hypervisor is not a booted guest: no instance has been started,"
    log_warn "  and guest boot stays unverified until the GCE acceptance."
    phase_mark_done nova_compute
}

# ---------------------------------------------------------------------------
# Horizon (dashboard)
#
# Packaging verified on Ubuntu 26.04 (openstack-dashboard 4:25.7.1-0ubuntu1) by
# unpacking the .deb files — see STEP6_HORIZON_RESOURCES_EVIDENCE.md:
#
#   * `openstack-dashboard` ships exactly ONE file:
#     /etc/apache2/conf-available/openstack-dashboard.conf. Note "conf-", not
#     "sites-": it is a SERVER-WIDE fragment, not a vhost, and its postinst runs
#     `apache2_invoke enconf`. It carries no `Listen`, so the dashboard is served
#     by whatever vhost already exists — in practice the packaged default site on
#     port 80 — at the path /horizon, via WSGIDaemonProcess user=horizon.
#     Being server-wide, that alias is inherited by the API vhosts too; hagistack
#     does not fight the packaging over it, it just says so.
#   * The settings file is /etc/openstack-dashboard/local_settings.py, a dpkg
#     CONFFILE from `openstack-dashboard-common`, symlinked into the package as
#     .../openstack_dashboard/local/local_settings.py.
#   * openstack_dashboard/settings.py `exec`s every *.py in
#     .../openstack_dashboard/local/local_settings.d/ AFTER importing
#     local_settings.py, so a snippet there overrides the conffile and dpkg never
#     prompts. hagistack writes exactly one snippet, _99_hagistack.py.
#   * That loader swallows exceptions (`except Exception: _LOG.exception(...)`).
#     A broken snippet is therefore SILENT — the dashboard just keeps the wrong
#     settings. So the snippet is not trusted after being written: the effective
#     settings are read back out of Django and compared.
#   * The shipped defaults point at 127.0.0.1: OPENSTACK_KEYSTONE_URL is
#     "http://127.0.0.1/identity/v3" (a DevStack path) and the cache LOCATION is
#     127.0.0.1:11211. Both are wrong here — hagistack binds memcached to the
#     management address — so both are overridden.
#   * python3-pymemcache is NOT a dependency of python3-django-horizon; it comes
#     in through python3-django-openstack-auth. `apt-get install -s
#     openstack-dashboard` was checked and does pull it, so it is not installed
#     separately.
#   * The postinst runs `collectstatic` + `compress --force` and also
#     `invoke-rc.d memcached restart`, i.e. installing the dashboard bounces the
#     token cache the other services use.
# ---------------------------------------------------------------------------
HORIZON_LOCAL_SETTINGS="/etc/openstack-dashboard/local_settings.py"
HORIZON_SNIPPET_DIR="/usr/lib/python3/dist-packages/openstack_dashboard/local/local_settings.d"
HORIZON_SNIPPET="$HORIZON_SNIPPET_DIR/_99_hagistack.py"
HORIZON_MANAGE="/usr/share/openstack-dashboard/manage.py"
HORIZON_STATIC="/var/lib/openstack-dashboard/static"
HORIZON_SECRET_KEY_FILE="/var/lib/openstack-dashboard/secret_key"
HORIZON_PATH="/horizon"

# The login page, by HTTP status. 200 means Apache, mod_wsgi, Django, the
# settings and the static assets all loaded — it does NOT mean a login works.
horizon_login_page_code() {
    _probe curl -s -o /dev/null -m 20 -w '%{http_code}' \
        "http://${MGMT_IP}${HORIZON_PATH}/auth/login/" 2>/dev/null
}

# Read the settings Django actually ended up with. This is the check that the
# silently-swallowed snippet loader makes necessary.
horizon_effective_settings() {
    $SUDO python3 - <<'PYEOF' 2>/dev/null
import os, sys
sys.path.insert(0, "/usr/share/openstack-dashboard")
os.environ.setdefault("DJANGO_SETTINGS_MODULE", "openstack_dashboard.settings")
try:
    from django.conf import settings
    print("KEYSTONE_URL=%s" % settings.OPENSTACK_KEYSTONE_URL)
    print("CACHE_LOCATION=%s" % settings.CACHES["default"]["LOCATION"])
    print("SESSION_ENGINE=%s" % settings.SESSION_ENGINE)
except Exception as exc:                      # noqa: BLE001 - reported, not raised
    print("ERROR=%s: %s" % (type(exc).__name__, exc))
    raise SystemExit(1)
PYEOF
}

# Rebuild the dashboard's static assets and its OFFLINE compression manifest.
#
# The packaged settings set COMPRESS_OFFLINE = True, and the package's postinst
# generated that manifest BEFORE hagistack's settings snippet existed. Any
# settings change that reaches a template invalidates it, and Horizon then
# answers every request with HTTP 500 and
#   OfflineGenerationError: You have offline compression enabled but key
#   ... is missing from offline manifest
# — measured on a GCE host. A full $HORIZON_STATIC is therefore no evidence of
# anything: it can be full of assets built for someone else's settings.
horizon_build_assets() {
    log_info "regenerating static assets (collectstatic + compress --force; takes a few minutes)"
    local aerr; aerr="$(mktemp)"; chmod 0600 "$aerr"
    if ! $SUDO python3 "$HORIZON_MANAGE" collectstatic --noinput >"$aerr" 2>&1; then
        log_error "collectstatic failed:"; tail -8 "$aerr" | sed 's/^/     /' >&2
        rm -f "$aerr"; return 1
    fi
    if ! $SUDO python3 "$HORIZON_MANAGE" compress --force >"$aerr" 2>&1; then
        log_error "compress --force failed:"; tail -8 "$aerr" | sed 's/^/     /' >&2
        rm -f "$aerr"; return 1
    fi
    rm -f "$aerr"
    # Match what the package's postinst does, so apache — running as the horizon
    # user — can still read what root just wrote.
    $SUDO find "$HORIZON_STATIC" -type f -exec chmod 0644 {} + 2>/dev/null || true
    $SUDO find "$HORIZON_STATIC" -type d -exec chmod 0755 {} + 2>/dev/null || true
    $SUDO chown -R horizon:horizon "$HORIZON_STATIC" 2>/dev/null || true
    $SUDO chmod 0755 /var/lib/openstack-dashboard 2>/dev/null || true
    log_ok "static assets and offline manifest regenerated"
    return 0
}

phase_horizon() {
    log_step "dashboard (Horizon)"

    # --- dependencies first: installing pulls in a collectstatic run that
    #     imports the settings, so the things those settings point at should
    #     already be up.
    if ! keystone_ready_for_registration; then
        note_skip horizon "Keystone is not answering, so a dashboard would have nothing
     to authenticate against. Nothing was installed or changed."
        return 0
    fi
    if ! memcached_reachable; then
        note_skip horizon "memcached is not listening on ${MGMT_IP}:11211. Horizon keeps its
     SESSIONS in that cache (SESSION_ENGINE = ...backends.cache), so a dashboard
     configured against a dead cache cannot log anyone in. Nothing was changed."
        return 0
    fi

    if dpkg-query -W -f='${Status}' openstack-dashboard 2>/dev/null | grep -q "install ok installed"; then
        log_ok "openstack-dashboard already installed"
    else
        log_info "installing openstack-dashboard (pulls python3-django-horizon, apache2, mod_wsgi, python3-pymemcache)"
        log_warn "the dashboard's postinst runs 'invoke-rc.d memcached restart' — the token"
        log_warn "  cache the other services use is bounced during this install."
        $SUDO env DEBIAN_FRONTEND=noninteractive apt-get install -y -qq openstack-dashboard
        log_ok "openstack-dashboard installed"
    fi
    log_info "horizon $(dpkg-query -W -f='${Version}' openstack-dashboard 2>/dev/null || echo '?') \
served by apache2 + mod_wsgi at ${HORIZON_PATH} (a conf-available fragment, not a vhost)"

    # The cache restart above can leave memcached down for a moment.
    if ! memcached_reachable; then
        note_skip horizon "memcached did not come back after the dashboard's postinst restarted it.
     Start it and re-run; nothing further was changed."
        return 0
    fi

    # --- settings snippet ---------------------------------------------------
    if ! $SUDO test -d "$HORIZON_SNIPPET_DIR"; then
        note_skip horizon "$HORIZON_SNIPPET_DIR does not exist, so there is nowhere to put the
     settings without editing the dpkg conffile. The dashboard packaging has
     changed; do not guess a new location — re-measure it before editing this
     shell. Nothing was changed."
        return 0
    fi
    local tmp; tmp="$(mktemp)"; chmod 0644 "$tmp"
    cat > "$tmp" <<SNIPEOF
# hagistack — generated, do not edit. Re-run 'hagistack all-in-one' instead.
#
# openstack_dashboard/settings.py execs this AFTER importing
# /etc/openstack-dashboard/local_settings.py, so these win without touching a
# dpkg conffile. Errors here are swallowed by that loader, which is why
# hagistack reads the effective settings back instead of trusting this file.
OPENSTACK_HOST = "${MGMT_IP}"
OPENSTACK_KEYSTONE_URL = "http://${MGMT_IP}:5000/v3"
OPENSTACK_API_VERSIONS = {"identity": 3, "image": 2}
OPENSTACK_KEYSTONE_MULTIDOMAIN_SUPPORT = False
OPENSTACK_KEYSTONE_DEFAULT_DOMAIN = "Default"

# The package ships 127.0.0.1:11211; hagistack binds memcached to the management
# address only, so the packaged value would leave every session unstorable.
CACHES = {
    "default": {
        "BACKEND": "django.core.cache.backends.memcached.PyMemcacheCache",
        "LOCATION": "${MGMT_IP}:11211",
    },
}
SESSION_ENGINE = "django.contrib.sessions.backends.cache"

# ALLOWED_HOSTS is deliberately NOT set here. The package already ships ['*'],
# and narrowing it would break reaching the dashboard through an address this
# host does not know about (a cloud external IP, an SSH tunnel). Narrow it
# yourself in /etc/openstack-dashboard/local_settings.py if that suits you.
SNIPEOF
    local snippet_changed=0
    if $SUDO cmp -s "$tmp" "$HORIZON_SNIPPET" 2>/dev/null; then
        log_ok "dashboard settings snippet already current (unchanged)"
        rm -f "$tmp"
    else
        $SUDO cp "$tmp" "$HORIZON_SNIPPET"
        rm -f "$tmp"
        $SUDO chmod 0644 "$HORIZON_SNIPPET"
        snippet_changed=1
        log_ok "dashboard settings written to $HORIZON_SNIPPET (the conffile is left alone)"
    fi

    # --- did the snippet actually take effect? -------------------------------
    local eff
    if ! eff="$(horizon_effective_settings)"; then
        log_error "Django could not load the dashboard settings:"
        printf '     %s\n' "$eff" >&2
        note_skip horizon "the effective dashboard settings could not be read.
     The snippet loader swallows exceptions, so a dashboard left in this state
     would silently serve the packaged 127.0.0.1 defaults."
        return 0
    fi
    local want_url="KEYSTONE_URL=http://${MGMT_IP}:5000/v3"
    local want_cache="CACHE_LOCATION=${MGMT_IP}:11211"
    if ! grep -qx "$want_url" <<<"$eff" || ! grep -qx "$want_cache" <<<"$eff"; then
        log_error "effective dashboard settings do not match what was written:"
        printf '     %s\n' "$eff" >&2
        note_skip horizon "the settings snippet was written but did not take effect."
        return 0
    fi
    log_ok "effective settings confirmed from Django: keystone ${MGMT_IP}:5000/v3, cache ${MGMT_IP}:11211"

    # --- static assets --------------------------------------------------------
    # Built here when this run changed the settings or the output is missing.
    # That is NOT sufficient on its own — a manifest can be stale from a run
    # that predates this code — so the outcome is checked below and rebuilt
    # once more if the dashboard does not actually serve.
    local need_assets=0
    [ "$snippet_changed" -eq 1 ] && need_assets=1
    $SUDO test -d "$HORIZON_STATIC" || need_assets=1
    [ -n "$($SUDO find "$HORIZON_STATIC" -type f -print -quit 2>/dev/null || true)" ] || need_assets=1
    if [ "$need_assets" -eq 0 ]; then
        log_ok "static assets present (whether they match these settings is checked below)"
    elif ! horizon_build_assets; then
        note_skip horizon "the static assets could not be built; with COMPRESS_OFFLINE on,
     every page would answer 500. Nothing is served in that state."
        return 0
    fi

    # The secret key protects every session cookie.
    if $SUDO test -f "$HORIZON_SECRET_KEY_FILE"; then
        local kperm; kperm="$($SUDO stat -c '%a' "$HORIZON_SECRET_KEY_FILE" 2>/dev/null || echo '?')"
        [ "$kperm" = "600" ] || log_warn "$HORIZON_SECRET_KEY_FILE has mode $kperm, expected 600"
    fi

    # --- serve it --------------------------------------------------------------
    $SUDO a2enconf openstack-dashboard >/dev/null 2>&1 || true
    if [ "$HAS_SYSTEMD" -eq 1 ] && service_active apache2; then
        $SUDO systemctl reload-or-restart apache2 \
            || die "apache2 failed to reload after the dashboard configuration change"
        log_ok "apache2 reloaded"
    else
        service_start_enable apache2
    fi
    if ! service_active apache2; then
        note_skip horizon "apache2 is not running, so the dashboard is not being served.
     Its configuration IS in place. Startup under systemd is a GCE item."
        return 0
    fi

    _horizon_200() { [ "$(horizon_login_page_code || true)" = "200" ]; }
    local code
    if ! wait_for 60 "the dashboard login page" _horizon_200; then
        code="$(horizon_login_page_code || true)"
        # One bounded recovery attempt. A stale offline manifest is by far the
        # most common cause of a 500 here, and it can be left behind by a run
        # that changed the settings without rebuilding — so "the settings did
        # not change this time" is not a reason to leave it broken.
        log_warn "the dashboard answered '$code'; rebuilding the offline assets once and retrying"
        if ! horizon_build_assets; then
            note_skip horizon "http://${MGMT_IP}${HORIZON_PATH}/auth/login/ answered '$code' and the
     assets could not be rebuilt."
            return 0
        fi
        if [ "$HAS_SYSTEMD" -eq 1 ] && service_active apache2; then
            $SUDO systemctl reload-or-restart apache2 || true
        fi
        if ! wait_for 90 "the dashboard login page" _horizon_200; then
            code="$(horizon_login_page_code || true)"
            note_skip horizon "http://${MGMT_IP}${HORIZON_PATH}/auth/login/ still answered '$code'
     after rebuilding the assets. A 500 is an application error — read
     /var/log/apache2/error.log; a 404 means the packaged conf-available
     fragment is not enabled on the port-80 vhost."
            return 0
        fi
    fi
    log_ok "dashboard login page served (HTTP 200) at http://${MGMT_IP}${HORIZON_PATH}/"
    log_warn "a login PAGE is not a login. Signing in as admin has never been tested"
    log_warn "  and stays a GCE acceptance item."
    phase_mark_done horizon
}

# ---------------------------------------------------------------------------
# initial resources
#
# The smallest set an instance needs: a flavor, a bootable image, a tenant
# network to attach to, a provider network and router so it can get out, one
# ICMP and one SSH rule, and a keypair.
#
# Every one of them is show-or-create by name. Nothing here deletes anything,
# and nothing is recreated: a second run finds everything and changes nothing.
#
# Names carry a hagistack- prefix so that they cannot be confused with, or
# collide with, resources an operator made. In particular the throwaway image
# the step 3 suite uploaded is NOT an initial image and is never treated as one:
# the image below is matched by name AND by a hagistack_sha256 property that
# only an image this shell uploaded, from a digest-verified file, ever carries.
# ---------------------------------------------------------------------------
BS_FLAVOR="m1.tiny"
BS_PROVIDER_NET="hagistack-provider"
BS_PROVIDER_SUBNET="hagistack-provider-subnet"
BS_TENANT_NET="hagistack-tenant"
BS_TENANT_SUBNET="hagistack-tenant-subnet"
BS_ROUTER="hagistack-router"
BS_KEYPAIR="hagistack-key"
IMAGE_CACHE_DIR="$HAGISTACK_STATE/images"
KEYPAIR_PRIVATE="$HAGISTACK_ETC/${BS_KEYPAIR}"
KEYPAIR_PUBLIC="$HAGISTACK_ETC/${BS_KEYPAIR}.pub"

# One field out of `openstack ... -f json`, via python3 (always present on
# Ubuntu) so that jq is not a dependency. Custom image properties live either at
# the top level or under "properties", depending on the client version.
os_json_field() {   # os_json_field <key> < json
    python3 -c '
import json, sys
key = sys.argv[1]
try:
    doc = json.load(sys.stdin)
except Exception:
    raise SystemExit(1)
val = doc.get(key)
if val is None and isinstance(doc.get("properties"), dict):
    val = doc["properties"].get(key)
print("" if val is None else val)
' "$1"
}

# Does <router> already have a port on <subnet-id>?
#
# Asked as a question about STATE, because the error Neutron returns when the
# interface is already there does not say so. Measured on a GCE host, re-running
# `router add subnet` on an attached subnet gives:
#   BadRequestException: 400 ... Bad router request: Cidr 10.10.10.0/24 of
#   subnet 6c6758c5-... overlaps with cidr 10.10.10.0/24 of subnet 6c6758c5-...
# — the subnet reported as overlapping with itself. Matching on "already exists"
# or 409 never fires for it, so a perfectly good deployment was reported as a
# failed phase on its second run.
router_has_subnet() {   # router_has_subnet <router> <subnet-id>
    openstack_admin port list --router "$1" -f json 2>/dev/null | python3 -c '
import json, sys
want = sys.argv[1]
try:
    ports = json.load(sys.stdin)
except Exception:
    raise SystemExit(1)
for port in ports:
    fixed = port.get("Fixed IP Addresses") or port.get("fixed_ips") or []
    if isinstance(fixed, dict):
        fixed = [fixed]
    for entry in fixed:
        if isinstance(entry, dict) and entry.get("subnet_id") == want:
            raise SystemExit(0)
        if isinstance(entry, str) and want in entry:
            raise SystemExit(0)
raise SystemExit(1)
' "$2"
}

image_field() {     # image_field <image-name> <key>
    openstack_admin image show "$1" -f json 2>/dev/null | os_json_field "$2"
}

# Create a security group rule, treating "it is already there" as success.
# Neutron answers a duplicate with 409 Conflict rather than silently accepting
# it, which is exactly the idempotence signal wanted here.
bs_secgroup_rule() {   # bs_secgroup_rule <label> <args...>
    local label="$1"; shift
    local out rc
    out="$(openstack_admin security group rule create "$@" 2>&1)"; rc=$?
    if [ "$rc" -eq 0 ]; then
        log_ok "security group rule '$label' created"
    elif grep -qiE 'already exist|conflict|409' <<<"$out"; then
        log_ok "security group rule '$label' already present — left unchanged"
    else
        log_error "could not create the security group rule '$label':"
        printf '     %s\n' "$(head -3 <<<"$out")" >&2
        return 1
    fi
    return 0
}

# Fetch the image once into $IMAGE_CACHE_DIR and verify it against the pinned
# digest BEFORE it is ever handed to Glance. A cached file that already matches
# is not downloaded again; a file that does not match is refused, not replaced.
bs_fetch_image() {   # prints the path of a verified local file on stdout
    local dest have
    if [ -n "$IMAGE_FILE" ]; then
        if [ -n "$IMAGE_SHA256" ]; then
            have="$($SUDO sha256sum "$IMAGE_FILE" | cut -d' ' -f1)"
            [ "$have" = "$IMAGE_SHA256" ] || {
                log_error "IMAGE_FILE does not match IMAGE_SHA256; refusing to upload it."
                return 1; }
        else
            # Adopt the file's own digest. Without this the uploaded image would
            # carry an EMPTY hagistack_sha256 property, and the next run would
            # read that back, decide the image was not hagistack's, and refuse
            # its own work. The file is still not checked against anything —
            # that is what supplying no digest means — and the run says so.
            IMAGE_SHA256="$($SUDO sha256sum "$IMAGE_FILE" | cut -d' ' -f1)"
            log_warn "IMAGE_FILE was given without IMAGE_SHA256, so nothing verifies its"
            log_warn "  contents. Its own digest is recorded on the image so that re-runs"
            log_warn "  recognise it: ${IMAGE_SHA256:0:16}..."
        fi
        printf '%s\n' "$IMAGE_FILE"
        return 0
    fi

    $SUDO mkdir -p "$IMAGE_CACHE_DIR"
    $SUDO chmod 0755 "$IMAGE_CACHE_DIR"
    dest="$IMAGE_CACHE_DIR/${IMAGE_URL##*/}"
    if $SUDO test -f "$dest"; then
        have="$($SUDO sha256sum "$dest" | cut -d' ' -f1)"
        if [ "$have" = "$IMAGE_SHA256" ]; then
            log_ok "cached image $dest already matches the pinned digest — not re-downloaded" >&2
            printf '%s\n' "$dest"
            return 0
        fi
        log_warn "cached $dest does not match the pinned digest; downloading again" >&2
    fi
    log_info "downloading $IMAGE_URL" >&2
    # -L is required: download.cirros-cloud.net answers 302 and without it the
    # saved file is a 273-byte redirect page (measured).
    if ! $SUDO curl -fsSL --retry 3 --retry-delay 2 -m 900 -o "$dest" "$IMAGE_URL"; then
        log_error "could not download $IMAGE_URL"
        return 1
    fi
    have="$($SUDO sha256sum "$dest" | cut -d' ' -f1)"
    if [ "$have" != "$IMAGE_SHA256" ]; then
        log_error "downloaded image digest mismatch — the file is NOT being uploaded."
        log_error "  expected $IMAGE_SHA256"
        log_error "  got      $have"
        log_error "  the file is left at $dest for inspection; delete it to retry"
        return 1
    fi
    log_ok "downloaded and verified against the pinned sha256" >&2
    printf '%s\n' "$dest"
}

phase_bootstrap_resources() {
    log_step "initial resources (flavor, image, networks, router, rules, keypair)"

    local pre
    for pre in keystone glance neutron nova; do
        if ! phase_done "$pre"; then
            note_skip bootstrap_resources "the '$pre' phase did not complete, so the resources it
     owns cannot be created. Nothing was changed."
            return 0
        fi
    done
    if ! keystone_ready_for_registration; then
        note_skip bootstrap_resources "Keystone is not answering. Nothing was changed."
        return 0
    fi

    # --- flavor ---------------------------------------------------------------
    # 1 vCPU / 512 MiB / 1 GiB. The cirros image's virtual size is 112 MiB, so it
    # fits; this is the smallest flavor that boots it.
    if openstack_admin flavor show "$BS_FLAVOR" >/dev/null 2>&1; then
        log_ok "flavor '$BS_FLAVOR' already exists — left untouched"
    else
        openstack_admin flavor create --id auto --ram 512 --disk 1 --vcpus 1 "$BS_FLAVOR" >/dev/null
        log_ok "flavor '$BS_FLAVOR' created (1 vCPU, 512MiB, 1GiB)"
    fi

    # --- image ----------------------------------------------------------------
    # `local x; x="$(cmd)"` is a plain assignment and takes cmd's exit status, so
    # under `set -e` a lookup that correctly finds nothing would abort the run —
    # and on a first run the image never exists. Hence the explicit `|| true`.
    local existing_sha existing_status
    existing_status="$(image_field "$IMAGE_NAME" status || true)"
    if [ -n "$existing_status" ]; then
        existing_sha="$(image_field "$IMAGE_NAME" hagistack_sha256 || true)"
        if [ "$existing_sha" = "$IMAGE_SHA256" ] && [ "$existing_status" = "active" ]; then
            log_ok "image '$IMAGE_NAME' already uploaded by hagistack and matches the pinned digest"
        elif [ -z "$existing_sha" ]; then
            log_warn "an image named '$IMAGE_NAME' exists but carries no hagistack_sha256 property."
            log_warn "  hagistack did not upload it, so it is NOT treated as the initial image"
            log_warn "  and is NOT modified or deleted. Give --image-name another value, or"
            log_warn "  remove that image yourself if it is the throwaway one from a test run."
            note_skip bootstrap_resources "image '$IMAGE_NAME' is present but not hagistack's."
            return 0
        else
            log_warn "image '$IMAGE_NAME' exists with digest '${existing_sha:-none}' and status"
            log_warn "  '$existing_status', which is not what is configured now. It is left alone."
            note_skip bootstrap_resources "image '$IMAGE_NAME' does not match the configured source."
            return 0
        fi
    else
        local src
        if ! src="$(bs_fetch_image)"; then
            note_skip bootstrap_resources "the initial image could not be obtained or verified.
     No instance can boot without one. Nothing else was changed."
            return 0
        fi
        log_info "uploading $src to Glance as '$IMAGE_NAME' (qcow2)"
        if ! openstack_admin image create "$IMAGE_NAME" \
                --disk-format qcow2 --container-format bare --public \
                --property "hagistack_sha256=$IMAGE_SHA256" \
                --file "$src" >/dev/null 2>&1; then
            note_skip bootstrap_resources "'openstack image create' failed for '$IMAGE_NAME'."
            return 0
        fi
        log_ok "image '$IMAGE_NAME' uploaded and tagged with its source digest"
    fi

    # --- provider (external) network -------------------------------------------
    if openstack_admin network show "$BS_PROVIDER_NET" >/dev/null 2>&1; then
        log_ok "network '$BS_PROVIDER_NET' already exists — left untouched"
    else
        openstack_admin network create --external --share \
            --provider-network-type flat \
            --provider-physical-network "$PROVIDER_PHYSNET" "$BS_PROVIDER_NET" >/dev/null
        log_ok "external network '$BS_PROVIDER_NET' created (flat on $PROVIDER_PHYSNET)"
    fi
    if openstack_admin subnet show "$BS_PROVIDER_SUBNET" >/dev/null 2>&1; then
        log_ok "subnet '$BS_PROVIDER_SUBNET' already exists — left untouched"
    else
        # No DHCP: these addresses are handed out as floating IPs, not leased.
        openstack_admin subnet create --network "$BS_PROVIDER_NET" --no-dhcp \
            --subnet-range "$PROVIDER_CIDR" --gateway "$PROVIDER_GATEWAY" \
            --allocation-pool "start=${FLOATING_START},end=${FLOATING_END}" \
            "$BS_PROVIDER_SUBNET" >/dev/null
        log_ok "subnet '$BS_PROVIDER_SUBNET' created ($PROVIDER_CIDR, pool ${FLOATING_START}-${FLOATING_END})"
    fi

    # --- tenant network ---------------------------------------------------------
    if openstack_admin network show "$BS_TENANT_NET" >/dev/null 2>&1; then
        log_ok "network '$BS_TENANT_NET' already exists — left untouched"
    else
        openstack_admin network create "$BS_TENANT_NET" >/dev/null
        log_ok "tenant network '$BS_TENANT_NET' created (geneve, per ml2 tenant_network_types)"
    fi
    if openstack_admin subnet show "$BS_TENANT_SUBNET" >/dev/null 2>&1; then
        log_ok "subnet '$BS_TENANT_SUBNET' already exists — left untouched"
    else
        openstack_admin subnet create --network "$BS_TENANT_NET" \
            --subnet-range "$TENANT_CIDR" --dns-nameserver "$DNS_SERVER" \
            "$BS_TENANT_SUBNET" >/dev/null
        log_ok "subnet '$BS_TENANT_SUBNET' created ($TENANT_CIDR, dns $DNS_SERVER)"
    fi

    # --- router -----------------------------------------------------------------
    if openstack_admin router show "$BS_ROUTER" >/dev/null 2>&1; then
        log_ok "router '$BS_ROUTER' already exists — left untouched"
    else
        openstack_admin router create "$BS_ROUTER" >/dev/null
        log_ok "router '$BS_ROUTER' created"
    fi
    local gw
    gw="$(openstack_admin router show "$BS_ROUTER" -f value -c external_gateway_info 2>/dev/null || true)"
    case "$gw" in
        ""|None|null)
            openstack_admin router set --external-gateway "$BS_PROVIDER_NET" "$BS_ROUTER" >/dev/null
            log_ok "router '$BS_ROUTER' gateway set to '$BS_PROVIDER_NET'" ;;
        *)  log_ok "router '$BS_ROUTER' already has an external gateway — left unchanged" ;;
    esac
    local addout tsub_id
    tsub_id="$(openstack_admin subnet show "$BS_TENANT_SUBNET" -f value -c id 2>/dev/null || true)"
    if [ -n "$tsub_id" ] && router_has_subnet "$BS_ROUTER" "$tsub_id"; then
        log_ok "tenant subnet already attached to '$BS_ROUTER' (checked by port, not by error text)"
    elif addout="$(openstack_admin router add subnet "$BS_ROUTER" "$BS_TENANT_SUBNET" 2>&1)"; then
        log_ok "tenant subnet attached to '$BS_ROUTER'"
    elif grep -qiE 'already has a port|already exist|conflict|409|overlaps with cidr' <<<"$addout"; then
        log_ok "tenant subnet already attached to '$BS_ROUTER'"
    else
        log_error "could not attach the tenant subnet to the router:"
        printf '     %s\n' "$(head -3 <<<"$addout")" >&2
        note_skip bootstrap_resources "the router has no interface on the tenant subnet."
        return 0
    fi

    # --- security group rules ----------------------------------------------------
    # Applied to the admin project's own 'default' group, because that is the
    # group an instance gets when none is named. Existing rules are never removed.
    local sg
    sg="$(openstack_admin security group list --project admin -f value -c ID -c Name 2>/dev/null \
          | awk '$2=="default"{print $1; exit}' || true)"
    if [ -z "$sg" ]; then
        log_warn "no 'default' security group found in the admin project; rules were not added"
    else
        bs_secgroup_rule "icmp"    --proto icmp --ingress --remote-ip 0.0.0.0/0 "$sg" || true
        bs_secgroup_rule "ssh/22"  --proto tcp --dst-port 22 --ingress --remote-ip 0.0.0.0/0 "$sg" || true
    fi

    # --- keypair -------------------------------------------------------------------
    # RSA on purpose: the private key has to work against whatever tiny SSH server
    # the guest image runs, and RSA is the one algorithm every one of them accepts.
    if $SUDO test -f "$KEYPAIR_PRIVATE" && $SUDO test -f "$KEYPAIR_PUBLIC"; then
        log_ok "keypair files already present in $HAGISTACK_ETC — not regenerated"
    elif $SUDO test -f "$KEYPAIR_PRIVATE" || $SUDO test -f "$KEYPAIR_PUBLIC"; then
        log_warn "only one half of the keypair exists in $HAGISTACK_ETC; it is left alone."
        log_warn "  Remove both files by hand if you want a fresh key."
    else
        $SUDO ssh-keygen -q -t rsa -b 3072 -N '' -C hagistack -f "$KEYPAIR_PRIVATE" \
            || die "ssh-keygen failed while creating $KEYPAIR_PRIVATE"
        log_ok "keypair generated at $KEYPAIR_PRIVATE (rsa 3072)"
    fi
    $SUDO chmod 0600 "$KEYPAIR_PRIVATE" 2>/dev/null || true
    if openstack_admin keypair show "$BS_KEYPAIR" >/dev/null 2>&1; then
        log_ok "keypair '$BS_KEYPAIR' already registered in Nova — left untouched"
    elif $SUDO test -f "$KEYPAIR_PUBLIC"; then
        openstack_admin keypair create --public-key "$KEYPAIR_PUBLIC" "$BS_KEYPAIR" >/dev/null
        log_ok "keypair '$BS_KEYPAIR' registered in Nova"
    else
        log_warn "no public key to register; '$BS_KEYPAIR' was not created in Nova"
    fi

    phase_mark_done bootstrap_resources
}

# ---------------------------------------------------------------------------
# compute-add — a second (third, ...) compute node
#
# What this node does NOT get, and why:
#
#   * no database credential of any kind. Since Pike a compute node must not
#     reach the cell database; it goes through nova-conductor over RabbitMQ.
#     So the controller's DB passwords are never copied here.
#   * no admin password. Nothing on a compute node authenticates as admin.
#   * no provider bridge and no ovn-bridge-mappings. A bridge mapping with no
#     NIC behind it invites OVN to bind a provider port to this chassis and
#     drop its traffic. Tenant (geneve) ports need no mapping at all; add a
#     mapping by hand once a real NIC is attached here.
#   * no enable-chassis-as-gw. The controller is the gateway chassis.
#
# Secrets are delivered by the operator, never generated here: a compute node
# that invented its own RabbitMQ password would simply fail to talk to anything.
# `hagistack compute-secrets` on the controller emits exactly the five values
# below and nothing else.
# ---------------------------------------------------------------------------
COMPUTE_SECRET_KEYS="RABBIT_PASS NOVA_SERVICE_PASS PLACEMENT_SERVICE_PASS
                     NEUTRON_SERVICE_PASS METADATA_PROXY_SECRET"

# Bounded TCP reachability check against the controller. No data is exchanged.
controller_port_open() {   # controller_port_open <port>
    _probe timeout 5 bash -c "exec 3<>/dev/tcp/${CONTROLLER_IP}/$1" >/dev/null 2>&1
}

phase_compute_preflight() {
    log_step "preflight (compute node)"
    _preflight_host

    [ -n "$CONTROLLER_IP" ] || die "compute-add needs --controller-ip: the MANAGEMENT address of
     the node that runs the controller (the MGMT_IP that 'hagistack status' shows there).
     None of the provider-network settings are required on a compute node."
    valid_peer_ipv4 "$CONTROLLER_IP" \
        || die "CONTROLLER_IP '$CONTROLLER_IP' is not usable as another machine's address.
     It must be a plain IPv4 unicast address — not 0.x, not 127.x, not 169.254.x,
     not multicast, and not 255.255.255.255."

    if [ -z "$MGMT_IP" ]; then
        have ip || die "cannot autodetect MGMT_IP: iproute2 is not installed. Pass --mgmt-ip."
        MGMT_IP="$(ip -4 -o route get "$CONTROLLER_IP" 2>/dev/null \
                   | awk '{for(i=1;i<=NF;i++) if($i=="src") print $(i+1)}' | head -1 || true)"
        [ -n "$MGMT_IP" ] || MGMT_IP="$(ip -4 -o route get 1.1.1.1 2>/dev/null \
                   | awk '{for(i=1;i<=NF;i++) if($i=="src") print $(i+1)}' | head -1 || true)"
    fi
    [ -n "$MGMT_IP" ] || die "could not determine this node's MGMT_IP; pass --mgmt-ip explicitly"
    valid_ipv4 "$MGMT_IP" || die "MGMT_IP '$MGMT_IP' is not a valid IPv4 address"
    [ "$MGMT_IP" != "$CONTROLLER_IP" ] \
        || die "CONTROLLER_IP equals this node's own address ($MGMT_IP).
     compute-add adds a SECOND machine; run 'all-in-one' on the controller itself."
    log_ok "this node $MGMT_IP -> controller $CONTROLLER_IP"
    log_info "geneve tunnel endpoint on this node will be $MGMT_IP"

    REGION_NAME="${REGION_NAME:-RegionOne}"
    valid_region_name "$REGION_NAME" || die "REGION_NAME '$REGION_NAME' is not valid"

    # Refuse to install several hundred megabytes of libvirt and qemu against a
    # controller this node cannot reach. Nothing has been changed at this point.
    local port name port_name closed=""
    for port_name in "5000:identity" "9292:image" "8778:placement" "5672:message queue" "6642:OVN southbound"; do
        port="${port_name%%:*}"; name="${port_name#*:}"
        if controller_port_open "$port"; then
            log_ok "controller ${CONTROLLER_IP}:${port} reachable ($name)"
        else
            closed="${closed}${closed:+, }${port} ($name)"
        fi
    done
    if [ -n "$closed" ]; then
        die "the controller is not reachable on: $closed
     Nothing was installed or changed. Check, on the controller:
       ss -ltn | grep -E '5000|9292|8778|5672|6642'
     and that its firewall lets this node in. The OVN southbound listener is set
     to the controller's management address by its 'ovn' phase; if the controller
     was built with a different MGMT_IP than the address given here, fix that first."
    fi
    log_ok "compute preflight passed"
}

phase_compute_secrets() {
    log_step "secrets (delivered, never generated here)"
    if ! $SUDO test -f "$SECRETS_FILE"; then
        die "$SECRETS_FILE is missing.
     A compute node cannot invent these values: they have to be the controller's.
     On the controller:
         sudo hagistack compute-secrets > compute-secrets.env
     Copy it across (it is mode 0600 and contains live credentials):
         scp compute-secrets.env this-node:/tmp/
     On this node:
         sudo install -o root -g root -m 0600 /tmp/compute-secrets.env $SECRETS_FILE
         shred -u /tmp/compute-secrets.env
     'compute-secrets' emits only $COMPUTE_SECRET_KEYS —
     no database password and no admin password ever reach a compute node."
    fi
    local perm; perm="$($SUDO stat -c '%a' "$SECRETS_FILE")"
    [ "$perm" = "600" ] || die "$SECRETS_FILE has mode $perm; expected 600.
     Fix it with: sudo chmod 600 $SECRETS_FILE"

    # The file is checked before it is sourced. This shell refuses to execute a
    # config file for exactly this reason, and a credentials file deserves the
    # same treatment: a stray diagnostic line at the top of it used to surface
    # as an opaque `syntax error near unexpected token` from /dev/fd/63 instead
    # of naming the problem.
    local bad
    bad="$($SUDO cat "$SECRETS_FILE" | grep -nvE '^[[:space:]]*(#|$)|^[A-Z][A-Z0-9_]*=[A-Za-z0-9._:/@+=-]*$' | head -3 || true)"
    if [ -n "$bad" ]; then
        log_error "$SECRETS_FILE contains lines that are not comments or KEY=VALUE:"
        printf '     %s\n' "$(cut -d: -f1 <<<"$bad" | tr '\n' ' ')" >&2
        die "refusing to source it. Re-create it on the controller with
     'sudo ${SELF##*/} compute-secrets > compute-secrets.env' and copy it again;
     do not edit it by hand and do not let anything else write to that stream."
    fi
    # shellcheck disable=SC1090
    . <($SUDO cat "$SECRETS_FILE")
    local k lacking=""
    for k in $COMPUTE_SECRET_KEYS; do
        [ -n "${!k:-}" ] || lacking="${lacking}${lacking:+ }$k"
    done
    [ -z "$lacking" ] || die "$SECRETS_FILE is missing: $lacking
     Regenerate it on the controller with 'hagistack compute-secrets'."
    log_ok "delivered secrets present and readable (values never printed)"
    log_info "keys in use: $(echo "$COMPUTE_SECRET_KEYS" | tr -s '[:space:]' ' ')"
    phase_mark_done compute_secrets
}

phase_compute_packages() {
    log_step "packages (compute node)"
    local pkgs="nova-compute nova-compute-kvm openvswitch-switch ovn-host neutron-ovn-metadata-agent"
    local absent="" p
    for p in $pkgs; do
        dpkg-query -W -f='${Status}' "$p" 2>/dev/null | grep -q "install ok installed" || absent="$absent $p"
    done
    if [ -z "$absent" ]; then
        log_ok "compute packages already installed"
    else
        log_info "installing:$absent (nova-compute pulls libvirt-daemon-system and qemu-system)"
        $SUDO env DEBIAN_FRONTEND=noninteractive apt-get update -qq
        # shellcheck disable=SC2086
        $SUDO env DEBIAN_FRONTEND=noninteractive apt-get install -y -qq $pkgs
        log_ok "compute packages installed"
    fi
    log_info "nova $(dpkg-query -W -f='${Version}' nova-common 2>/dev/null || echo '?'), \
ovn $(dpkg-query -W -f='${Version}' ovn-host 2>/dev/null || echo '?'), \
neutron $(dpkg-query -W -f='${Version}' neutron-common 2>/dev/null || echo '?')"
    phase_mark_done compute_packages
}

phase_compute_ovn() {
    log_step "OVN on this compute node"
    if [ "$HAS_SYSTEMD" -eq 1 ]; then
        service_start_enable openvswitch-switch
        local u
        for u in $OVN_HOST_UNITS; do service_start_enable "$u"; done
    else
        log_warn "systemd is not running here; OVS and ovn-controller cannot be started"
        note_skip compute_ovn "no systemd: the chassis cannot register. Nothing was configured."
        return 0
    fi
    if ! ovs_ready; then
        note_skip compute_ovn "the Open vSwitch database is not answering. Nothing was configured."
        return 0
    fi
    log_ok "Open vSwitch database reachable"

    # No ovn-bridge-mappings and no ovn-cms-options here — see the block comment.
    _ovs_extid_c() {
        local cur
        cur="$(ovs_vsctl --if-exists get open_vswitch . "external_ids:$1" 2>/dev/null | tr -d '"')"
        [ "$cur" = "$2" ] && return 1
        ovs_vsctl set open_vswitch . "external_ids:$1=$2"
        return 0
    }
    local have_mgr
    have_mgr="$(ovs_vsctl --bare --columns=target list manager 2>/dev/null | tr -d '[:space:]' || true)"
    if [ "$have_mgr" = "$OVS_MANAGER" ]; then
        log_ok "Open vSwitch manager already $OVS_MANAGER"
    else
        ovs_vsctl set-manager "$OVS_MANAGER" || die "could not set the Open vSwitch manager"
        log_ok "Open vSwitch manager set to $OVS_MANAGER (loopback only; os_vif needs it here too)"
    fi

    local changed=0
    _ovs_extid_c ovn-remote     "tcp:${CONTROLLER_IP}:${OVN_SB_PORT}" && changed=1
    _ovs_extid_c ovn-encap-type geneve                                && changed=1
    _ovs_extid_c ovn-encap-ip   "$MGMT_IP"                            && changed=1
    if [ "$changed" -eq 1 ]; then
        log_ok "chassis configured (southbound ${CONTROLLER_IP}:${OVN_SB_PORT}, geneve encap $MGMT_IP)"
    else
        log_ok "chassis already configured (unchanged)"
    fi
    log_info "no ovn-bridge-mappings is set on a compute node: with no NIC behind a"
    log_info "  provider bridge, a mapping would only invite OVN to blackhole traffic here"

    # Ask the controller's southbound database whether this chassis turned up.
    local sysid seen
    sysid="$(ovs_vsctl --if-exists get open_vswitch . external_ids:system-id 2>/dev/null | tr -d '"' || true)"
    seen=""
    if have ovn-sbctl && [ -n "$sysid" ]; then
        local i=0
        while [ "$i" -lt 6 ]; do
            if _probe ovn-sbctl --db="tcp:${CONTROLLER_IP}:${OVN_SB_PORT}" --timeout=10 \
                  --bare --columns=name list chassis 2>/dev/null | grep -qx "$sysid"; then
                seen=yes; break
            fi
            i=$((i+1)); sleep 5
        done
    fi
    if [ -n "$seen" ]; then
        log_ok "this chassis ($sysid) is registered in the controller's southbound DB"
    else
        note_skip compute_ovn "chassis '${sysid:-unknown}' has not appeared in the controller's
     southbound database at ${CONTROLLER_IP}:${OVN_SB_PORT}. ovn-controller may still be
     starting, or the controller is not accepting the connection."
        return 0
    fi
    phase_mark_done compute_ovn
}

phase_compute_nova() {
    log_step "nova-compute on this node"

    local changed=0
    ini_set "$NOVA_CONF" DEFAULT my_ip "$MGMT_IP"                                  && changed=1
    ini_set "$NOVA_CONF" DEFAULT transport_url \
        "rabbit://openstack:${RABBIT_PASS}@${CONTROLLER_IP}:5672/"                 && changed=1
    # Deliberately NO [database] / [api_database] section is written: a compute
    # node reaches the cell database only through nova-conductor.
    write_service_auth_at "$NOVA_CONF" service_user nova "$NOVA_SERVICE_PASS" "" "$CONTROLLER_IP"
    ini_set "$NOVA_CONF" service_user send_service_user_token true                 && changed=1
    write_service_auth_at "$NOVA_CONF" placement placement "$PLACEMENT_SERVICE_PASS" internal "$CONTROLLER_IP"
    write_service_auth_at "$NOVA_CONF" neutron neutron "$NEUTRON_SERVICE_PASS" internal "$CONTROLLER_IP"
    ini_set "$NOVA_CONF" glance valid_interfaces internal                          && changed=1
    ini_set "$NOVA_CONF" neutron service_metadata_proxy true                       && changed=1
    ini_set "$NOVA_CONF" neutron metadata_proxy_shared_secret "$METADATA_PROXY_SECRET" && changed=1
    ini_set "$NOVA_CONF" vnc enabled true                                          && changed=1
    ini_set "$NOVA_CONF" vnc server_listen "$MGMT_IP"                              && changed=1
    ini_set "$NOVA_CONF" vnc server_proxyclient_address "$MGMT_IP"                 && changed=1
    ini_set "$NOVA_CONF" oslo_concurrency lock_path /var/lib/nova/tmp              && changed=1
    # See phase_nova_compute: os_vif's default tcp:127.0.0.1:6640 does not exist
    # on Ubuntu, and without this every guest build on this node fails to plug
    # its VIF.
    ini_set "$NOVA_CONF" os_vif_ovs ovsdb_connection "$OVS_DB_TCP"                && changed=1
    if [ "$changed" -eq 1 ]; then
        log_ok "nova.conf configured for a compute-only node (credentials not shown)"
    else
        log_ok "nova.conf already correct (unchanged)"
    fi
    # A compute node must not open the cell database. nova-compute reaches the
    # cell only through nova-conductor over RPC; if [database] connection (or
    # [api_database] connection) is present — the package ships one, and a host
    # that was ever a controller keeps one — oslo.db opens it anyway and
    # nova-compute logs, on every start:
    #     WARNING oslo_db.sqlalchemy.engines SQL connection failed. 7 attempts left.
    #     WARNING nova.context Timed out waiting for response from cell 00000000-...
    # Measured on GCE node2 during the 2026-09-28 acceptance; registration still
    # succeeded, which is exactly why it is easy to leave in place.
    #
    # Only these two keys are touched, and they are commented out rather than
    # deleted, so the value survives and the file says who silenced it. A
    # re-run finds them already commented and rewrites nothing.
    local dbsec
    for dbsec in database api_database; do
        if ini_comment_out "$NOVA_CONF" "$dbsec" connection \
               "compute-only node; nova-compute reaches the cell through nova-conductor"; then
            log_ok "[$dbsec] connection commented out in nova.conf (value kept on the line)"
            changed=1
        fi
    done
    local dbleft
    dbleft="$(ini_get "$NOVA_CONF" database connection 2>/dev/null || true)$(ini_get "$NOVA_CONF" api_database connection 2>/dev/null || true)"
    if [ -n "$dbleft" ]; then
        log_warn "nova.conf STILL has an active [database]/[api_database] connection."
        log_warn "  This node will try to open the cell database. Remove it by hand."
    else
        log_ok "no active [database]/[api_database] connection: this node opens no database"
    fi
    $SUDO chown root:nova "$NOVA_CONF" 2>/dev/null || true
    $SUDO chmod 0640 "$NOVA_CONF"
    $SUDO install -d -o nova -g nova -m 0750 /var/lib/nova/tmp 2>/dev/null || true

    ini_set "$NOVA_COMPUTE_CONF" DEFAULT compute_driver libvirt.LibvirtDriver >/dev/null || true
    ini_set "$NOVA_COMPUTE_CONF" libvirt virt_type "$VIRT_TYPE" >/dev/null || true
    if [ "$VIRT_TYPE" = "qemu" ]; then
        ini_set "$NOVA_COMPUTE_CONF" libvirt cpu_mode none >/dev/null || true
        log_warn "virt_type=qemu on this node: software emulation, 10-50x slower"
    else
        log_ok "virt_type=kvm (/dev/kvm usable)"
    fi
    $SUDO chown root:nova "$NOVA_COMPUTE_CONF" 2>/dev/null || true
    $SUDO chmod 0640 "$NOVA_COMPUTE_CONF"

    if [ "$HAS_SYSTEMD" -eq 1 ]; then
        service_start_enable libvirtd
        local u
        for u in $NOVA_COMPUTE_UNITS; do
            service_apply "$u" "$NOVA_CONF" "$NOVA_COMPUTE_CONF"
        done
    else
        note_skip compute_nova "no systemd: nova-compute was configured but not started."
        return 0
    fi
    service_active nova-compute || {
        note_skip compute_nova "nova-compute is not running; check 'journalctl -u nova-compute'."
        return 0; }
    log_ok "nova-compute running"

    # Evidence rather than assertion for the database question above: read this
    # node's own nova-compute journal since the current start and count the
    # lines that only appear when it opens, or waits on, a database.
    local since dblines
    since="$($SUDO systemctl show -p ActiveEnterTimestamp --value nova-compute 2>/dev/null || true)"
    [ -n "$since" ] || since="-2min"
    sleep 10   # bounded settle: these lines appear within seconds of start, or not at all
    dblines="$($SUDO journalctl -u nova-compute --since "$since" --no-pager 2>/dev/null \
        | grep -cE 'oslo_db\.sqlalchemy\.engines|SQL connection failed|Timed out waiting for response from cell' || true)"
    if [ "${dblines:-0}" -eq 0 ]; then
        log_ok "nova-compute journal since start: 0 database lines (no SQL connection attempted)"
    else
        log_warn "nova-compute journal since start: $dblines database lines — this node is still opening a database"
    fi

    log_warn "this node cannot confirm its own registration: it has no admin credential"
    log_warn "  and no database access, by design. Run on the CONTROLLER:"
    log_warn "      sudo hagistack discover-hosts"
    phase_mark_done compute_nova
}

phase_compute_metadata() {
    log_step "OVN metadata agent on this node"
    local changed=0
    ini_set "$OVN_META_CONF" DEFAULT nova_metadata_host "$CONTROLLER_IP"              && changed=1
    ini_set "$OVN_META_CONF" DEFAULT metadata_proxy_shared_secret "$METADATA_PROXY_SECRET" && changed=1
    ini_set "$OVN_META_CONF" ovs ovsdb_connection "unix:$OVS_DB_SOCK" && changed=1
    ini_set "$OVN_META_CONF" ovn ovn_sb_connection "tcp:${CONTROLLER_IP}:${OVN_SB_PORT}" && changed=1
    [ "$changed" -eq 1 ] && log_ok "metadata agent configured (shared secret not shown)" \
                         || log_ok "metadata agent already correct (unchanged)"
    $SUDO chown root:neutron "$OVN_META_CONF" 2>/dev/null || true
    $SUDO chmod 0640 "$OVN_META_CONF"
    # /etc/neutron/neutron.conf is deliberately left as the package shipped it:
    # the init script passes it as a second --config-file, but the OVN metadata
    # agent is driven by the southbound database and needs no RPC credential.
    log_info "neutron.conf is left untouched: this agent needs no message-queue credential"

    if [ "$HAS_SYSTEMD" -eq 1 ]; then
        service_apply neutron-ovn-metadata-agent "$OVN_META_CONF"
    else
        note_skip compute_metadata "no systemd: the metadata agent was configured but not started."
        return 0
    fi
    service_active neutron-ovn-metadata-agent || {
        note_skip compute_metadata "neutron-ovn-metadata-agent is not running."
        return 0; }
    log_ok "neutron-ovn-metadata-agent running"
    phase_mark_done compute_metadata
}

# ---------------------------------------------------------------------------
# where we stop
# ---------------------------------------------------------------------------
# Two outcomes, never conflated: the base layer either came up or it did not.
# A run that skipped MariaDB or RabbitMQ is reported as INCOMPLETE and exits 4.
print_stage_banner() {
    local rule="────────────────────────────────────────────────────────────────"
    if [ -n "$SKIPPED_PHASES" ]; then
        cat <<EOF

${C_RED}${rule}${C_RESET}
${C_RED} INCOMPLETE — NOT EVERY IMPLEMENTED PHASE COULD RUN${C_RESET}
${C_RED}${rule}${C_RESET}
 Skipped    : $SKIPPED_PHASES
 Completed  : $(printf '%s' "$(_completed_phases)")

 One or more services could not be reached, so their setup did not run.
 This is expected in a container with no systemd, and it is NOT a failure
 of the shell — but the host does NOT have a complete OpenStack on it.

 Nothing was left half-written: the skipped phases made no changes and
 carry no state marker, so re-running once the services are up will
 complete them.

 Exit status 4 = ran to the end, the deployment is incomplete.
${C_RED}${rule}${C_RESET}
EOF
        return 0
    fi
    cat <<EOF

${C_YEL}${rule}${C_RESET}
${C_YEL} ALL IMPLEMENTED PHASES RAN — ${C_RED}NOTHING HERE IS VERIFIED ON REAL HARDWARE${C_RESET}
${C_YEL}${rule}${C_RESET}
 Implemented and run here : $IMPLEMENTED_PHASES
 Verified on real hardware: ${C_RED}$VERIFIED_ON_HARDWARE${C_RESET}

 Up on this host: database, message queue, cache, Keystone identity, Glance,
 Placement, the Neutron networking API on ML2/OVN, Nova (API, conductor,
 scheduler and a registered hypervisor, virt_type=$VIRT_TYPE), the Horizon
 dashboard, and the initial resources an instance needs.

 ${C_RED}Still unverified: $UNVERIFIED_ITEMS${C_RESET}
 Every phase above checked its own work as far as one host can — a served
 login page is not a login, and a registered hypervisor is not a booted guest.

 The provider bridge $PROVIDER_BRIDGE has ${C_RED}no NIC attached and no address${C_RESET}, so
 '$BS_PROVIDER_NET' and its floating IPs reach no physical LAN yet.

 Dashboard  : http://${MGMT_IP}${HORIZON_PATH}/   (user: admin)
 Credentials: $ADMIN_OPENRC (mode 0600, outside the repository)
              the admin password is in that file; it is never printed here.

 Boot a guest to find out whether any of this actually works:
   . $ADMIN_OPENRC
   openstack server create --flavor $BS_FLAVOR --image $IMAGE_NAME \
       --network $BS_TENANT_NET --key-name $BS_KEYPAIR demo1
   openstack server list
   openstack console log show demo1

 Add a second compute node:
   on this controller : sudo ${SELF##*/} compute-secrets > compute-secrets.env
   on the new node    : sudo ${SELF##*/} compute-add --controller-ip $MGMT_IP
   back here          : sudo ${SELF##*/} discover-hosts

 Re-running this command is safe: it does not drop databases, does not
 rotate existing secrets or fernet keys, does not append duplicate
 configuration, and does not recreate or delete any initial resource.
${C_YEL}${rule}${C_RESET}
EOF
}

print_compute_banner() {
    local rule="────────────────────────────────────────────────────────────────"
    if [ -n "$SKIPPED_PHASES" ]; then
        cat <<EOF

${C_RED}${rule}${C_RESET}
${C_RED} COMPUTE-ADD INCOMPLETE${C_RESET}
${C_RED}${rule}${C_RESET}
 Skipped : $SKIPPED_PHASES

 The skipped phases changed nothing and carry no state marker. Fix the cause
 and re-run; this node is NOT ready to take instances.

 Exit status 4.
${C_RED}${rule}${C_RESET}
EOF
        return 0
    fi
    cat <<EOF

${C_YEL}${rule}${C_RESET}
${C_YEL} COMPUTE NODE CONFIGURED — ${C_RED}REGISTRATION NOT CONFIRMED FROM HERE${C_RESET}
${C_YEL}${rule}${C_RESET}
 This node  : $MGMT_IP   (geneve endpoint, virt_type=$VIRT_TYPE)
 Controller : $CONTROLLER_IP

 Running here: ovn-controller, nova-compute, neutron-ovn-metadata-agent.
 This node holds ${C_RED}no database credential and no admin credential${C_RESET}, by design,
 so it cannot check its own registration. ${C_RED}On the CONTROLLER${C_RESET}, run:

   sudo ${SELF##*/} discover-hosts

 and confirm the new host appears in both lists it prints. Until then the
 scheduler will not place anything here.

 No ovn-bridge-mappings is configured on this node: provider-network ports
 cannot land here until a real NIC is attached to a bridge and mapped.

 ${C_RED}Unverified: $UNVERIFIED_ITEMS${C_RESET}
${C_YEL}${rule}${C_RESET}
EOF
}

_completed_phases() {
    local p out=""
    for p in $IMPLEMENTED_PHASES; do
        case " $SKIPPED_PHASES " in *" $p "*) continue ;; esac
        out="${out}${out:+ }$p"
    done
    printf '%s' "${out:-none}"
}

