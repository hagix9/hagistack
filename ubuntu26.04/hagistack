#!/usr/bin/env bash
#
# hagistack — OpenStack deployment shell for Ubuntu Server 26.04 LTS
#
# Target : OpenStack 2026.1 Gazpacho, from the Ubuntu 26.04 distro archive.
# Engine : plain Bash. Not OpenStack-Ansible, Kolla-Ansible, Packstack or DevStack.
#
# STATUS: STEP 1 of the rebuild. Skeleton + preflight + base services only
#         (MariaDB, RabbitMQ, memcached). Keystone, Glance, Placement, Nova,
#         Neutron/OVN and Horizon are NOT implemented yet, so `all-in-one`
#         deliberately stops after the base layer and says so. Finishing this
#         command does NOT mean you have a working OpenStack.
#
set -Eeuo pipefail   # -E: the ERR trap must fire inside functions too

# Associative arrays and other bash 4 features are used throughout. Say so
# plainly instead of failing later with "declare: -A: invalid option" — which
# is what macOS's bash 3.2 produces.
if [ -z "${BASH_VERSINFO[0]:-}" ] || [ "${BASH_VERSINFO[0]}" -lt 4 ]; then
    echo "hagistack: needs bash 4 or newer; this is ${BASH_VERSION:-unknown}." >&2
    echo "  Ubuntu Server 26.04 (the only supported target) ships bash 5." >&2
    exit 1
fi

HAGISTACK_VERSION="0.5.0-step5"
HAGISTACK_STAGE="step5: base + Keystone + Glance + Placement + Neutron/OVN + Nova (no Horizon; guest boot unverified)"

# Phases implemented in this step. `all-in-one` runs exactly these.
IMPLEMENTED_PHASES="preflight base_packages database rabbitmq memcached keystone glance placement ovn neutron nova nova_compute"
# Phases still to come. Listed so the CLI can be honest about where it stops.
PENDING_PHASES="horizon bootstrap_resources verify"

# ---------------------------------------------------------------------------
# paths
# ---------------------------------------------------------------------------
HAGISTACK_ETC="${HAGISTACK_ETC:-/etc/hagistack}"
HAGISTACK_STATE="${HAGISTACK_STATE:-/var/lib/hagistack}"
SECRETS_FILE="$HAGISTACK_ETC/secrets.env"
STATE_DIR="$HAGISTACK_STATE/state"

SELF="${BASH_SOURCE[0]}"
SELF_DIR="$(cd "$(dirname "$SELF")" && pwd)"

# ---------------------------------------------------------------------------
# logging
# ---------------------------------------------------------------------------
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
    C_RESET=$'\033[0m'; C_RED=$'\033[31m'; C_YEL=$'\033[33m'
    C_GRN=$'\033[32m'; C_BLU=$'\033[34m'; C_DIM=$'\033[2m'
else
    C_RESET=''; C_RED=''; C_YEL=''; C_GRN=''; C_BLU=''; C_DIM=''
fi

log_step()  { printf '%s==>%s %s\n'      "$C_BLU" "$C_RESET" "$*"; }
log_info()  { printf '    %s\n'                                "$*"; }
log_ok()    { printf '    %sok%s   %s\n' "$C_GRN" "$C_RESET" "$*"; }
log_warn()  { printf '%swarn:%s %s\n'    "$C_YEL" "$C_RESET" "$*" >&2; }
log_error() { printf '%serror:%s %s\n'   "$C_RED" "$C_RESET" "$*" >&2; }
log_skip()  { printf '    %sskip%s %s\n' "$C_DIM" "$C_RESET" "$*"; }

die() { log_error "$*"; exit 1; }

# Report the failing line rather than dying silently under `set -e`.
_on_err() {
    local rc=$? line=$1
    log_error "aborted at ${SELF##*/}:${line} (exit $rc)"
    log_error "nothing was rolled back; re-run after fixing the cause (this shell is re-run safe)"
    exit "$rc"
}
trap '_on_err $LINENO' ERR

# ---------------------------------------------------------------------------
# small helpers
# ---------------------------------------------------------------------------
have()   { command -v "$1" >/dev/null 2>&1; }
is_root(){ [ "$(id -u)" -eq 0 ]; }

# sudo only when we are not already root; fail clearly when neither works.
SUDO=""
_need_privilege() {
    if is_root; then SUDO=""; return 0; fi
    if have sudo; then SUDO="sudo"; return 0; fi
    die "need root privileges and sudo is not available; re-run as root"
}

# Deterministic, URL-safe secret. No fixed passwords anywhere in this file.
# A consumer-side `head` closes the pipe while the producer is still writing;
# the producer takes SIGPIPE and the pipeline reports 141 under `set -o pipefail`.
# `tr -dc … < /dev/urandom | head -c N` does that deterministically (measured:
# 141 on 200/200 runs). Bound the *producer* instead and trim with a shell
# substring, so no pipe is ever broken.
gen_secret() {
    local n="${1:-32}" out="" chunk tries=0
    while [ "${#out}" -lt "$n" ]; do
        tries=$((tries + 1))
        [ "$tries" -le 12 ] \
            || die "could not gather $n characters of randomness after $tries attempts"
        if have openssl; then
            chunk="$(openssl rand -base64 256 2>/dev/null | LC_ALL=C tr -dc 'A-Za-z0-9' || true)"
        else
            chunk="$(head -c 4096 /dev/urandom 2>/dev/null | LC_ALL=C tr -dc 'A-Za-z0-9' || true)"
        fi
        [ -n "$chunk" ] \
            || die "no usable entropy source (tried openssl and /dev/urandom)"
        out="$out$chunk"
    done
    printf '%s\n' "${out:0:n}"
}

# ---------------------------------------------------------------------------
# idempotent INI editing
#
# Replaces the old shells' `tee -a` / blanket `sed -i`, which appended a new
# copy on every run. Setting the same key twice must leave the file unchanged.
# ---------------------------------------------------------------------------
ini_set() {
    local file="$1" section="$2" key="$3" value="$4"
    [ -n "$file" ] && [ -n "$section" ] && [ -n "$key" ] \
        || die "ini_set: file, section and key are required"

    local dir; dir="$(dirname "$file")"
    [ -d "$dir" ] || $SUDO mkdir -p "$dir"
    [ -f "$file" ] || $SUDO touch "$file"

    local tmp; tmp="$(mktemp)"
    # Read through $SUDO: /etc/keystone/keystone.conf is 0640 keystone:keystone,
    # so a plain awk cannot open it when the shell runs unprivileged with sudo.
    $SUDO cat "$file" | SECTION="$section" KEY="$key" VALUE="$value" \
        awk '
        BEGIN { section=ENVIRON["SECTION"]; key=ENVIRON["KEY"]; value=ENVIRON["VALUE"]
                in_section=0; done=0; last_content=0 }
        {
            line=$0
            if (line ~ /^[[:space:]]*\[.*\][[:space:]]*$/) {
                name=line; sub(/^[[:space:]]*\[/,"",name); sub(/\][[:space:]]*$/,"",name)
                if (in_section && !done) { buf[++n]=key" = "value; done=1 }
                in_section = (name == section)
                buf[++n]=line
                if (in_section) last_content=n
                next
            }
            if (in_section && !done) {
                k=line
                sub(/^[[:space:]]*/,"",k)
                if (k ~ /^[#;]/) { buf[++n]=line; next }
                split(k, parts, "=")
                kk=parts[1]; gsub(/[[:space:]]+$/,"",kk)
                if (kk == key) { buf[++n]=key" = "value; done=1; last_content=n; next }
            }
            buf[++n]=line
            if (line !~ /^[[:space:]]*$/) last_content=n
        }
        END {
            if (!done) {
                if (!in_section) {
                    if (n > 0 && buf[n] != "") buf[++n]=""
                    buf[++n]="["section"]"
                }
                buf[++n]=key" = "value
            }
            for (i=1; i<=n; i++) print buf[i]
        }' > "$tmp"

    # Only touch the file when the content actually changes: re-running must
    # produce a byte-identical file and must not bump the mtime.
    if $SUDO cmp -s "$tmp" "$file"; then
        rm -f "$tmp"
        return 1   # unchanged
    fi
    $SUDO cp "$tmp" "$file"
    rm -f "$tmp"
    return 0       # changed
}

ini_get() {
    local file="$1" section="$2" key="$3"
    $SUDO test -f "$file" || return 1
    $SUDO cat "$file" | SECTION="$section" KEY="$key" awk '
        BEGIN { section=ENVIRON["SECTION"]; key=ENVIRON["KEY"]; in_section=0 }
        /^[[:space:]]*\[.*\][[:space:]]*$/ {
            name=$0; sub(/^[[:space:]]*\[/,"",name); sub(/\][[:space:]]*$/,"",name)
            in_section=(name==section); next
        }
        in_section {
            k=$0; sub(/^[[:space:]]*/,"",k)
            if (k ~ /^[#;]/) next
            eq=index(k,"="); if (eq==0) next
            kk=substr(k,1,eq-1); vv=substr(k,eq+1)
            gsub(/[[:space:]]+$/,"",kk); gsub(/^[[:space:]]+/,"",vv); gsub(/[[:space:]]+$/,"",vv)
            if (kk==key) { print vv; exit }
        }'
}

# ---------------------------------------------------------------------------
# phase state markers
# ---------------------------------------------------------------------------
phase_done()      { [ -f "$STATE_DIR/$1.done" ]; }
phase_mark_done() { $SUDO mkdir -p "$STATE_DIR"; $SUDO touch "$STATE_DIR/$1.done"; }

# ---------------------------------------------------------------------------
# configuration
#
# Precedence: CLI flags > environment > ./hagistack.env > defaults/autodetect.
# ---------------------------------------------------------------------------
# Every value the operator can set, in one place. Used by the argument parser,
# the config-file parser (as its key allowlist) and the precedence resolver.
CONFIG_KEYS="MGMT_IP EXT_NIC PROVIDER_CIDR PROVIDER_GATEWAY FLOATING_START
             FLOATING_END DNS_SERVER TENANT_CIDR VIRT_TYPE REGION_NAME
             PROVIDER_PHYSNET PROVIDER_BRIDGE"

declare -A CLI_VAL=()  CLI_SET=()
declare -A ENV_VAL=()  ENV_SET=()
declare -A FILE_VAL=() FILE_SET=()
declare -A CONFIG_SOURCE=()

# Capture the inherited environment BEFORE the defaults below blank these
# variables, otherwise the environment tier can never be observed.
# `printenv` succeeds only for a variable that is actually exported, and it
# distinguishes "exported but empty" from "not set" — which the resolver needs.
_capture_env() {
    local k
    for k in $CONFIG_KEYS; do
        if printenv "$k" >/dev/null 2>&1; then
            ENV_VAL[$k]="$(printenv "$k")"
            ENV_SET[$k]=1
        fi
    done
}
_capture_env

MGMT_IP="" EXT_NIC="" PROVIDER_CIDR="" PROVIDER_GATEWAY=""
FLOATING_START="" FLOATING_END="" DNS_SERVER="" TENANT_CIDR="" VIRT_TYPE=""
REGION_NAME="" PROVIDER_PHYSNET="" PROVIDER_BRIDGE=""
DRY_RUN=0 ENV_FILE=""

# ---------------------------------------------------------------------------
# config file
#
# The file is PARSED, never sourced. Sourcing it made every value a shell
# command: `TENANT_CIDR=$(...)` or a backquoted value executed on load, even
# though each line looked like a harmless KEY=VALUE assignment.
#
# Accepted: blank lines, `#` comments, and `KEY=VALUE` where KEY is one of
# CONFIG_KEYS and VALUE contains only [A-Za-z0-9._:/@+=-]. One optional layer
# of matching quotes is stripped. Unknown keys, duplicate keys, malformed
# lines and values with any other character are refused.
# ---------------------------------------------------------------------------
ENVFILE_VALUE_RE='^[A-Za-z0-9._:/@+=-]*$'

load_env_file() {
    local f="${ENV_FILE:-}"
    if [ -z "$f" ]; then
        if   [ -f "./hagistack.env" ];             then f="./hagistack.env"
        elif [ -f "$SELF_DIR/hagistack.env" ];     then f="$SELF_DIR/hagistack.env"
        elif [ -f "$HAGISTACK_ETC/hagistack.env" ];then f="$HAGISTACK_ETC/hagistack.env"
        fi
    fi
    [ -n "$f" ] || return 0
    # Any readable path, not just a regular file, so --env-file /dev/null works.
    [ -r "$f" ] || die "env file not readable: $f"

    local -A seen=()
    local lineno=0 line key val
    while IFS= read -r line || [ -n "$line" ]; do
        lineno=$((lineno + 1))
        line="${line%$'\r'}"                       # tolerate CRLF
        [[ "$line" =~ ^[[:space:]]*(#|$) ]] && continue

        if [[ ! "$line" =~ ^[[:space:]]*([A-Za-z_][A-Za-z0-9_]*)[[:space:]]*=(.*)$ ]]; then
            die "$f line $lineno: not a KEY=VALUE assignment.
     Only blank lines, '#' comments and KEY=VALUE are allowed."
        fi
        key="${BASH_REMATCH[1]}"
        val="${BASH_REMATCH[2]}"
        val="${val%"${val##*[![:space:]]}"}"        # trim trailing blanks
        # strip one matching quote pair, if present
        if   [[ "$val" =~ ^\"(.*)\"$ ]]; then val="${BASH_REMATCH[1]}"
        elif [[ "$val" =~ ^\'(.*)\'$ ]]; then val="${BASH_REMATCH[1]}"
        fi

        case " $CONFIG_KEYS " in
            *" $key "*) ;;
            *) die "$f line $lineno: unknown key '$key'.
     Allowed keys: $(echo $CONFIG_KEYS | tr '\n' ' ')" ;;
        esac
        [ -z "${seen[$key]:-}" ] || die "$f line $lineno: duplicate key '$key'"
        seen[$key]=1

        # The value is deliberately NOT echoed back on failure.
        if [[ ! "$val" =~ $ENVFILE_VALUE_RE ]]; then
            die "$f line $lineno: the value of '$key' contains characters that are
     not allowed. Permitted: letters, digits and . _ - : / @ + =
     (the value itself is not shown). Shell metacharacters such as \$ \` ( ) ; & |
     are refused because this file is configuration, not a script."
        fi
        FILE_VAL[$key]="$val"
        FILE_SET[$key]=1
    done < "$f"
    log_info "config file: $f (parsed, not executed)"
}

# Precedence: command line > environment > config file > default.
# A tier that sets a key to the empty string is an error rather than a silent
# fall-through, so "explicitly blank" can never be mistaken for "not given".
resolve_config() {
    local k val src
    for k in $CONFIG_KEYS; do
        if   [ -n "${CLI_SET[$k]:-}" ];  then val="${CLI_VAL[$k]}";  src="command line"
        elif [ -n "${ENV_SET[$k]:-}" ];  then val="${ENV_VAL[$k]}";  src="environment"
        elif [ -n "${FILE_SET[$k]:-}" ]; then val="${FILE_VAL[$k]}"; src="config file"
        else                                  val="";                src="default"
        fi
        if [ "$src" != "default" ] && [ -z "$val" ]; then
            die "$k was given an empty value on the $src.
     Remove it to fall back to the default, or give it a real value."
        fi
        CONFIG_SOURCE[$k]="$src"
        printf -v "$k" '%s' "$val"
    done
}

print_resolved_config() {
    local k
    echo
    log_step "resolved configuration"
    for k in $CONFIG_KEYS; do
        printf '    %-18s %-22s [%s]\n' "$k" "${!k:-<unset>}" "${CONFIG_SOURCE[$k]:-default}"
    done
}

# ---------------------------------------------------------------------------
# input validation
# ---------------------------------------------------------------------------
valid_ipv4() {
    local ip="$1" o
    [[ "$ip" =~ ^([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})$ ]] || return 1
    for o in "${BASH_REMATCH[@]:1:4}"; do
        [ "$o" -le 255 ] 2>/dev/null || return 1
        # reject 01, 007 and friends
        [ "${#o}" -eq 1 ] || [ "${o#0}" = "$o" ] || return 1
    done
    return 0
}

valid_cidr() {
    local cidr="$1" ip prefix
    case "$cidr" in */*) ;; *) return 1 ;; esac
    ip="${cidr%%/*}"; prefix="${cidr#*/}"
    valid_ipv4 "$ip" || return 1
    [[ "$prefix" =~ ^[0-9]{1,2}$ ]] || return 1
    [ "$prefix" -ge 8 ] && [ "$prefix" -le 30 ] || return 1
    return 0
}

ip_to_int() {
    local IFS=. ; read -r a b c d <<< "$1"
    echo $(( (a<<24) + (b<<16) + (c<<8) + d ))
}

ip_in_cidr() {
    local ip="$1" cidr="$2" net prefix mask ipi neti
    net="${cidr%%/*}"; prefix="${cidr#*/}"
    mask=$(( 0xFFFFFFFF ^ ((1 << (32-prefix)) - 1) ))
    ipi=$(ip_to_int "$ip"); neti=$(ip_to_int "$net")
    [ $(( ipi & mask )) -eq $(( neti & mask )) ]
}

valid_nic_name() {
    local n="$1"
    [ -n "$n" ] || return 1
    [ "${#n}" -le 15 ] || return 1
    [[ "$n" =~ ^[A-Za-z0-9_.-]+$ ]] || return 1
    case "$n" in .|..) return 1 ;; esac
    return 0
}

nic_exists() { [ -e "/sys/class/net/$1" ]; }

valid_region_name() {
    [ -n "$1" ] || return 1
    [ "${#1}" -le 64 ] || return 1
    [[ "$1" =~ ^[A-Za-z0-9._-]+$ ]]
}

# ---------------------------------------------------------------------------
# preflight
# ---------------------------------------------------------------------------
detect_os() {
    [ -r /etc/os-release ] || die "cannot read /etc/os-release; unsupported system"
    # shellcheck disable=SC1091
    OS_ID="$(. /etc/os-release; echo "${ID:-}")"
    OS_VERSION_ID="$(. /etc/os-release; echo "${VERSION_ID:-}")"
    OS_PRETTY="$(. /etc/os-release; echo "${PRETTY_NAME:-unknown}")"
}

detect_container() {
    IN_CONTAINER=0; CONTAINER_KIND=""
    if [ -f /.dockerenv ]; then IN_CONTAINER=1; CONTAINER_KIND="docker"; fi
    if [ -f /run/.containerenv ]; then IN_CONTAINER=1; CONTAINER_KIND="podman"; fi
    if have systemd-detect-virt; then
        local v; v="$(systemd-detect-virt --container 2>/dev/null || true)"
        if [ -n "$v" ] && [ "$v" != "none" ]; then IN_CONTAINER=1; CONTAINER_KIND="$v"; fi
    fi
    if [ "$IN_CONTAINER" -eq 0 ] && grep -qaE '(docker|containerd|libpod|lxc)' /proc/1/cgroup 2>/dev/null; then
        IN_CONTAINER=1; CONTAINER_KIND="cgroup-hint"
    fi
}

# systemd may be absent (container) or present but not PID 1.
detect_init() {
    HAS_SYSTEMD=0
    if [ -d /run/systemd/system ] && have systemctl; then HAS_SYSTEMD=1; fi
}

service_start_enable() {
    local unit="$1"
    if [ "$HAS_SYSTEMD" -eq 1 ]; then
        $SUDO systemctl enable --now "$unit" >/dev/null 2>&1 \
            || die "failed to start $unit under systemd"
        log_ok "$unit active (systemd)"
        SERVICE_START_METHOD[$unit]="systemd"
        return 0
    fi
    log_warn "systemd is not running here; cannot start '$unit' as a managed service"
    log_warn "  -> unit ordering/startup stays a GCE acceptance item (B0a/B0b)"
    SERVICE_START_METHOD[$unit]="not-started-no-systemd"
    return 0
}

phase_preflight() {
    log_step "preflight"
    detect_os; detect_container; detect_init

    log_info "os        : $OS_PRETTY"
    log_info "arch      : $(dpkg --print-architecture 2>/dev/null || uname -m)"
    log_info "init      : $([ "$HAS_SYSTEMD" -eq 1 ] && echo systemd || echo 'no systemd (container-style)')"
    [ "$IN_CONTAINER" -eq 1 ] && log_info "container : yes ($CONTAINER_KIND)"

    # --- OS gate ---
    if [ "$OS_ID" != "ubuntu" ]; then
        die "unsupported OS '$OS_ID'. hagistack targets Ubuntu Server 26.04 LTS.
     Rocky Linux 10.2 is not supported: OpenStack 2026.1 is not available as
     RPMs for EL10, and neither are Open vSwitch/OVN."
    fi
    if [ "$OS_VERSION_ID" != "26.04" ]; then
        die "unsupported Ubuntu version '$OS_VERSION_ID'. hagistack targets 26.04 LTS.
     The package names and OpenStack release differ on other versions."
    fi
    log_ok "Ubuntu 26.04 confirmed"

    # --- architecture / qemu package selection ---
    local arch; arch="$(dpkg --print-architecture 2>/dev/null || echo unknown)"
    case "$arch" in
        amd64) QEMU_PKG="qemu-system-x86" ;;
        arm64) QEMU_PKG="qemu-system-arm"
               log_warn "arm64: guest images must be arm64 too. Not an acceptance target in this step." ;;
        *)     die "unsupported architecture '$arch' (expected amd64 or arm64)" ;;
    esac
    log_ok "architecture $arch -> $QEMU_PKG"

    # --- KVM vs QEMU emulation ---
    if [ -z "$VIRT_TYPE" ]; then
        if [ -e /dev/kvm ] && [ -r /dev/kvm ] && [ -w /dev/kvm ]; then
            VIRT_TYPE="kvm"
        else
            VIRT_TYPE="qemu"
        fi
    fi
    case "$VIRT_TYPE" in
        kvm)  log_ok "/dev/kvm usable -> virt_type=kvm" ;;
        qemu) log_warn "no usable /dev/kvm -> virt_type=qemu (software emulation)."
              log_warn "  guests will be 10-50x slower; suitable only for a boot smoke test." ;;
        *)    die "VIRT_TYPE must be 'kvm' or 'qemu', got '$VIRT_TYPE'" ;;
    esac

    # --- resources ---
    local mem_kb mem_gb free_gb
    mem_kb="$(awk '/^MemTotal:/{print $2}' /proc/meminfo 2>/dev/null || echo 0)"
    mem_gb=$(( mem_kb / 1024 / 1024 ))
    if [ "$mem_gb" -lt 8 ]; then
        log_warn "memory ${mem_gb}GiB is below the 8GiB recommended for all-in-one"
    else
        log_ok "memory ${mem_gb}GiB"
    fi
    free_gb="$(df -BG --output=avail / 2>/dev/null | tail -1 | tr -dc '0-9' || echo 0)"
    if [ -n "$free_gb" ] && [ "$free_gb" -lt 20 ]; then
        log_warn "only ${free_gb}GiB free on /; 40GiB+ recommended once Glance images land"
    else
        log_ok "disk ${free_gb}GiB free on /"
    fi

    # --- required settings ---
    local missing=()
    [ -n "$EXT_NIC" ]          || missing+=("EXT_NIC")
    [ -n "$PROVIDER_CIDR" ]    || missing+=("PROVIDER_CIDR")
    [ -n "$PROVIDER_GATEWAY" ] || missing+=("PROVIDER_GATEWAY")
    [ -n "$FLOATING_START" ]   || missing+=("FLOATING_START")
    [ -n "$FLOATING_END" ]     || missing+=("FLOATING_END")
    if [ "${#missing[@]}" -gt 0 ]; then
        die "missing required settings: ${missing[*]}
     Set them on the command line, in the environment, or in ./hagistack.env
     (see hagistack.env.example). Run '${SELF##*/} --help' for the flags."
    fi

    valid_nic_name "$EXT_NIC" \
        || die "EXT_NIC '$EXT_NIC' is not a valid interface name
     (allowed: letters, digits, '_', '.', '-'; at most 15 characters)"
    if ! nic_exists "$EXT_NIC"; then
        local available
        available="$(ls /sys/class/net 2>/dev/null | tr '\n' ' ')"
        die "EXT_NIC '$EXT_NIC' does not exist on this host.
     interfaces present: ${available:-none}"
    fi
    log_ok "EXT_NIC $EXT_NIC exists"

    valid_cidr "$PROVIDER_CIDR" \
        || die "PROVIDER_CIDR '$PROVIDER_CIDR' is not a valid IPv4 CIDR (e.g. 172.24.4.0/24; prefix 8-30)"
    valid_ipv4 "$PROVIDER_GATEWAY" \
        || die "PROVIDER_GATEWAY '$PROVIDER_GATEWAY' is not a valid IPv4 address"
    valid_ipv4 "$FLOATING_START" \
        || die "FLOATING_START '$FLOATING_START' is not a valid IPv4 address"
    valid_ipv4 "$FLOATING_END" \
        || die "FLOATING_END '$FLOATING_END' is not a valid IPv4 address"

    ip_in_cidr "$PROVIDER_GATEWAY" "$PROVIDER_CIDR" \
        || die "PROVIDER_GATEWAY $PROVIDER_GATEWAY is outside PROVIDER_CIDR $PROVIDER_CIDR"
    ip_in_cidr "$FLOATING_START" "$PROVIDER_CIDR" \
        || die "FLOATING_START $FLOATING_START is outside PROVIDER_CIDR $PROVIDER_CIDR"
    ip_in_cidr "$FLOATING_END" "$PROVIDER_CIDR" \
        || die "FLOATING_END $FLOATING_END is outside PROVIDER_CIDR $PROVIDER_CIDR"
    [ "$(ip_to_int "$FLOATING_START")" -le "$(ip_to_int "$FLOATING_END")" ] \
        || die "FLOATING_START $FLOATING_START is above FLOATING_END $FLOATING_END"
    if ip_in_cidr "$PROVIDER_GATEWAY" "$PROVIDER_CIDR" \
       && [ "$(ip_to_int "$PROVIDER_GATEWAY")" -ge "$(ip_to_int "$FLOATING_START")" ] \
       && [ "$(ip_to_int "$PROVIDER_GATEWAY")" -le "$(ip_to_int "$FLOATING_END")" ]; then
        die "PROVIDER_GATEWAY $PROVIDER_GATEWAY falls inside the floating IP pool
     $FLOATING_START-$FLOATING_END; the gateway must be outside the pool"
    fi
    log_ok "provider network $PROVIDER_CIDR gw=$PROVIDER_GATEWAY pool=$FLOATING_START-$FLOATING_END"

    TENANT_CIDR="${TENANT_CIDR:-10.10.10.0/24}"
    valid_cidr "$TENANT_CIDR" || die "TENANT_CIDR '$TENANT_CIDR' is not a valid IPv4 CIDR"
    DNS_SERVER="${DNS_SERVER:-$PROVIDER_GATEWAY}"
    valid_ipv4 "$DNS_SERVER" || die "DNS_SERVER '$DNS_SERVER' is not a valid IPv4 address"
    REGION_NAME="${REGION_NAME:-RegionOne}"
    valid_region_name "$REGION_NAME" \
        || die "REGION_NAME '$REGION_NAME' is not valid
     (allowed: letters, digits, '.', '_', '-'; at most 64 characters)"
    PROVIDER_PHYSNET="${PROVIDER_PHYSNET:-physnet1}"
    valid_region_name "$PROVIDER_PHYSNET" \
        || die "PROVIDER_PHYSNET '$PROVIDER_PHYSNET' is not a valid label
     (allowed: letters, digits, '.', '_', '-')"
    PROVIDER_BRIDGE="${PROVIDER_BRIDGE:-br-ex}"
    valid_nic_name "$PROVIDER_BRIDGE" \
        || die "PROVIDER_BRIDGE '$PROVIDER_BRIDGE' is not a valid bridge name"

    # --- management IP ---
    if [ -z "$MGMT_IP" ]; then
        have ip || die "cannot autodetect MGMT_IP: iproute2 is not installed.
     Install iproute2 or pass --mgmt-ip explicitly."
        MGMT_IP="$(ip -4 -o route get 1.1.1.1 2>/dev/null | awk '{for(i=1;i<=NF;i++) if($i=="src") print $(i+1)}' | head -1 || true)"
    fi
    [ -n "$MGMT_IP" ] || die "could not determine MGMT_IP automatically; pass --mgmt-ip explicitly"
    valid_ipv4 "$MGMT_IP" || die "MGMT_IP '$MGMT_IP' is not a valid IPv4 address"
    log_ok "MGMT_IP $MGMT_IP"

    # --- single-NIC warning ---
    local mgmt_nic=""
    if have ip; then
        mgmt_nic="$(ip -4 -o addr show 2>/dev/null | awk -v ip="$MGMT_IP" '$4 ~ "^"ip"/" {print $2}' | head -1 || true)"
    else
        log_warn "iproute2 not available; skipping the single-NIC layout check"
    fi
    if [ -n "$mgmt_nic" ] && [ "$mgmt_nic" = "$EXT_NIC" ]; then
        log_warn "single-NIC layout: EXT_NIC ($EXT_NIC) also carries the management IP."
        log_warn "  A later step must move $MGMT_IP onto the br-ex bridge, which can drop your SSH session."
        log_warn "  Not performed in step 1. Use a console or a second NIC when that step lands."
    fi

    log_ok "preflight passed"
}

# ---------------------------------------------------------------------------
# secrets
#
# Generated once, stored 0600 outside the repo, and reused verbatim on every
# later run so that re-running never rotates a live credential.
# ---------------------------------------------------------------------------
# One credential per DB *user*. The `nova` user owns both the `nova` and the
# `nova_api` databases, so it has one password: generating a second one only
# produced an unused key, because `CREATE USER IF NOT EXISTS` for the second
# database is a no-op and the user keeps the first password.
SECRET_KEYS="MYSQL_ROOT_PASS RABBIT_PASS KEYSTONE_DB_PASS GLANCE_DB_PASS
             PLACEMENT_DB_PASS NOVA_DB_PASS NEUTRON_DB_PASS
             ADMIN_PASSWORD SERVICE_PASSWORD METADATA_PROXY_SECRET
             GLANCE_SERVICE_PASS PLACEMENT_SERVICE_PASS NEUTRON_SERVICE_PASS
             NOVA_SERVICE_PASS"

# Keys written by an earlier version that are no longer used. They are reported
# and then left alone: rewriting a live secrets file to drop a key is a bigger
# risk than carrying a stale line, and removing it could not rotate anything.
OBSOLETE_SECRET_KEYS="NOVA_API_DB_PASS"

phase_secrets() {
    log_step "secrets"
    $SUDO mkdir -p "$HAGISTACK_ETC"
    $SUDO chmod 0750 "$HAGISTACK_ETC"

    local created=0
    if [ ! -f "$SECRETS_FILE" ]; then
        log_info "generating $SECRETS_FILE"
        local tmp; tmp="$(mktemp)"
        chmod 0600 "$tmp"
        {
            echo "# hagistack secrets — generated $(date -u +%Y-%m-%dT%H:%M:%SZ)"
            echo "# Never commit this file. Never copy it into the repository."
            local k
            for k in $SECRET_KEYS; do
                printf '%s=%s\n' "$k" "$(gen_secret 32)"
            done
        } > "$tmp"
        $SUDO cp "$tmp" "$SECRETS_FILE"
        rm -f "$tmp"
        created=1
    fi
    $SUDO chmod 0600 "$SECRETS_FILE"
    $SUDO chown "$(id -u)":"$(id -g)" "$SECRETS_FILE" 2>/dev/null || true

    # Fill in any key added by a later version, without touching existing ones.
    local k added=0
    for k in $SECRET_KEYS; do
        if ! $SUDO grep -q "^${k}=" "$SECRETS_FILE"; then
            printf '%s=%s\n' "$k" "$(gen_secret 32)" | $SUDO tee -a "$SECRETS_FILE" >/dev/null
            added=$((added+1))
        fi
    done

    # shellcheck disable=SC1090
    . <($SUDO cat "$SECRETS_FILE")

    local ok
    for ok in ${OBSOLETE_SECRET_KEYS:-}; do
        if $SUDO grep -q "^${ok}=" "$SECRETS_FILE"; then
            log_warn "$SECRETS_FILE still contains '$ok', which this version no longer uses."
            log_warn "  It is left in place and ignored. The 'nova' user has a single"
            log_warn "  credential (NOVA_DB_PASS) covering both the nova and nova_api databases."
        fi
    done

    local perm; perm="$($SUDO stat -c '%a' "$SECRETS_FILE")"
    [ "$perm" = "600" ] || die "$SECRETS_FILE has mode $perm; expected 600"

    if [ "$created" -eq 1 ]; then
        log_ok "secrets created (mode $perm)"
    elif [ "$added" -gt 0 ]; then
        log_ok "secrets reused, $added new key(s) added (mode $perm)"
    else
        log_ok "secrets reused unchanged (mode $perm)"
    fi
    log_info "values are never printed and never written into the repository"
}

# ---------------------------------------------------------------------------
# base packages
# ---------------------------------------------------------------------------
phase_base_packages() {
    log_step "base packages"
    if phase_done base_packages && [ "${HAGISTACK_REDO:-0}" != "1" ]; then
        log_skip "already done (state marker); re-run with HAGISTACK_REDO=1 to force"
        return 0
    fi
    local pkgs="ca-certificates curl gnupg openssl chrony mariadb-server rabbitmq-server memcached python3-pymysql"
    log_info "apt-get update"
    $SUDO env DEBIAN_FRONTEND=noninteractive apt-get update -qq
    log_info "installing: $pkgs"
    # shellcheck disable=SC2086
    $SUDO env DEBIAN_FRONTEND=noninteractive apt-get install -y -qq $pkgs
    log_ok "base packages installed"
    phase_mark_done base_packages
}

# ---------------------------------------------------------------------------
# MariaDB
#
# The old shells issued an unconditional database drop on every run, which
# wiped a live cloud. Nothing here drops anything; a pre-existing database is
# detected and reused, and there is no flag to bypass that.
# ---------------------------------------------------------------------------
declare -A SERVICE_START_METHOD

# Phases that could not be carried out. A run with any of these is NOT a
# completed step 1, however far the rest of it got.
SKIPPED_PHASES=""
note_skip() {
    SKIPPED_PHASES="${SKIPPED_PHASES}${SKIPPED_PHASES:+ }$1"
    log_warn "phase '$1' SKIPPED: $2"
    log_warn "  -> this run will NOT be reported as a completed step 1"
}

# True only when we can positively observe the unit running.
service_active() {
    [ "$HAS_SYSTEMD" -eq 1 ] || return 1
    $SUDO systemctl is-active --quiet "$1"
}

# Raised from the stock 151: several OpenStack services with SQLAlchemy pools
# share this one server. Overridable for a constrained host.
MYSQL_MAX_CONNECTIONS="${HAGISTACK_MYSQL_MAX_CONNECTIONS:-1024}"

mysql_root() { $SUDO mariadb -uroot "$@"; }

# Reachability probes are bounded. `rabbitmqctl status` in particular can sit
# for many minutes on a node that is starting up or wedged, and an unbounded
# probe turns "service not ready" into "the installer hangs forever".
PROBE_TIMEOUT="${HAGISTACK_PROBE_TIMEOUT:-20}"
_probe() {
    # -k: escalate to SIGKILL. `rabbitmqctl` does not die on SIGTERM, so a
    # plain `timeout` waits forever on it — measured in a container where the
    # node never became ready.
    if have timeout; then $SUDO timeout -k 5 "$PROBE_TIMEOUT" "$@"
    else                  $SUDO "$@"
    fi
}
mariadb_reachable()  { _probe mariadb -uroot -e "SELECT 1" >/dev/null 2>&1; }
rabbitmq_reachable() { _probe rabbitmqctl status >/dev/null 2>&1; }
# A token cache that is not listening is worse than no token cache: every
# validation blocks on it. Plain TCP connect — no data exchange, so no race.
memcached_reachable() {
    _probe timeout 5 bash -c "exec 3<>/dev/tcp/${MGMT_IP}/11211" >/dev/null 2>&1
}

phase_database() {
    log_step "database (MariaDB)"

    local dbconf=/etc/mysql/mariadb.conf.d/99-hagistack.cnf
    local db_cfg_changed=0
    ini_set "$dbconf" mysqld bind-address "127.0.0.1" >/dev/null \
        && { db_cfg_changed=1; log_ok "bind-address pinned to 127.0.0.1"; } \
        || log_ok "bind-address already 127.0.0.1 (unchanged)"
    # An all-in-one runs Keystone, Glance, Placement (and later Nova/Neutron)
    # against one server, each with its own connection pool. The stock 151 is
    # not enough and shows up as HTTP 500 / "Too many connections".
    ini_set "$dbconf" mysqld max_connections "$MYSQL_MAX_CONNECTIONS" >/dev/null \
        && { db_cfg_changed=1; log_ok "max_connections set to $MYSQL_MAX_CONNECTIONS"; } \
        || log_ok "max_connections already $MYSQL_MAX_CONNECTIONS (unchanged)"

    service_start_enable mariadb
    if [ "$db_cfg_changed" = "1" ] && [ "$HAS_SYSTEMD" -eq 1 ] && service_active mariadb; then
        log_info "restarting mariadb so the new server settings take effect"
        $SUDO systemctl restart mariadb || die "mariadb failed to restart after a configuration change"
        log_ok "mariadb restarted"
    elif [ "$db_cfg_changed" = "1" ]; then
        log_warn "server settings changed but MariaDB was not restarted here"
        log_warn "  (no systemd). They take effect on the next restart."
    fi
    if ! mariadb_reachable; then
        note_skip database "MariaDB is not reachable (start method: ${SERVICE_START_METHOD[mariadb]}).
     Database and grant setup was NOT performed. Covered by the GCE acceptance (B0b)."
        return 0
    fi
    log_ok "MariaDB reachable (started via ${SERVICE_START_METHOD[mariadb]})"

    local db user
    # nova_cell0 holds instances that never reached a cell; nova derives its
    # name by appending _cell0 to the [database] connection, so it must be
    # exactly this and owned by the same nova credential.
    for db in keystone glance placement nova nova_api nova_cell0 neutron; do
        user="${db%%_*}"
        local passvar
        case "$db" in
            keystone) passvar="KEYSTONE_DB_PASS" ;;
            glance)   passvar="GLANCE_DB_PASS" ;;
            placement)passvar="PLACEMENT_DB_PASS" ;;
            nova)     passvar="NOVA_DB_PASS" ;;
            nova_api) passvar="NOVA_DB_PASS"; user="nova" ;;
            nova_cell0) passvar="NOVA_DB_PASS"; user="nova" ;;
            neutron)  passvar="NEUTRON_DB_PASS" ;;
        esac
        local pass="${!passvar}"

        if mysql_root -e "USE \`$db\`" >/dev/null 2>&1; then
            log_ok "database '$db' already exists — left untouched"
        else
            mysql_root -e "CREATE DATABASE \`$db\` CHARACTER SET utf8mb4;"
            log_ok "database '$db' created"
        fi
        # CREATE USER IF NOT EXISTS keeps an existing password intact.
        mysql_root -e "CREATE USER IF NOT EXISTS '$user'@'localhost' IDENTIFIED BY '$pass';"
        mysql_root -e "CREATE USER IF NOT EXISTS '$user'@'%' IDENTIFIED BY '$pass';"
        mysql_root -e "GRANT ALL PRIVILEGES ON \`$db\`.* TO '$user'@'localhost';"
        mysql_root -e "GRANT ALL PRIVILEGES ON \`$db\`.* TO '$user'@'%';"
    done
    mysql_root -e "FLUSH PRIVILEGES;"
    log_ok "databases and grants in place (no DROP was issued)"
    phase_mark_done database
}

# ---------------------------------------------------------------------------
# RabbitMQ
# ---------------------------------------------------------------------------
phase_rabbitmq() {
    log_step "message queue (RabbitMQ)"
    service_start_enable rabbitmq-server
    if ! rabbitmq_reachable; then
        note_skip rabbitmq "RabbitMQ is not reachable (start method: ${SERVICE_START_METHOD[rabbitmq-server]}).
     Queue user and permissions were NOT configured. Covered by the GCE acceptance (B0b)."
        return 0
    fi
    log_ok "RabbitMQ reachable (started via ${SERVICE_START_METHOD[rabbitmq-server]})"

    if $SUDO rabbitmqctl list_users 2>/dev/null | awk '{print $1}' | grep -qx openstack; then
        log_ok "rabbitmq user 'openstack' already exists — password left unchanged"
    else
        $SUDO rabbitmqctl add_user openstack "$RABBIT_PASS" >/dev/null
        log_ok "rabbitmq user 'openstack' created"
    fi
    $SUDO rabbitmqctl set_permissions openstack ".*" ".*" ".*" >/dev/null
    log_ok "rabbitmq permissions set"
    phase_mark_done rabbitmq
}

# ---------------------------------------------------------------------------
# memcached
# ---------------------------------------------------------------------------
phase_memcached() {
    log_step "cache (memcached)"
    # Listen on the management IP for Keystone/Horizon, never on 0.0.0.0.
    if [ -f /etc/memcached.conf ]; then
        if $SUDO grep -qE "^-l $MGMT_IP\$" /etc/memcached.conf; then
            log_ok "memcached already bound to $MGMT_IP (unchanged)"
        else
            $SUDO sed -i -E "s/^-l .*/-l $MGMT_IP/" /etc/memcached.conf
            log_ok "memcached bound to $MGMT_IP"
        fi
    fi
    service_start_enable memcached
    if service_active memcached; then
        log_ok "memcached active"
        phase_mark_done memcached
    else
        note_skip memcached "service is not running (start method: ${SERVICE_START_METHOD[memcached]})."
    fi
}

# ---------------------------------------------------------------------------
# Keystone (identity)
#
# Packaging facts verified against Ubuntu 26.04 (keystone 2:29.0.0-0ubuntu1.2),
# not assumed — see STEP2_KEYSTONE_EVIDENCE.md:
#
#   * The `keystone` binary package ships exactly one file:
#     /etc/apache2/sites-available/keystone.conf. There is NO keystone
#     systemd unit of any kind, and no uwsgi anywhere. Keystone is served by
#     **apache2.service** through libapache2-mod-wsgi-py3.
#   * That vhost carries its own `Listen 5000` and `<VirtualHost *:5000>`,
#     pointing at /usr/bin/keystone-wsgi-public. Installing the package also
#     enables the site, so /etc/apache2/sites-enabled/keystone.conf already
#     exists. There is no separate admin port (the old 35357 is long gone).
#   * /etc/keystone/keystone.conf comes from the `keystone-common` package,
#     mode 0640 keystone:keystone, and ships
#     `connection = sqlite:////var/lib/keystone/keystone.db` — which must be
#     replaced. `[token] provider` and `[credential] provider` already default
#     to fernet, so we set them explicitly only to pin the behaviour.
#   * Default key repositories are /etc/keystone/fernet-keys/ (created by the
#     package, 0700 keystone:keystone) and /etc/keystone/credential-keys/
#     (NOT created by the package).
#   * `keystone-manage bootstrap` accepts OS_BOOTSTRAP_* environment
#     variables, so the admin password never has to appear in argv.
# ---------------------------------------------------------------------------
KEYSTONE_CONF="/etc/keystone/keystone.conf"
KEYSTONE_FERNET_DIR="/etc/keystone/fernet-keys"
KEYSTONE_CRED_DIR="/etc/keystone/credential-keys"
ADMIN_OPENRC="$HAGISTACK_ETC/admin-openrc"

# Run a command as the keystone system user so that logs and key files do not
# end up owned by root.
as_keystone() {
    if have runuser; then $SUDO runuser -u keystone -- "$@"
    else                  $SUDO su -s /bin/sh -c "$(printf '%q ' "$@")" keystone
    fi
}

keystone_pkgs_installed() {
    dpkg-query -W -f='${Status}' keystone 2>/dev/null | grep -q "install ok installed" \
    && dpkg-query -W -f='${Status}' python3-openstackclient 2>/dev/null | grep -q "install ok installed"
}

# The identity endpoint answers. Bounded, like every other probe.
keystone_serving() {
    _probe curl -s -o /dev/null -m 10 "http://${MGMT_IP}:5000/v3" 2>/dev/null
}

phase_keystone() {
    log_step "identity (Keystone)"

    # --- packages -------------------------------------------------------
    if keystone_pkgs_installed; then
        log_ok "keystone and python3-openstackclient already installed"
    else
        log_info "installing keystone (pulls apache2 + libapache2-mod-wsgi-py3) and python3-openstackclient"
        $SUDO env DEBIAN_FRONTEND=noninteractive apt-get install -y -qq \
            keystone python3-openstackclient
        log_ok "packages installed"
    fi
    log_info "keystone $(dpkg-query -W -f='${Version}' keystone 2>/dev/null || echo '?') \
served by apache2 + mod_wsgi (no keystone systemd unit exists on Ubuntu)"

    # --- the database must be there before anything else ----------------
    if ! mariadb_reachable; then
        note_skip keystone "MariaDB is not reachable, so the identity schema cannot be created.
     Nothing was changed. Covered by the GCE acceptance (B0b)."
        return 0
    fi
    if ! mysql_root -e "USE keystone" >/dev/null 2>&1; then
        note_skip keystone "the 'keystone' database does not exist; the database phase did not complete."
        return 0
    fi

    # --- keystone.conf ---------------------------------------------------
    # The value carries the DB password, so it is never echoed. ini_set is a
    # shell function, so it forks no process whose argv could expose it.
    # 127.0.0.1, not MGMT_IP: the database phase pins MariaDB to
    # `bind-address = 127.0.0.1`, so anything aimed at the management address is
    # refused. all-in-one keeps Keystone on the same host as its database, and
    # loopback also keeps the credential off the wire.
    local conn="mysql+pymysql://keystone:${KEYSTONE_DB_PASS}@127.0.0.1/keystone?charset=utf8mb4"
    local changed=0
    ini_set "$KEYSTONE_CONF" database   connection "$conn"       && changed=1
    ini_set "$KEYSTONE_CONF" token      provider   fernet        && changed=1
    ini_set "$KEYSTONE_CONF" credential provider   fernet        && changed=1
    if [ "$changed" -eq 1 ]; then
        log_ok "keystone.conf updated (database credentials not shown)"
    else
        log_ok "keystone.conf already correct (unchanged)"
    fi
    $SUDO chown keystone:keystone "$KEYSTONE_CONF" 2>/dev/null || true
    $SUDO chmod 0640 "$KEYSTONE_CONF"

    # --- can Keystone actually reach the database the way it is configured? --
    # keystone-manage logs to its own file and writes nothing useful to stderr,
    # so probe first and fail with something actionable. The password goes in a
    # 0600 defaults file: not argv, not the environment.
    local dbf; dbf="$(mktemp)"; chmod 0600 "$dbf"
    printf '[client]\npassword=%s\n' "$KEYSTONE_DB_PASS" > "$dbf"
    if ! _probe mariadb --defaults-extra-file="$dbf" --protocol=TCP \
            -h 127.0.0.1 -ukeystone -e "SELECT 1" >/dev/null 2>&1; then
        rm -f "$dbf"
        # Consistent with every other unreachable-service path: report it and
        # leave the run incomplete (exit 4) rather than aborting. Nothing has
        # been changed beyond keystone.conf, which is idempotent.
        note_skip keystone "the keystone DB user cannot reach MariaDB over TCP at 127.0.0.1:3306.
     Keystone connects with mysql+pymysql, which needs a TCP listener; a server
     started with --skip-networking, or bound elsewhere, will refuse it.
     Check:  ss -ltn | grep 3306
             mariadb --protocol=TCP -h 127.0.0.1 -ukeystone -p -e 'SELECT 1'"
        return 0
    fi
    rm -f "$dbf"
    log_ok "keystone DB user can reach MariaDB over TCP on 127.0.0.1"

    # --- schema ----------------------------------------------------------
    local before after
    before="$(mysql_root -N -B -e \
        "SELECT COUNT(*) FROM information_schema.tables WHERE table_schema='keystone'" 2>/dev/null || echo 0)"
    log_info "running keystone-manage db_sync (idempotent migration)"
    local syncerr; syncerr="$(mktemp)"; chmod 0600 "$syncerr"
    if ! as_keystone keystone-manage db_sync 2>"$syncerr"; then
        log_error "keystone-manage db_sync failed. Diagnostics (credentials redacted):"
        # stderr is usually empty: keystone-manage logs to /var/log/keystone.
        {
            $SUDO cat "$syncerr" 2>/dev/null
            $SUDO tail -20 /var/log/keystone/keystone.log 2>/dev/null
        } | $SUDO sed "s/${KEYSTONE_DB_PASS}/<redacted>/g" \
          | grep -viE 'password|secret' | tail -12 | sed 's/^/     /' >&2
        rm -f "$syncerr"
        die "the identity schema could not be created.
     The usual cause is that [database] connection cannot reach MariaDB.
     The database phase pins MariaDB to 127.0.0.1, so the connection must
     use 127.0.0.1 as well. Check: mariadb -uroot -e 'SELECT 1'"
    fi
    rm -f "$syncerr"
    after="$(mysql_root -N -B -e \
        "SELECT COUNT(*) FROM information_schema.tables WHERE table_schema='keystone'" 2>/dev/null || echo 0)"
    if [ "$before" = "0" ]; then
        log_ok "identity schema created ($after tables)"
    elif [ "$before" = "$after" ]; then
        log_ok "identity schema already current ($after tables, unchanged)"
    else
        log_ok "identity schema migrated ($before -> $after tables)"
    fi

    # --- fernet / credential keys ----------------------------------------
    # Guarded: re-running fernet_setup on a live deployment must never rotate
    # keys, because that invalidates every issued token.
    if $SUDO test -s "$KEYSTONE_FERNET_DIR/0"; then
        log_ok "fernet token keys already present — not touched"
    else
        as_keystone keystone-manage fernet_setup \
            --keystone-user keystone --keystone-group keystone
        log_ok "fernet token keys created in $KEYSTONE_FERNET_DIR"
    fi
    if $SUDO test -s "$KEYSTONE_CRED_DIR/0"; then
        log_ok "credential keys already present — not touched"
    else
        as_keystone keystone-manage credential_setup \
            --keystone-user keystone --keystone-group keystone
        log_ok "credential keys created in $KEYSTONE_CRED_DIR"
    fi

    # --- bootstrap --------------------------------------------------------
    # Writes straight to the database, so it does not need Apache running.
    # The password goes through the environment, never argv.
    local auth_url="http://${MGMT_IP}:5000/v3/"
    log_info "keystone-manage bootstrap (admin user, project, role, endpoints)"
    $SUDO env \
        OS_BOOTSTRAP_PASSWORD="$ADMIN_PASSWORD" \
        OS_BOOTSTRAP_USERNAME=admin \
        OS_BOOTSTRAP_PROJECT_NAME=admin \
        OS_BOOTSTRAP_ROLE_NAME=admin \
        OS_BOOTSTRAP_SERVICE_NAME=keystone \
        OS_BOOTSTRAP_REGION_ID="$REGION_NAME" \
        OS_BOOTSTRAP_PUBLIC_URL="$auth_url" \
        OS_BOOTSTRAP_INTERNAL_URL="$auth_url" \
        OS_BOOTSTRAP_ADMIN_URL="$auth_url" \
        keystone-manage bootstrap
    log_ok "bootstrap applied (idempotent; the stored admin password is reused, never regenerated)"

    # --- admin credentials file ------------------------------------------
    write_admin_openrc

    # --- serve it ----------------------------------------------------------
    configure_apache_servername
    $SUDO a2ensite keystone >/dev/null 2>&1 || true

    if [ "$HAS_SYSTEMD" -eq 1 ]; then
        if service_active apache2; then
            $SUDO systemctl reload-or-restart apache2 \
                || die "apache2 failed to reload after the keystone configuration change"
            log_ok "apache2 reloaded"
        else
            service_start_enable apache2
        fi
    else
        service_start_enable apache2
    fi

    if ! service_active apache2; then
        note_skip keystone "apache2 is not running, so the identity endpoint is not being served.
     The schema, fernet keys, credential keys and bootstrap ARE in place, but an
     administrator cannot authenticate yet. Startup under systemd is a GCE
     acceptance item (B0a/B0b)."
        return 0
    fi

    if ! keystone_serving; then
        note_skip keystone "apache2 is active but http://${MGMT_IP}:5000/v3 did not answer."
        return 0
    fi
    log_ok "identity endpoint answering on http://${MGMT_IP}:5000/v3"

    # --- prove an administrator can actually authenticate -------------------
    if openstack_admin token issue >/dev/null 2>&1; then
        log_ok "admin authentication verified (token issued; value not shown)"
    else
        note_skip keystone "the identity endpoint answers but 'openstack token issue' failed as admin."
        return 0
    fi

    phase_mark_done keystone
}

# ServerName keeps apache from complaining that it cannot determine the FQDN.
configure_apache_servername() {
    local f=/etc/apache2/conf-available/hagistack-servername.conf
    local want="ServerName ${MGMT_IP}"
    if $SUDO test -f "$f" && [ "$($SUDO cat "$f")" = "$want" ]; then
        log_ok "apache ServerName already set (unchanged)"
    else
        printf '%s\n' "$want" | $SUDO tee "$f" >/dev/null
        log_ok "apache ServerName set to $MGMT_IP"
    fi
    $SUDO a2enconf hagistack-servername >/dev/null 2>&1 || true
}

# The admin credentials live outside the repository, 0600, and are rewritten
# only when their content would actually change.
write_admin_openrc() {
    local tmp; tmp="$(mktemp)"; chmod 0600 "$tmp"
    cat > "$tmp" <<RCEOF
# hagistack admin credentials — generated, do not commit.
export OS_AUTH_URL=http://${MGMT_IP}:5000/v3
export OS_IDENTITY_API_VERSION=3
export OS_PROJECT_DOMAIN_NAME=Default
export OS_USER_DOMAIN_NAME=Default
export OS_PROJECT_NAME=admin
export OS_USERNAME=admin
export OS_PASSWORD=${ADMIN_PASSWORD}
export OS_REGION_NAME=${REGION_NAME}
RCEOF
    if $SUDO cmp -s "$tmp" "$ADMIN_OPENRC" 2>/dev/null; then
        log_ok "$ADMIN_OPENRC already current (unchanged)"
    else
        $SUDO cp "$tmp" "$ADMIN_OPENRC"
        log_ok "admin credentials written to $ADMIN_OPENRC"
    fi
    rm -f "$tmp"
    $SUDO chmod 0600 "$ADMIN_OPENRC"
    local perm; perm="$($SUDO stat -c '%a' "$ADMIN_OPENRC")"
    [ "$perm" = "600" ] || die "$ADMIN_OPENRC has mode $perm; expected 600"
}

# Run the openstack client as admin. Credentials go through the environment so
# that they never appear in argv or in any log line.
openstack_admin() {
    $SUDO env \
        OS_AUTH_URL="http://${MGMT_IP}:5000/v3" \
        OS_IDENTITY_API_VERSION=3 \
        OS_PROJECT_DOMAIN_NAME=Default \
        OS_USER_DOMAIN_NAME=Default \
        OS_PROJECT_NAME=admin \
        OS_USERNAME=admin \
        OS_PASSWORD="$ADMIN_PASSWORD" \
        OS_REGION_NAME="$REGION_NAME" \
        openstack "$@"
}

# ---------------------------------------------------------------------------
# Keystone registration helpers
#
# Every one is show-or-create: an existing user, service or endpoint is reused,
# never deleted and never recreated. Passwords go through the environment.
# ---------------------------------------------------------------------------
ks_ensure_project() {
    if openstack_admin project show "$1" >/dev/null 2>&1; then
        log_ok "project '$1' already exists"
    else
        openstack_admin project create --domain default "$1" >/dev/null
        log_ok "project '$1' created"
    fi
}

# ks_ensure_user <name> <password-value>
ks_ensure_user() {
    local name="$1" pass="$2"
    if openstack_admin user show "$name" >/dev/null 2>&1; then
        log_ok "service user '$name' already exists — password left unchanged"
    else
        # --password-prompt would block; the value is passed as an argument to a
        # function, which forks no process, and openstack reads it from stdin.
        printf '%s\n' "$pass" | openstack_admin user create --domain default \
            --password-prompt "$name" >/dev/null 2>&1 \
            || openstack_admin user create --domain default --password "$pass" "$name" >/dev/null
        log_ok "service user '$name' created"
    fi
}

ks_ensure_role_assignment() {
    local user="$1" project="$2" role="$3"
    if openstack_admin role assignment list --user "$user" --project "$project" \
         --role "$role" --names -f value 2>/dev/null | grep -q .; then
        log_ok "role '$role' already granted to '$user' on '$project'"
    else
        openstack_admin role add --project "$project" --user "$user" "$role" >/dev/null
        log_ok "role '$role' granted to '$user' on '$project'"
    fi
}

# ks_ensure_service <name> <type> <description>
ks_ensure_service() {
    if openstack_admin service show "$1" >/dev/null 2>&1; then
        log_ok "service '$1' already registered"
    else
        openstack_admin service create --name "$1" --description "$3" "$2" >/dev/null
        log_ok "service '$1' (type $2) registered"
    fi
}

# ks_ensure_endpoint <service> <interface> <url>
ks_ensure_endpoint() {
    local svc="$1" iface="$2" url="$3" existing
    existing="$(openstack_admin endpoint list --service "$svc" --interface "$iface" \
                  --region "$REGION_NAME" -f value -c URL 2>/dev/null | head -1)"
    if [ -n "$existing" ]; then
        if [ "$existing" = "$url" ]; then
            log_ok "endpoint $svc/$iface already correct"
        else
            log_warn "endpoint $svc/$iface exists with a different URL and is left as-is:"
            log_warn "  current: $existing"
            log_warn "  wanted : $url"
            log_warn "  hagistack does not delete endpoints; fix it by hand if that is wrong."
        fi
    else
        openstack_admin endpoint create --region "$REGION_NAME" "$svc" "$iface" "$url" >/dev/null
        log_ok "endpoint $svc/$iface created"
    fi
}

# Common [keystone_authtoken] block for a service. The password is written into
# a root-owned 0640 config file and is never echoed.
write_authtoken() {
    local conf="$1" user="$2" pass="$3"
    ini_set "$conf" keystone_authtoken www_authenticate_uri "http://${MGMT_IP}:5000" >/dev/null || true
    ini_set "$conf" keystone_authtoken auth_url             "http://${MGMT_IP}:5000" >/dev/null || true
    # Always written, so the file is byte-identical on every run. The phases
    # refuse to run at all unless memcached is actually listening, so this can
    # never point at a dead cache (which would block every token validation).
    ini_set "$conf" keystone_authtoken memcached_servers "${MGMT_IP}:11211" >/dev/null || true
    ini_set "$conf" keystone_authtoken auth_type            password                 >/dev/null || true
    ini_set "$conf" keystone_authtoken project_domain_name  Default                  >/dev/null || true
    ini_set "$conf" keystone_authtoken user_domain_name     Default                  >/dev/null || true
    ini_set "$conf" keystone_authtoken project_name         service                  >/dev/null || true
    ini_set "$conf" keystone_authtoken username             "$user"                  >/dev/null || true
    ini_set "$conf" keystone_authtoken password             "$pass"                  >/dev/null || true
}

# Guard shared by the Glance and Placement phases: the identity service has to
# be answering before anything can be registered against it.
keystone_ready_for_registration() {
    keystone_serving && openstack_admin token issue >/dev/null 2>&1
}

# ---------------------------------------------------------------------------
# Glance (image service)
#
# Packaging verified on Ubuntu 26.04 (glance 2:32.0.0-0ubuntu1), not assumed —
# see STEP3_GLANCE_PLACEMENT_EVIDENCE.md:
#   * Unlike Keystone, Glance DOES ship its own unit:
#     /usr/lib/systemd/system/glance-api.service (User=glance, Group=glance).
#     There is no Apache vhost for Glance at all.
#   * /etc/glance/glance-api.conf comes from `glance-common`, mode 0640
#     root:glance, and ships connection = sqlite:////var/lib/glance/glance.sqlite.
#   * bind_port has NO default (`#bind_port = <None>`), so it must be set
#     explicitly or Glance will not listen on 9292.
#   * The store is the multi-backend layout: [DEFAULT] enabled_backends,
#     [glance_store] default_backend, [file] filesystem_store_datadir.
#     /var/lib/glance/images already exists as glance:glance 0750.
#   * Both `glance-manage db_sync` and `glance-manage db sync` are accepted.
# ---------------------------------------------------------------------------
GLANCE_CONF="/etc/glance/glance-api.conf"
GLANCE_PORT=9292

glance_serving() {
    _probe curl -s -o /dev/null -m 10 "http://${MGMT_IP}:${GLANCE_PORT}/" 2>/dev/null
}

phase_glance() {
    log_step "image service (Glance)"

    if dpkg-query -W -f='${Status}' glance 2>/dev/null | grep -q "install ok installed"; then
        log_ok "glance already installed"
    else
        log_info "installing glance"
        $SUDO env DEBIAN_FRONTEND=noninteractive apt-get install -y -qq glance
        log_ok "glance installed"
    fi
    log_info "glance $(dpkg-query -W -f='${Version}' glance 2>/dev/null || echo '?') \
served by glance-api.service (its own unit; Glance has no Apache vhost)"

    if ! mariadb_reachable; then
        note_skip glance "MariaDB is not reachable; the image schema cannot be created."
        return 0
    fi
    if ! mysql_root -e "USE glance" >/dev/null 2>&1; then
        note_skip glance "the 'glance' database does not exist; the database phase did not complete."
        return 0
    fi
    if ! keystone_ready_for_registration; then
        note_skip glance "Keystone is not answering, so the image service cannot be registered.
     Glance was not configured. Bring identity up first."
        return 0
    fi
    if ! memcached_reachable; then
        note_skip glance "memcached is not listening on ${MGMT_IP}:11211.
     Glance's token validation is configured to use it, so configuring Glance
     against a dead cache would make every authenticated call block. Nothing
     was changed. Bring the cache up (it is part of the base layer) and re-run."
        return 0
    fi

    # --- configuration ---------------------------------------------------
    local changed=0
    ini_set "$GLANCE_CONF" database connection \
        "mysql+pymysql://glance:${GLANCE_DB_PASS}@127.0.0.1/glance?charset=utf8mb4" && changed=1
    ini_set "$GLANCE_CONF" DEFAULT bind_host        "$MGMT_IP"       && changed=1
    ini_set "$GLANCE_CONF" DEFAULT bind_port        "$GLANCE_PORT"   && changed=1
    ini_set "$GLANCE_CONF" DEFAULT enabled_backends "file:file"      && changed=1
    ini_set "$GLANCE_CONF" glance_store default_backend file         && changed=1
    ini_set "$GLANCE_CONF" file filesystem_store_datadir /var/lib/glance/images && changed=1
    ini_set "$GLANCE_CONF" paste_deploy flavor keystone              && changed=1
    write_authtoken "$GLANCE_CONF" glance "$GLANCE_SERVICE_PASS"
    if [ "$changed" -eq 1 ]; then
        log_ok "glance-api.conf updated (credentials not shown)"
    else
        log_ok "glance-api.conf already correct (unchanged)"
    fi
    # The package ships this file root:glance 0640 — keep it that way.
    $SUDO chown root:glance "$GLANCE_CONF" 2>/dev/null || true
    $SUDO chmod 0640 "$GLANCE_CONF"

    # --- schema ------------------------------------------------------------
    local before after
    before="$(mysql_root -N -B -e \
        "SELECT COUNT(*) FROM information_schema.tables WHERE table_schema='glance'" 2>/dev/null || echo 0)"
    log_info "running glance-manage db_sync (idempotent migration)"
    local gerr; gerr="$(mktemp)"; chmod 0600 "$gerr"
    if ! $SUDO runuser -u glance -- glance-manage db_sync >"$gerr" 2>&1; then
        log_error "glance-manage db_sync failed. Diagnostics (credentials redacted):"
        $SUDO sed "s/${GLANCE_DB_PASS}/<redacted>/g; s/${GLANCE_SERVICE_PASS}/<redacted>/g" "$gerr" \
          | grep -viE 'password|secret' | tail -12 | sed 's/^/     /' >&2
        rm -f "$gerr"
        note_skip glance "the image schema could not be created (see the diagnostics above)."
        return 0
    fi
    rm -f "$gerr"
    after="$(mysql_root -N -B -e \
        "SELECT COUNT(*) FROM information_schema.tables WHERE table_schema='glance'" 2>/dev/null || echo 0)"
    if [ "$before" = "0" ]; then log_ok "image schema created ($after tables)"
    elif [ "$before" = "$after" ]; then log_ok "image schema already current ($after tables, unchanged)"
    else log_ok "image schema migrated ($before -> $after tables)"; fi

    # --- identity registration ---------------------------------------------
    ks_ensure_project service
    ks_ensure_user glance "$GLANCE_SERVICE_PASS"
    ks_ensure_role_assignment glance service admin
    ks_ensure_service glance image "OpenStack Image"
    local url="http://${MGMT_IP}:${GLANCE_PORT}"
    ks_ensure_endpoint glance public   "$url"
    ks_ensure_endpoint glance internal "$url"
    ks_ensure_endpoint glance admin    "$url"

    # --- run it --------------------------------------------------------------
    if [ "$HAS_SYSTEMD" -eq 1 ] && service_active glance-api; then
        $SUDO systemctl restart glance-api || die "glance-api failed to restart"
        log_ok "glance-api restarted"
    else
        service_start_enable glance-api
    fi
    if ! service_active glance-api; then
        note_skip glance "glance-api is not running, so the image API is not being served.
     The schema, configuration and identity registration ARE in place.
     Startup under systemd is a GCE acceptance item (B0a/B0b)."
        return 0
    fi
    if ! glance_serving; then
        note_skip glance "glance-api is active but http://${MGMT_IP}:${GLANCE_PORT}/ did not answer."
        return 0
    fi
    if ! openstack_admin image list >/dev/null 2>&1; then
        note_skip glance "the image endpoint answers but 'openstack image list' failed as admin."
        return 0
    fi
    log_ok "image API verified (openstack image list succeeded)"
    phase_mark_done glance
}

# ---------------------------------------------------------------------------
# Placement
#
# Packaging verified on Ubuntu 26.04 (placement-api 1:15.0.0-0ubuntu1):
#   * placement-api ships exactly TWO files: the Apache vhost
#     /etc/apache2/sites-available/placement-api.conf and /usr/bin/placement-api.
#     There is NO placement systemd unit — like Keystone, it runs under
#     apache2.service, on a second vhost alongside identity.
#   * That vhost carries its own `Listen 8778` and <VirtualHost *:8778>, and the
#     package enables the site on install.
#   * /etc/placement/placement.conf comes from `placement-common`, 0640
#     root:placement, and its database key is [placement_database] connection —
#     NOT [database]. Writing to [database] would silently leave it on sqlite.
#   * The migration command is `placement-manage db sync`; `db_sync` is NOT a
#     valid subcommand here (it is for glance-manage — the two differ).
# ---------------------------------------------------------------------------
PLACEMENT_CONF="/etc/placement/placement.conf"
PLACEMENT_PORT=8778

placement_serving() {
    _probe curl -s -o /dev/null -m 10 "http://${MGMT_IP}:${PLACEMENT_PORT}/" 2>/dev/null
}

phase_placement() {
    log_step "placement service"

    if dpkg-query -W -f='${Status}' placement-api 2>/dev/null | grep -q "install ok installed"; then
        log_ok "placement-api already installed"
    else
        log_info "installing placement-api (Apache vhost + WSGI entry point)"
        $SUDO env DEBIAN_FRONTEND=noninteractive apt-get install -y -qq placement-api
        log_ok "placement-api installed"
    fi
    log_info "placement $(dpkg-query -W -f='${Version}' placement-api 2>/dev/null || echo '?') \
served by apache2 + mod_wsgi on :${PLACEMENT_PORT} (no placement systemd unit exists)"

    if ! mariadb_reachable; then
        note_skip placement "MariaDB is not reachable; the placement schema cannot be created."
        return 0
    fi
    if ! mysql_root -e "USE placement" >/dev/null 2>&1; then
        note_skip placement "the 'placement' database does not exist; the database phase did not complete."
        return 0
    fi
    if ! keystone_ready_for_registration; then
        note_skip placement "Keystone is not answering, so placement cannot be registered."
        return 0
    fi
    if ! memcached_reachable; then
        note_skip placement "memcached is not listening on ${MGMT_IP}:11211; see the glance
     phase for why configuring against a dead token cache is refused."
        return 0
    fi

    # --- configuration -------------------------------------------------------
    # NOTE the section name: [placement_database], not [database].
    local changed=0
    ini_set "$PLACEMENT_CONF" placement_database connection \
        "mysql+pymysql://placement:${PLACEMENT_DB_PASS}@127.0.0.1/placement?charset=utf8mb4" && changed=1
    ini_set "$PLACEMENT_CONF" api auth_strategy keystone && changed=1
    write_authtoken "$PLACEMENT_CONF" placement "$PLACEMENT_SERVICE_PASS"
    if [ "$changed" -eq 1 ]; then
        log_ok "placement.conf updated (credentials not shown)"
    else
        log_ok "placement.conf already correct (unchanged)"
    fi
    $SUDO chown root:placement "$PLACEMENT_CONF" 2>/dev/null || true
    $SUDO chmod 0640 "$PLACEMENT_CONF"

    # --- schema ---------------------------------------------------------------
    local before after
    before="$(mysql_root -N -B -e \
        "SELECT COUNT(*) FROM information_schema.tables WHERE table_schema='placement'" 2>/dev/null || echo 0)"
    log_info "running placement-manage db sync (idempotent migration)"
    local perr; perr="$(mktemp)"; chmod 0600 "$perr"
    if ! $SUDO runuser -u placement -- placement-manage db sync >"$perr" 2>&1; then
        log_error "placement-manage db sync failed. Diagnostics (credentials redacted):"
        $SUDO sed "s/${PLACEMENT_DB_PASS}/<redacted>/g; s/${PLACEMENT_SERVICE_PASS}/<redacted>/g" "$perr" \
          | grep -viE 'password|secret' | tail -12 | sed 's/^/     /' >&2
        rm -f "$perr"
        note_skip placement "the placement schema could not be created (see the diagnostics above)."
        return 0
    fi
    rm -f "$perr"
    after="$(mysql_root -N -B -e \
        "SELECT COUNT(*) FROM information_schema.tables WHERE table_schema='placement'" 2>/dev/null || echo 0)"
    if [ "$before" = "0" ]; then log_ok "placement schema created ($after tables)"
    elif [ "$before" = "$after" ]; then log_ok "placement schema already current ($after tables, unchanged)"
    else log_ok "placement schema migrated ($before -> $after tables)"; fi

    # --- identity registration -------------------------------------------------
    ks_ensure_project service
    ks_ensure_user placement "$PLACEMENT_SERVICE_PASS"
    ks_ensure_role_assignment placement service admin
    ks_ensure_service placement placement "Placement API"
    local url="http://${MGMT_IP}:${PLACEMENT_PORT}"
    ks_ensure_endpoint placement public   "$url"
    ks_ensure_endpoint placement internal "$url"
    ks_ensure_endpoint placement admin    "$url"

    # --- serve it ----------------------------------------------------------------
    $SUDO a2ensite placement-api >/dev/null 2>&1 || true
    if [ "$HAS_SYSTEMD" -eq 1 ] && service_active apache2; then
        $SUDO systemctl reload-or-restart apache2 \
            || die "apache2 failed to reload after the placement configuration change"
        log_ok "apache2 reloaded (now serving identity on 5000 and placement on ${PLACEMENT_PORT})"
    else
        service_start_enable apache2
    fi
    if ! service_active apache2; then
        note_skip placement "apache2 is not running, so the placement API is not being served.
     The schema, configuration and identity registration ARE in place.
     Startup under systemd is a GCE acceptance item (B0a/B0b)."
        return 0
    fi
    if ! placement_serving; then
        note_skip placement "apache2 is active but http://${MGMT_IP}:${PLACEMENT_PORT}/ did not answer."
        return 0
    fi
    if ! placement_api_authenticated; then
        note_skip placement "the placement endpoint answers but an authenticated request failed."
        return 0
    fi
    log_ok "placement API verified (authenticated /resource_providers answered)"
    phase_mark_done placement
}

# An authenticated GET against /resource_providers. The token goes into a 0600
# curl config file rather than argv, so it never shows up in the process list.
placement_api_authenticated() {
    local tok cfg rc
    tok="$(openstack_admin token issue -f value -c id 2>/dev/null)" || return 1
    [ -n "$tok" ] || return 1
    cfg="$(mktemp)"; chmod 0600 "$cfg"
    printf 'header = "X-Auth-Token: %s"\nheader = "OpenStack-API-Version: placement latest"\n' "$tok" > "$cfg"
    _probe curl -sS -m 15 -o /dev/null -w '%{http_code}' -K "$cfg" \
        "http://${MGMT_IP}:${PLACEMENT_PORT}/resource_providers" 2>/dev/null | grep -q '^200$'
    rc=$?
    rm -f "$cfg"
    return $rc
}

# ---------------------------------------------------------------------------
# OVN (network infrastructure)
#
# Packaging verified on Ubuntu 26.04, not assumed — see
# STEP4_NEUTRON_OVN_EVIDENCE.md. openvswitch-switch 3.7.1-2, ovn-central and
# ovn-host 26.03.0-2:
#   * `ovn-central.service` and `ovn-host.service` are oneshot wrappers whose
#     ExecStart is /bin/true. They only pull real units in via Wants=:
#       ovn-central -> ovn-ovsdb-server-nb, ovn-ovsdb-server-sb, ovn-northd
#       ovn-host    -> ovn-controller
#     So liveness must be checked on the real units, never on the wrapper.
#   * Startup order comes from the units' own After=:
#       openvswitch-switch -> ovn-ovsdb-server-nb/sb -> ovn-northd -> ovn-controller
#   * The DB servers run with --ovn-manage-ovsdb=no, i.e. they are owned by
#     their own units rather than spawned by northd/controller.
#   * /etc/ovn, /var/lib/ovn, /var/log/ovn and /var/run/ovn do NOT exist until
#     the first start; nothing may assume them.
#   * The NB/SB servers listen on unix sockets only until a connection is set,
#     while ml2's defaults point at tcp:127.0.0.1:6641/6642 — so the listeners
#     have to be established explicitly.
#
# Three concerns are kept deliberately separate:
#   management network  MGMT_IP          API/RPC/OVN southbound reachability
#   Geneve overlay      ovn-encap-ip     inter-node tunnels (compute-add later)
#   provider network    PROVIDER_PHYSNET:PROVIDER_BRIDGE   bridge mapping only
#
# This phase creates the provider bridge but attaches NO port and assigns NO
# address. Enslaving a NIC or moving the management IP onto the bridge is a
# separate, disruptive step and is deliberately not performed here.
# ---------------------------------------------------------------------------
OVN_NB_PORT=6641
OVN_SB_PORT=6642

ovs_vsctl() { _probe ovs-vsctl "$@"; }
ovn_nbctl()  { _probe ovn-nbctl "$@"; }
ovn_sbctl()  { _probe ovn-sbctl "$@"; }

# The real daemons behind the oneshot wrappers.
OVN_CENTRAL_UNITS="ovn-ovsdb-server-nb ovn-ovsdb-server-sb ovn-northd"
OVN_HOST_UNITS="ovn-controller"

ovn_nb_ready() { ovn_nbctl --timeout=10 show >/dev/null 2>&1; }
ovn_sb_ready() { ovn_sbctl --timeout=10 show >/dev/null 2>&1; }
ovs_ready()    { ovs_vsctl --timeout=10 show >/dev/null 2>&1; }

phase_ovn() {
    log_step "network infrastructure (OVS + OVN)"

    local pkgs="openvswitch-switch ovn-central ovn-host"
    local absent=""
    local p
    for p in $pkgs; do
        dpkg-query -W -f='${Status}' "$p" 2>/dev/null | grep -q "install ok installed" || absent="$absent $p"
    done
    if [ -n "$absent" ]; then
        log_info "installing:$absent"
        # shellcheck disable=SC2086
        $SUDO env DEBIAN_FRONTEND=noninteractive apt-get install -y -qq $pkgs
        log_ok "OVS and OVN installed"
    else
        log_ok "OVS and OVN already installed"
    fi
    log_info "openvswitch $(dpkg-query -W -f='${Version}' openvswitch-switch 2>/dev/null || echo '?'), \
ovn $(dpkg-query -W -f='${Version}' ovn-central 2>/dev/null || echo '?')"
    log_info "ovn-central/ovn-host are oneshot wrappers; the real units are:"
    log_info "  $OVN_CENTRAL_UNITS $OVN_HOST_UNITS"

    # --- start the data/control plane, in the order the units declare -------
    if [ "$HAS_SYSTEMD" -eq 1 ]; then
        service_start_enable openvswitch-switch
        local u
        for u in $OVN_CENTRAL_UNITS $OVN_HOST_UNITS; do service_start_enable "$u"; done
    else
        log_warn "systemd is not running here; OVS/OVN cannot be started as managed services"
        log_warn "  -> unit startup and ordering stay a GCE acceptance item (B0a/B0b)"
    fi

    if ! ovs_ready; then
        note_skip ovn "the Open vSwitch database is not answering (ovs-vsctl show failed).
     Nothing was configured. OVS must be running before OVN can be set up."
        return 0
    fi
    log_ok "Open vSwitch database reachable"

    if ! ovn_nb_ready || ! ovn_sb_ready; then
        note_skip ovn "the OVN northbound/southbound databases are not answering.
     Checked the real units ($OVN_CENTRAL_UNITS), not the oneshot wrapper.
     Nothing was configured."
        return 0
    fi
    log_ok "OVN northbound and southbound databases reachable"

    # --- OVN DB listeners --------------------------------------------------
    # Northbound stays on loopback: only the local Neutron talks to it.
    # Southbound listens on the management address because compute nodes will
    # need it at compute-add.
    local want_nb="ptcp:${OVN_NB_PORT}:127.0.0.1"
    local want_sb="ptcp:${OVN_SB_PORT}:${MGMT_IP}"
    local have_nb have_sb
    # Read the target column, not `get-connection`: on the southbound DB the
    # latter also prints the role and read-write flags, so a plain string
    # comparison against it never matches and the listener would be re-set on
    # every run. Measured: `read-write role="" ptcp:6642:<ip>`.
    have_nb="$(ovn_nbctl --bare --columns=target list connection 2>/dev/null | tr -d '[:space:]')"
    have_sb="$(ovn_sbctl --bare --columns=target list connection 2>/dev/null | tr -d '[:space:]')"
    if [ "$have_nb" = "$want_nb" ]; then
        log_ok "OVN northbound listener already $want_nb"
    else
        ovn_nbctl set-connection "$want_nb" || die "could not set the OVN northbound listener"
        log_ok "OVN northbound listener set to $want_nb"
    fi
    if [ "$have_sb" = "$want_sb" ]; then
        log_ok "OVN southbound listener already $want_sb"
    else
        ovn_sbctl set-connection "$want_sb" || die "could not set the OVN southbound listener"
        log_ok "OVN southbound listener set to $want_sb (reachable by future compute nodes)"
    fi

    # --- provider bridge: created, but deliberately left empty -------------
    if ovs_vsctl br-exists "$PROVIDER_BRIDGE" 2>/dev/null; then
        log_ok "provider bridge $PROVIDER_BRIDGE already exists"
    else
        ovs_vsctl --may-exist add-br "$PROVIDER_BRIDGE" \
            || die "could not create the provider bridge $PROVIDER_BRIDGE"
        log_ok "provider bridge $PROVIDER_BRIDGE created"
    fi
    local ports
    ports="$(ovs_vsctl list-ports "$PROVIDER_BRIDGE" 2>/dev/null | tr '\n' ' ')"
    log_info "ports on $PROVIDER_BRIDGE: ${ports:-<none, by design>}"
    log_warn "no NIC is enslaved to $PROVIDER_BRIDGE and no address is assigned to it."
    log_warn "  Attaching a physical NIC and moving the management IP is a separate,"
    log_warn "  disruptive step that hagistack does not perform here. Until it is done,"
    log_warn "  provider networks exist in Neutron but have no path to a physical LAN."

    # --- local chassis configuration ---------------------------------------
    # ovn-encap-ip is the Geneve tunnel endpoint: the management address.
    # ovn-bridge-mappings is the provider-network concern, kept separate.
    _ovs_extid() {  # _ovs_extid <key> <value>
        local cur
        cur="$(ovs_vsctl --if-exists get open_vswitch . "external_ids:$1" 2>/dev/null | tr -d '"')"
        if [ "$cur" = "$2" ]; then return 1; fi
        ovs_vsctl set open_vswitch . "external_ids:$1=$2"
        return 0
    }
    local changed=0
    _ovs_extid ovn-remote        "tcp:${MGMT_IP}:${OVN_SB_PORT}"            && changed=1
    _ovs_extid ovn-encap-type    geneve                                     && changed=1
    _ovs_extid ovn-encap-ip      "$MGMT_IP"                                 && changed=1
    _ovs_extid ovn-bridge-mappings "${PROVIDER_PHYSNET}:${PROVIDER_BRIDGE}" && changed=1
    _ovs_extid ovn-cms-options   enable-chassis-as-gw                       && changed=1
    if [ "$changed" -eq 1 ]; then
        log_ok "local chassis configured (ovn-remote, geneve encap on $MGMT_IP, ${PROVIDER_PHYSNET}:${PROVIDER_BRIDGE})"
    else
        log_ok "local chassis already configured (unchanged)"
    fi

    # --- did this host register itself as a chassis? ------------------------
    local sysid chassis
    sysid="$(ovs_vsctl --if-exists get open_vswitch . external_ids:system-id 2>/dev/null | tr -d '"')"
    chassis="$(ovn_sbctl --bare --columns=name list chassis 2>/dev/null | tr '\n' ' ')"
    if [ -n "$chassis" ]; then
        log_ok "chassis registered in the OVN southbound DB: $chassis"
    else
        log_warn "no chassis is registered in the southbound DB yet (system-id: ${sysid:-unset})."
        log_warn "  ovn-controller may still be starting, or it cannot reach ${MGMT_IP}:${OVN_SB_PORT}."
    fi

    phase_mark_done ovn
}

# ---------------------------------------------------------------------------
# Neutron (networking API)
#
# Packaging verified on Ubuntu 26.04 (neutron 2:28.0.2-0ubuntu1):
#   * The API is served by Apache: the `neutron-api` package (NOT
#     neutron-server) ships /etc/apache2/sites-available/neutron-api.conf with
#     its own `Listen 9696` and WSGIScriptAlias to
#     /usr/share/neutron/neutron-api.wsgi, and the site is enabled on install.
#     `neutron-server` itself ships no systemd unit at all.
#   * Three further units are separate processes:
#       neutron-rpc-server.service        User=neutron
#       neutron-periodic-workers.service
#       neutron-ovn-metadata-agent.service  User=root (it manipulates netns)
#   * neutron.conf and plugins/ml2/ml2_conf.ini both come from
#     `neutron-common`, mode 0640 root:neutron.
#   * Config loading was checked in neutron/server/__init__.py: with no
#     OS_NEUTRON_CONFIG_FILES set, the WSGI app defaults to
#     ['neutron.conf', 'plugins/ml2/ml2_conf.ini'] — so the API and the RPC
#     server read the same pair and cannot disagree about the mechanism driver.
#   * There is no /etc/neutron/plugin.ini convention in this packaging.
#   * DB schema is managed by `neutron-db-manage ... upgrade head`.
# ---------------------------------------------------------------------------
NEUTRON_CONF="/etc/neutron/neutron.conf"
ML2_CONF="/etc/neutron/plugins/ml2/ml2_conf.ini"
OVN_META_CONF="/etc/neutron/neutron_ovn_metadata_agent.ini"
NEUTRON_PORT=9696
NEUTRON_UNITS="neutron-rpc-server neutron-periodic-workers neutron-ovn-metadata-agent"

neutron_serving() {
    _probe curl -s -o /dev/null -m 10 "http://${MGMT_IP}:${NEUTRON_PORT}/" 2>/dev/null
}

phase_neutron() {
    log_step "networking API (Neutron, ML2/OVN)"

    local pkgs="neutron-server neutron-plugin-ml2 neutron-ovn-metadata-agent"
    if dpkg-query -W -f='${Status}' neutron-server 2>/dev/null | grep -q "install ok installed"; then
        log_ok "neutron already installed"
    else
        log_info "installing:$pkgs (pulls neutron-api, which provides the Apache vhost)"
        # shellcheck disable=SC2086
        $SUDO env DEBIAN_FRONTEND=noninteractive apt-get install -y -qq $pkgs
        log_ok "neutron installed"
    fi
    log_info "neutron $(dpkg-query -W -f='${Version}' neutron-server 2>/dev/null || echo '?'): \
API via apache2 on :${NEUTRON_PORT} (neutron-server ships no unit), plus $NEUTRON_UNITS"

    # --- dependencies -------------------------------------------------------
    if ! mariadb_reachable; then
        note_skip neutron "MariaDB is not reachable; the networking schema cannot be created."
        return 0
    fi
    if ! mysql_root -e "USE neutron" >/dev/null 2>&1; then
        note_skip neutron "the 'neutron' database does not exist; the database phase did not complete."
        return 0
    fi
    if ! keystone_ready_for_registration; then
        note_skip neutron "Keystone is not answering, so networking cannot be registered."
        return 0
    fi
    if ! memcached_reachable; then
        note_skip neutron "memcached is not listening on ${MGMT_IP}:11211; see the glance phase."
        return 0
    fi
    if ! phase_done ovn; then
        note_skip neutron "the OVN phase did not complete, so ML2/OVN has nothing to drive.
     Neutron was not configured."
        return 0
    fi

    # --- neutron.conf --------------------------------------------------------
    local changed=0
    ini_set "$NEUTRON_CONF" DEFAULT core_plugin     ml2                     && changed=1
    ini_set "$NEUTRON_CONF" DEFAULT service_plugins ovn-router              && changed=1
    ini_set "$NEUTRON_CONF" DEFAULT auth_strategy   keystone                && changed=1
    ini_set "$NEUTRON_CONF" DEFAULT transport_url \
        "rabbit://openstack:${RABBIT_PASS}@${MGMT_IP}:5672/"                && changed=1
    ini_set "$NEUTRON_CONF" database connection \
        "mysql+pymysql://neutron:${NEUTRON_DB_PASS}@127.0.0.1/neutron?charset=utf8mb4" && changed=1
    write_authtoken "$NEUTRON_CONF" neutron "$NEUTRON_SERVICE_PASS"

    # --- ml2_conf.ini --------------------------------------------------------
    # geneve for tenant networks; flat AND vlan offered on the provider physnet
    # so that multiple provider LANs can be added later without re-plumbing.
    ini_set "$ML2_CONF" ml2 type_drivers          "flat,vlan,geneve"        && changed=1
    ini_set "$ML2_CONF" ml2 tenant_network_types   geneve                   && changed=1
    ini_set "$ML2_CONF" ml2 mechanism_drivers      ovn                      && changed=1
    ini_set "$ML2_CONF" ml2 extension_drivers      port_security            && changed=1
    ini_set "$ML2_CONF" ml2 overlay_ip_version     4                        && changed=1
    ini_set "$ML2_CONF" ml2_type_geneve vni_ranges       "1:65536"          && changed=1
    ini_set "$ML2_CONF" ml2_type_geneve max_header_size  38                 && changed=1
    ini_set "$ML2_CONF" ml2_type_flat   flat_networks       "$PROVIDER_PHYSNET" && changed=1
    ini_set "$ML2_CONF" ml2_type_vlan   network_vlan_ranges "$PROVIDER_PHYSNET" && changed=1
    ini_set "$ML2_CONF" securitygroup   enable_security_group true          && changed=1
    ini_set "$ML2_CONF" ovn ovn_nb_connection "tcp:127.0.0.1:${OVN_NB_PORT}" && changed=1
    ini_set "$ML2_CONF" ovn ovn_sb_connection "tcp:${MGMT_IP}:${OVN_SB_PORT}" && changed=1
    ini_set "$ML2_CONF" ovn ovn_l3_scheduler   leastloaded                  && changed=1
    ini_set "$ML2_CONF" ovn ovn_metadata_enabled true                       && changed=1

    # --- metadata agent ------------------------------------------------------
    ini_set "$OVN_META_CONF" DEFAULT nova_metadata_host "$MGMT_IP"          && changed=1
    ini_set "$OVN_META_CONF" DEFAULT metadata_proxy_shared_secret \
        "$METADATA_PROXY_SECRET"                                            && changed=1
    ini_set "$OVN_META_CONF" ovs ovsdb_connection "unix:/var/run/openvswitch/db.sock" && changed=1
    ini_set "$OVN_META_CONF" ovn ovn_sb_connection "tcp:${MGMT_IP}:${OVN_SB_PORT}" && changed=1

    if [ "$changed" -eq 1 ]; then
        log_ok "neutron.conf, ml2_conf.ini and the metadata agent configured (credentials not shown)"
    else
        log_ok "neutron configuration already correct (unchanged)"
    fi
    # The packages ship these root:neutron 0640 — keep it.
    local f
    for f in "$NEUTRON_CONF" "$ML2_CONF" "$OVN_META_CONF"; do
        $SUDO chown root:neutron "$f" 2>/dev/null || true
        $SUDO chmod 0640 "$f"
    done

    # --- schema --------------------------------------------------------------
    local before after
    before="$(mysql_root -N -B -e \
        "SELECT COUNT(*) FROM information_schema.tables WHERE table_schema='neutron'" 2>/dev/null || echo 0)"
    log_info "running neutron-db-manage upgrade head (idempotent migration)"
    local nerr; nerr="$(mktemp)"; chmod 0600 "$nerr"
    if ! $SUDO runuser -u neutron -- neutron-db-manage \
            --config-file "$NEUTRON_CONF" --config-file "$ML2_CONF" upgrade head >"$nerr" 2>&1; then
        log_error "neutron-db-manage failed. Diagnostics (credentials redacted):"
        $SUDO sed "s/${NEUTRON_DB_PASS}/<redacted>/g; s/${NEUTRON_SERVICE_PASS}/<redacted>/g; s/${RABBIT_PASS}/<redacted>/g" "$nerr" \
          | grep -viE 'password|secret' | tail -12 | sed 's/^/     /' >&2
        rm -f "$nerr"
        note_skip neutron "the networking schema could not be created (see the diagnostics above)."
        return 0
    fi
    rm -f "$nerr"
    after="$(mysql_root -N -B -e \
        "SELECT COUNT(*) FROM information_schema.tables WHERE table_schema='neutron'" 2>/dev/null || echo 0)"
    if [ "$before" = "0" ]; then log_ok "networking schema created ($after tables)"
    elif [ "$before" = "$after" ]; then log_ok "networking schema already current ($after tables, unchanged)"
    else log_ok "networking schema migrated ($before -> $after tables)"; fi

    # --- identity registration ------------------------------------------------
    ks_ensure_project service
    ks_ensure_user neutron "$NEUTRON_SERVICE_PASS"
    ks_ensure_role_assignment neutron service admin
    ks_ensure_service neutron network "OpenStack Networking"
    local url="http://${MGMT_IP}:${NEUTRON_PORT}"
    ks_ensure_endpoint neutron public   "$url"
    ks_ensure_endpoint neutron internal "$url"
    ks_ensure_endpoint neutron admin    "$url"

    # --- run it ----------------------------------------------------------------
    $SUDO a2ensite neutron-api >/dev/null 2>&1 || true
    if [ "$HAS_SYSTEMD" -eq 1 ]; then
        if service_active apache2; then
            $SUDO systemctl reload-or-restart apache2 \
                || die "apache2 failed to reload after the neutron configuration change"
            log_ok "apache2 reloaded (identity :5000, placement :8778, networking :${NEUTRON_PORT})"
        else
            service_start_enable apache2
        fi
        local u
        for u in $NEUTRON_UNITS; do service_start_enable "$u"; done
    else
        log_warn "systemd is not running here; the neutron units cannot be started"
        for u in $NEUTRON_UNITS; do SERVICE_START_METHOD[$u]="not-started-no-systemd"; done
    fi

    if ! service_active apache2; then
        note_skip neutron "apache2 is not running, so the networking API is not being served.
     The schema, configuration and identity registration ARE in place.
     Startup under systemd is a GCE acceptance item (B0a/B0b)."
        return 0
    fi
    if ! neutron_serving; then
        note_skip neutron "apache2 is active but http://${MGMT_IP}:${NEUTRON_PORT}/ did not answer."
        return 0
    fi
    if ! openstack_admin network list >/dev/null 2>&1; then
        note_skip neutron "the networking endpoint answers but 'openstack network list' failed as admin."
        return 0
    fi
    log_ok "networking API verified (openstack network list succeeded)"
    log_warn "no network has been created and no instance can boot: Nova is not installed."
    phase_mark_done neutron
}

# ---------------------------------------------------------------------------
# Nova (compute)
#
# Packaging verified on Ubuntu 26.04 (nova 3:33.0.0-0ubuntu3.1), by unpacking
# the .deb files rather than by analogy with the other services:
#   * nova-api ships /etc/apache2/sites-available/nova-api.conf with its own
#     `Listen 8774` and WSGIScriptAlias to /usr/bin/nova-api-wsgi, and its
#     postinst runs `apache2_invoke ensite`. There is NO nova-api systemd unit.
#     nova-api-metadata is a separate package with its own vhost on `Listen
#     8775` and /usr/bin/nova-metadata-wsgi.
#   * nova-conductor, nova-scheduler and nova-compute DO ship units, all
#     Type=simple, User=nova, ExecStart=/etc/init.d/<name> systemd-start
#     (the Debian init wrapper). nova-compute's unit also orders itself After=
#     libvirtd.service.
#   * No postinst touches the database: no db sync, no cell_v2. All of that is
#     hagistack's job.
#   * nova-common ships /etc/nova/nova.conf as **0644 root:root** — unlike
#     neutron-common (0640 root:neutron). Since hagistack writes credentials
#     into it, the mode is tightened to 0640 root:nova here.
#   * nova-compute-kvm ships /etc/nova/nova-compute.conf with
#     compute_driver=libvirt.LibvirtDriver and [libvirt] virt_type=kvm, and
#     /etc/init.d/nova-compute passes `--config-file=/etc/nova/nova-compute.conf`
#     in addition to the default nova.conf. That is the file to edit for the
#     virtualisation type.
#   * `nova-manage` categories in the shipped code: api_db, cell_v2, db,
#     placement, libvirt, volume_attachment, image_property, limits.
#     cell_v2 offers map_cell0, create_cell, discover_hosts, list_cells, ...
#     `_map_cell0` with no --database_connection derives the cell0 URL from
#     [database] connection by appending `_cell0` to the database name, so the
#     flag is omitted and no password is ever passed on a command line.
#   * `[api] auth_strategy` does NOT exist in nova 33 (checked in
#     nova/conf/api.py); it is not invented here. `[glance] api_servers` is
#     deprecated since 21.0.0, so the image service is reached through the
#     catalogue with `valid_interfaces` instead.
#   * `[neutron] metadata_proxy_shared_secret` is absent from the shipped
#     sample (oslo hides secret options) but IS defined in
#     nova/conf/neutron.py, which is what this uses.
# ---------------------------------------------------------------------------
NOVA_CONF="/etc/nova/nova.conf"
NOVA_COMPUTE_CONF="/etc/nova/nova-compute.conf"
NOVA_API_PORT=8774
NOVA_METADATA_PORT=8775
NOVA_UNITS="nova-conductor nova-scheduler"
NOVA_COMPUTE_UNITS="nova-compute"

nova_api_serving() {
    _probe curl -s -o /dev/null -m 10 "http://${MGMT_IP}:${NOVA_API_PORT}/" 2>/dev/null
}

# nova-manage as the nova user. Credentials come from nova.conf, never argv.
nova_manage() { $SUDO runuser -u nova -- nova-manage "$@"; }

# A keystoneauth adapter block (placement, neutron, service_user all use the
# same shape). Values are written key-by-key so a re-run rewrites nothing.
write_service_auth() {  # write_service_auth <conf> <section> <user> <pass> [interfaces]
    local conf="$1" sec="$2" user="$3" pass="$4" ifaces="${5:-}"
    ini_set "$conf" "$sec" auth_url            "http://${MGMT_IP}:5000/v3" >/dev/null || true
    ini_set "$conf" "$sec" auth_type           password                    >/dev/null || true
    ini_set "$conf" "$sec" project_domain_name Default                     >/dev/null || true
    ini_set "$conf" "$sec" user_domain_name    Default                     >/dev/null || true
    ini_set "$conf" "$sec" project_name        service                     >/dev/null || true
    ini_set "$conf" "$sec" region_name         "$REGION_NAME"              >/dev/null || true
    ini_set "$conf" "$sec" username            "$user"                     >/dev/null || true
    ini_set "$conf" "$sec" password            "$pass"                     >/dev/null || true
    [ -n "$ifaces" ] && ini_set "$conf" "$sec" valid_interfaces "$ifaces"  >/dev/null || true
    return 0
}

# Is a cell with this name already mapped? `list_cells` prints the database and
# transport URLs, passwords included, so its output is matched but never shown.
nova_cell_exists() {  # nova_cell_exists <name>
    local out
    out="$(nova_manage cell_v2 list_cells 2>/dev/null)" || return 1
    grep -qE "[| ]$1[ |]" <<<"$out"
}

phase_nova() {
    log_step "compute API and control services (Nova)"

    local pkgs="nova-api nova-api-metadata nova-conductor nova-scheduler"
    if dpkg-query -W -f='${Status}' nova-conductor 2>/dev/null | grep -q "install ok installed"; then
        log_ok "nova control services already installed"
    else
        log_info "installing:$pkgs (nova-api provides the :$NOVA_API_PORT vhost)"
        # shellcheck disable=SC2086
        $SUDO env DEBIAN_FRONTEND=noninteractive apt-get install -y -qq $pkgs
        log_ok "nova control services installed"
    fi
    log_info "nova $(dpkg-query -W -f='${Version}' nova-common 2>/dev/null || echo '?'): \
API via apache2 on :${NOVA_API_PORT}, metadata on :${NOVA_METADATA_PORT} (no nova-api unit), plus $NOVA_UNITS"

    # --- dependencies -------------------------------------------------------
    if ! mariadb_reachable; then
        note_skip nova "MariaDB is not reachable; the compute databases cannot be created."
        return 0
    fi
    local d
    for d in nova nova_api nova_cell0; do
        if ! mysql_root -e "USE \`$d\`" >/dev/null 2>&1; then
            note_skip nova "the '$d' database does not exist; the database phase did not complete."
            return 0
        fi
    done
    if ! keystone_ready_for_registration; then
        note_skip nova "Keystone is not answering, so compute cannot be registered."
        return 0
    fi
    if ! memcached_reachable; then
        note_skip nova "memcached is not listening on ${MGMT_IP}:11211; see the glance phase."
        return 0
    fi
    # Placement and Neutron are runtime dependencies rather than configuration
    # ones: nova can be configured without them, but it cannot schedule or
    # network an instance. Say so rather than silently producing a cloud that
    # cannot boot anything.
    phase_done placement || log_warn "the placement phase has not completed; nova cannot schedule until it does"
    phase_done neutron   || log_warn "the neutron phase has not completed; instances will have no network"
    rabbitmq_reachable   || log_warn "RabbitMQ is not reachable; conductor, scheduler and compute cannot talk"

    # --- nova.conf -----------------------------------------------------------
    local changed=0
    ini_set "$NOVA_CONF" DEFAULT my_ip "$MGMT_IP"                            && changed=1
    ini_set "$NOVA_CONF" DEFAULT transport_url \
        "rabbit://openstack:${RABBIT_PASS}@${MGMT_IP}:5672/"                 && changed=1
    ini_set "$NOVA_CONF" api_database connection \
        "mysql+pymysql://nova:${NOVA_DB_PASS}@127.0.0.1/nova_api?charset=utf8mb4" && changed=1
    ini_set "$NOVA_CONF" database connection \
        "mysql+pymysql://nova:${NOVA_DB_PASS}@127.0.0.1/nova?charset=utf8mb4"     && changed=1
    write_authtoken "$NOVA_CONF" nova "$NOVA_SERVICE_PASS"
    # nova's own service token, used when it calls glance/neutron/placement
    write_service_auth "$NOVA_CONF" service_user nova "$NOVA_SERVICE_PASS"
    ini_set "$NOVA_CONF" service_user send_service_user_token true           && changed=1
    write_service_auth "$NOVA_CONF" placement placement "$PLACEMENT_SERVICE_PASS" internal
    write_service_auth "$NOVA_CONF" neutron   neutron   "$NEUTRON_SERVICE_PASS"   internal
    # api_servers is deprecated since 21.0.0; reach glance through the catalogue
    ini_set "$NOVA_CONF" glance valid_interfaces internal                    && changed=1
    # the OVN metadata agent proxies instance metadata to nova with this secret
    ini_set "$NOVA_CONF" neutron service_metadata_proxy true                 && changed=1
    ini_set "$NOVA_CONF" neutron metadata_proxy_shared_secret \
        "$METADATA_PROXY_SECRET"                                             && changed=1
    ini_set "$NOVA_CONF" vnc enabled true                                    && changed=1
    ini_set "$NOVA_CONF" vnc server_listen "$MGMT_IP"                        && changed=1
    ini_set "$NOVA_CONF" vnc server_proxyclient_address "$MGMT_IP"           && changed=1
    ini_set "$NOVA_CONF" oslo_concurrency lock_path /var/lib/nova/tmp        && changed=1
    if [ "$changed" -eq 1 ]; then
        log_ok "nova.conf configured (credentials not shown)"
    else
        log_ok "nova.conf already correct (unchanged)"
    fi
    # The package ships this 0644 root:root and it now holds credentials.
    $SUDO chown root:nova "$NOVA_CONF" 2>/dev/null || true
    $SUDO chmod 0640 "$NOVA_CONF"
    $SUDO install -d -o nova -g nova -m 0750 /var/lib/nova/tmp 2>/dev/null || true

    # --- schema, then cells v2 ------------------------------------------------
    local before after
    before="$(mysql_root -N -B -e \
        "SELECT COUNT(*) FROM information_schema.tables WHERE table_schema='nova'" 2>/dev/null || echo 0)"
    local nerr; nerr="$(mktemp)"; chmod 0600 "$nerr"
    _nova_manage_or_skip() {   # _nova_manage_or_skip <what> <args...>
        local what="$1"; shift
        if nova_manage "$@" >"$nerr" 2>&1; then return 0; fi
        log_error "nova-manage $what failed. Diagnostics (credentials redacted):"
        $SUDO sed "s/${NOVA_DB_PASS}/<redacted>/g; s/${NOVA_SERVICE_PASS}/<redacted>/g; s/${RABBIT_PASS}/<redacted>/g" "$nerr" \
          | grep -viE 'password|secret' | tail -12 | sed 's/^/     /' >&2
        return 1
    }
    log_info "running nova-manage api_db sync (idempotent migration)"
    if ! _nova_manage_or_skip "api_db sync" api_db sync; then
        rm -f "$nerr"; note_skip nova "the nova_api schema could not be created."; return 0
    fi
    # cell0 first: nova derives its URL from [database] connection + _cell0, so
    # no password is passed on the command line. Re-running prints
    # "Cell0 is already setup" and exits 0.
    log_info "mapping cell0 (URL derived from [database] connection, not passed on the command line)"
    if ! _nova_manage_or_skip "cell_v2 map_cell0" cell_v2 map_cell0; then
        rm -f "$nerr"; note_skip nova "cell0 could not be mapped."; return 0
    fi
    log_info "running nova-manage db sync (idempotent migration)"
    if ! _nova_manage_or_skip "db sync" db sync; then
        rm -f "$nerr"; note_skip nova "the nova schema could not be created."; return 0
    fi
    after="$(mysql_root -N -B -e \
        "SELECT COUNT(*) FROM information_schema.tables WHERE table_schema='nova'" 2>/dev/null || echo 0)"
    if [ "$before" = "0" ]; then log_ok "compute schema created ($after tables)"
    elif [ "$before" = "$after" ]; then log_ok "compute schema already current ($after tables, unchanged)"
    else log_ok "compute schema migrated ($before -> $after tables)"; fi

    # cell1 is created only when it is absent: create_cell would otherwise add a
    # second mapping, and an existing cell is never deleted or rewritten.
    if nova_cell_exists cell1; then
        log_ok "cell 'cell1' already mapped — left untouched"
    else
        if ! _nova_manage_or_skip "cell_v2 create_cell" cell_v2 create_cell --name cell1; then
            rm -f "$nerr"; note_skip nova "cell1 could not be created."; return 0
        fi
        log_ok "cell 'cell1' created (database and transport taken from nova.conf)"
    fi
    rm -f "$nerr"

    # --- identity registration -------------------------------------------------
    ks_ensure_project service
    ks_ensure_user nova "$NOVA_SERVICE_PASS"
    ks_ensure_role_assignment nova service admin
    ks_ensure_service nova compute "OpenStack Compute"
    local url="http://${MGMT_IP}:${NOVA_API_PORT}/v2.1"
    ks_ensure_endpoint nova public   "$url"
    ks_ensure_endpoint nova internal "$url"
    ks_ensure_endpoint nova admin    "$url"

    # --- run it ------------------------------------------------------------------
    $SUDO a2ensite nova-api >/dev/null 2>&1 || true
    $SUDO a2ensite nova-api-metadata >/dev/null 2>&1 || true
    if [ "$HAS_SYSTEMD" -eq 1 ]; then
        if service_active apache2; then
            $SUDO systemctl reload-or-restart apache2 \
                || die "apache2 failed to reload after the nova configuration change"
            log_ok "apache2 reloaded (identity :5000, placement :8778, networking :9696, compute :${NOVA_API_PORT}, metadata :${NOVA_METADATA_PORT})"
        else
            service_start_enable apache2
        fi
        local u
        for u in $NOVA_UNITS; do service_start_enable "$u"; done
    else
        log_warn "systemd is not running here; the nova units cannot be started"
        for u in $NOVA_UNITS; do SERVICE_START_METHOD[$u]="not-started-no-systemd"; done
    fi

    if ! service_active apache2; then
        note_skip nova "apache2 is not running, so the compute API is not being served.
     The schema, cells, configuration and identity registration ARE in place.
     Startup under systemd is a GCE acceptance item (B0a/B0b)."
        return 0
    fi
    if ! nova_api_serving; then
        note_skip nova "apache2 is active but http://${MGMT_IP}:${NOVA_API_PORT}/ did not answer."
        return 0
    fi
    if ! openstack_admin compute service list >/dev/null 2>&1; then
        note_skip nova "the compute endpoint answers but 'openstack compute service list' failed.
     conductor and scheduler need RabbitMQ and the cell databases to be reachable."
        return 0
    fi
    log_ok "compute API verified (openstack compute service list succeeded)"
    log_warn "no hypervisor is registered yet and no instance has been booted."
    phase_mark_done nova
}

phase_nova_compute() {
    log_step "hypervisor (nova-compute)"

    # The dependency is checked BEFORE installing: nova-compute pulls
    # libvirt-daemon-system and qemu-system, several hundred megabytes that are
    # useless on a host where the nova control plane is not up yet.
    if ! phase_done nova; then
        note_skip nova_compute "the nova phase did not complete, so there is nothing for a
     hypervisor to register with. Neither libvirt/qemu nor nova-compute was installed."
        return 0
    fi

    local pkgs="nova-compute nova-compute-kvm"
    if dpkg-query -W -f='${Status}' nova-compute 2>/dev/null | grep -q "install ok installed"; then
        log_ok "nova-compute already installed"
    else
        log_info "installing:$pkgs (pulls libvirt-daemon-system and qemu-system)"
        # shellcheck disable=SC2086
        $SUDO env DEBIAN_FRONTEND=noninteractive apt-get install -y -qq $pkgs
        log_ok "nova-compute installed"
    fi

    # --- virtualisation type ---------------------------------------------------
    # VIRT_TYPE was resolved in preflight from /dev/kvm (or given explicitly).
    # It goes into nova-compute.conf, which is the file the packaged init script
    # passes with --config-file in addition to nova.conf.
    local changed=0
    ini_set "$NOVA_COMPUTE_CONF" DEFAULT compute_driver libvirt.LibvirtDriver && changed=1
    ini_set "$NOVA_COMPUTE_CONF" libvirt virt_type "$VIRT_TYPE"               && changed=1
    if [ "$VIRT_TYPE" = "qemu" ]; then
        # Without hardware virtualisation the generic CPU model is the only one
        # that reliably works; say plainly what this costs.
        ini_set "$NOVA_COMPUTE_CONF" libvirt cpu_mode none                    && changed=1
        log_warn "virt_type=qemu: /dev/kvm is not usable here, so guests run under"
        log_warn "  software emulation (10-50x slower). Usable for a boot smoke test only."
    else
        log_ok "virt_type=kvm (/dev/kvm usable)"
    fi
    [ "$changed" -eq 1 ] && log_ok "nova-compute.conf configured" \
                         || log_ok "nova-compute.conf already correct (unchanged)"
    $SUDO chown root:nova "$NOVA_COMPUTE_CONF" 2>/dev/null || true
    $SUDO chmod 0640 "$NOVA_COMPUTE_CONF"

    # --- run it -----------------------------------------------------------------
    if [ "$HAS_SYSTEMD" -eq 1 ]; then
        service_start_enable libvirtd
        local u
        for u in $NOVA_COMPUTE_UNITS; do service_start_enable "$u"; done
    else
        log_warn "systemd is not running here; libvirtd and nova-compute cannot be started"
        log_warn "  -> a hypervisor cannot be registered, and no guest can be booted"
        for u in $NOVA_COMPUTE_UNITS; do SERVICE_START_METHOD[$u]="not-started-no-systemd"; done
        note_skip nova_compute "nova-compute was configured but not started (no systemd).
     Hypervisor registration, cell host discovery and guest boot are GCE items."
        return 0
    fi

    # --- has the hypervisor actually registered? ---------------------------------
    local i=0 reg_hosts=""
    while [ "$i" -lt 12 ]; do
        reg_hosts="$(openstack_admin compute service list --service nova-compute -f value -c Host 2>/dev/null || true)"
        [ -n "$(tr -d '[:space:]' <<<"$reg_hosts")" ] && break
        i=$((i+1)); sleep 5
    done
    if [ -z "$(tr -d '[:space:]' <<<"$reg_hosts")" ]; then
        note_skip nova_compute "nova-compute is running but did not register a compute service.
     Check RabbitMQ and the conductor; nothing was discovered, so no host was mapped."
        return 0
    fi
    log_ok "compute service registered: $(tr '\n' ' ' <<<"$reg_hosts")"

    # Map the new host into cell1. discover_hosts is idempotent: hosts already
    # mapped are reported as such and nothing is recreated.
    if nova_manage cell_v2 discover_hosts --by-service >/dev/null 2>&1; then
        log_ok "cell host discovery ran (already-mapped hosts are left alone)"
    else
        note_skip nova_compute "'nova-manage cell_v2 discover_hosts' failed; the hypervisor is
     running but is not mapped into a cell, so the scheduler will not use it."
        return 0
    fi
    if ! openstack_admin hypervisor list >/dev/null 2>&1; then
        note_skip nova_compute "the hypervisor list could not be read back after discovery."
        return 0
    fi
    log_ok "hypervisor visible to the compute API"
    log_warn "a registered hypervisor is not a booted guest: no instance has been started,"
    log_warn "  and guest boot stays unverified until the GCE acceptance."
    phase_mark_done nova_compute
}

# ---------------------------------------------------------------------------
# where we stop
# ---------------------------------------------------------------------------
# Two outcomes, never conflated: the base layer either came up or it did not.
# A run that skipped MariaDB or RabbitMQ is reported as INCOMPLETE and exits 4.
print_stage_banner() {
    local rule="────────────────────────────────────────────────────────────────"
    if [ -n "$SKIPPED_PHASES" ]; then
        cat <<EOF

${C_RED}${rule}${C_RESET}
${C_RED} STEP 5 INCOMPLETE — NOT ALL IMPLEMENTED SERVICES ARE UP${C_RESET}
${C_RED}${rule}${C_RESET}
 Skipped    : $SKIPPED_PHASES
 Completed  : $(printf '%s' "$(_completed_phases)")
 Not yet    : $PENDING_PHASES

 One or more services could not be reached, so their setup did not run.
 This is expected in a container with no systemd, and it is NOT a failure
 of the shell — but it is also NOT a completed step 5.

 Nothing was left half-written: the skipped phases made no changes and
 carry no state marker, so re-running once the services are up will
 complete them.

 Exit status 4 = ran to the end, the layer is incomplete.
${C_RED}${rule}${C_RESET}
EOF
        return 0
    fi
    cat <<EOF

${C_YEL}${rule}${C_RESET}
${C_YEL} STEP 5 COMPLETE (CONTROL PLANE + HYPERVISOR) — GUEST BOOT UNVERIFIED${C_RESET}
${C_YEL}${rule}${C_RESET}
 What ran   : $IMPLEMENTED_PHASES
 Not yet    : $PENDING_PHASES

 Up: database, message queue, cache, Keystone identity, Glance, Placement,
 the Neutron networking API on ML2/OVN, and Nova — API, conductor, scheduler
 and a registered hypervisor (virt_type=$VIRT_TYPE).

 Still missing: Horizon, and the initial resources (flavor, image, network,
 router, security group, keypair) an instance needs.

 ${C_RED}No guest VM has been booted by this run, and nothing here proves one can be.${C_RESET}
 The provider bridge $PROVIDER_BRIDGE has ${C_RED}no NIC attached and no address${C_RESET}, so
 provider networks reach no physical LAN; Geneve between nodes is configured
 but ${C_RED}untested until a second node joins${C_RESET}.

 ${C_RED}Do not call this a finished OpenStack until guest boot and the two-node
 path have been verified on real machines.${C_RESET}

 Admin credentials: $ADMIN_OPENRC (mode 0600, outside the repository)
   . $ADMIN_OPENRC && openstack compute service list
   . $ADMIN_OPENRC && openstack hypervisor list

 Re-running this command is safe: it does not drop databases, does not
 rotate existing secrets or fernet keys, and does not append duplicate
 configuration.
${C_YEL}${rule}${C_RESET}
EOF
}

_completed_phases() {
    local p out=""
    for p in $IMPLEMENTED_PHASES; do
        case " $SKIPPED_PHASES " in *" $p "*) continue ;; esac
        out="${out}${out:+ }$p"
    done
    printf '%s' "${out:-none}"
}

# ---------------------------------------------------------------------------
# commands
# ---------------------------------------------------------------------------
cmd_all_in_one() {
    log_step "hagistack $HAGISTACK_VERSION — all-in-one"
    log_info "stage: $HAGISTACK_STAGE"
    _need_privilege
    phase_preflight
    if [ "$DRY_RUN" -eq 1 ]; then
        print_resolved_config
        echo
        log_ok "--check: preflight only, no changes made"
        return 0
    fi
    phase_secrets
    phase_base_packages
    phase_database
    phase_rabbitmq
    phase_memcached
    phase_keystone
    phase_glance
    phase_placement
    phase_ovn
    phase_neutron
    phase_nova
    phase_nova_compute
    print_stage_banner
    # `exit` rather than `return`: a non-zero return would trip the ERR trap and
    # print an "aborted" line, which this is not.
    [ -z "$SKIPPED_PHASES" ] || exit 4
}

cmd_compute_add() {
    log_error "'compute-add' is not implemented yet (planned for a later step)."
    log_error "Step 1 covers the all-in-one skeleton, preflight and base services only."
    log_error "Implemented now : $IMPLEMENTED_PHASES"
    log_error "Still to come   : $PENDING_PHASES, then compute-add"
    exit 3
}

cmd_status() {
    detect_os; detect_container; detect_init
    echo "hagistack $HAGISTACK_VERSION"
    echo "stage    : $HAGISTACK_STAGE"
    echo "os       : ${OS_PRETTY:-unknown}"
    echo "init     : $([ "$HAS_SYSTEMD" -eq 1 ] && echo systemd || echo 'no systemd')"
    echo "secrets  : $([ -f "$SECRETS_FILE" ] && echo "$SECRETS_FILE (mode $($SUDO stat -c '%a' "$SECRETS_FILE" 2>/dev/null || echo '?'))" || echo 'not created yet')"
    echo
    echo "phases implemented: $IMPLEMENTED_PHASES"
    echo "phases pending    : $PENDING_PHASES"
    echo
    local p incomplete=""
    for p in $IMPLEMENTED_PHASES; do
        if phase_done "$p"; then
            printf '  %-16s %s\n' "$p" "done"
        else
            printf '  %-16s %s\n' "$p" "not done"
            incomplete="${incomplete}${incomplete:+ }$p"
        fi
    done
    echo
    if [ -z "$incomplete" ]; then
        echo "implemented layer: COMPLETE (every implemented phase carries a state marker)"
    else
        echo "implemented layer: INCOMPLETE — missing: $incomplete"
        echo "            'all-in-one' exits 4 while any of these is missing."
    fi
    echo "NOTE: even when COMPLETE, Horizon is NOT installed, no initial resources"
    echo "      exist, and no guest VM has been booted or verified. The provider"
    echo "      bridge has no NIC attached and no address, so provider networks"
    echo "      reach no physical LAN, and Geneve node-to-node tunnelling is"
    echo "      untested until compute-add."
    echo
    echo "identity:"
    printf '  %-16s %s\n' "keystone pkg" \
        "$(dpkg-query -W -f='${Version}' keystone 2>/dev/null || echo 'not installed')"
    printf '  %-16s %s\n' "served by" "apache2 + mod_wsgi (no keystone systemd unit exists)"
    printf '  %-16s %s\n' "admin openrc" \
        "$($SUDO test -f "$ADMIN_OPENRC" && echo "$ADMIN_OPENRC (mode $($SUDO stat -c '%a' "$ADMIN_OPENRC"))" || echo 'not created yet')"
    printf '  %-16s %s\n' "fernet keys" \
        "$($SUDO test -s "$KEYSTONE_FERNET_DIR/0" && echo present || echo absent)"
    printf '  %-16s %s\n' "credential keys" \
        "$($SUDO test -s "$KEYSTONE_CRED_DIR/0" && echo present || echo absent)"
    echo
    echo "image / placement:"
    printf '  %-16s %s\n' "glance pkg" \
        "$(dpkg-query -W -f='${Version}' glance 2>/dev/null || echo 'not installed')"
    printf '  %-16s %s\n' "  served by" "glance-api.service (its own systemd unit)"
    printf '  %-16s %s\n' "placement pkg" \
        "$(dpkg-query -W -f='${Version}' placement-api 2>/dev/null || echo 'not installed')"
    printf '  %-16s %s\n' "  served by" "apache2 + mod_wsgi on :8778 (no placement systemd unit)"
    echo
    echo "networking:"
    printf '  %-16s %s\n' "neutron pkg" \
        "$(dpkg-query -W -f='${Version}' neutron-server 2>/dev/null || echo 'not installed')"
    printf '  %-16s %s\n' "  API" "apache2 + mod_wsgi on :9696 (neutron-server ships no unit)"
    printf '  %-16s %s\n' "  other units" "$NEUTRON_UNITS"
    printf '  %-16s %s\n' "ovn pkg" \
        "$(dpkg-query -W -f='${Version}' ovn-central 2>/dev/null || echo 'not installed')"
    printf '  %-16s %s\n' "  real units" "$OVN_CENTRAL_UNITS $OVN_HOST_UNITS"
    printf '  %-16s %s\n' "mgmt / geneve" "$MGMT_IP"
    printf '  %-16s %s\n' "provider" "${PROVIDER_PHYSNET}:${PROVIDER_BRIDGE} (no NIC, no address)"
    echo
    echo "compute:"
    printf '  %-16s %s\n' "nova pkg" \
        "$(dpkg-query -W -f='${Version}' nova-common 2>/dev/null || echo 'not installed')"
    printf '  %-16s %s\n' "  API" "apache2 + mod_wsgi on :8774 (nova-api ships no unit)"
    printf '  %-16s %s\n' "  metadata" "apache2 + mod_wsgi on :8775 (nova-api-metadata)"
    printf '  %-16s %s\n' "  units" "$NOVA_UNITS $NOVA_COMPUTE_UNITS"
    printf '  %-16s %s\n' "  virt type" "${VIRT_TYPE:-unresolved} (guest boot NOT verified)"
    if [ "$HAS_SYSTEMD" -eq 1 ]; then
        echo
        local u
        for u in mariadb rabbitmq-server memcached apache2 glance-api \
                 ovn-ovsdb-server-nb ovn-ovsdb-server-sb ovn-northd ovn-controller \
                 neutron-rpc-server neutron-ovn-metadata-agent \
                 nova-conductor nova-scheduler nova-compute libvirtd; do
            printf '  %-16s %s\n' "$u" "$(systemctl is-active "$u" 2>/dev/null || echo inactive)"
        done
    else
        echo
        echo "  (service state unavailable: no systemd in this environment)"
    fi
}

usage() {
    cat <<EOF
hagistack $HAGISTACK_VERSION — OpenStack deployment shell for Ubuntu Server 26.04 LTS

  STAGE: $HAGISTACK_STAGE
  This build installs the base layer, Keystone, Glance, Placement, the Neutron
  networking API on OVN, and Nova. It does NOT give you a working OpenStack:
  there is no Horizon and no initial resources, no guest VM has been booted or
  verified, and the provider bridge has no NIC attached yet.
  See README.md in this directory.

usage:
  hagistack all-in-one  [options]   build controller+compute on one host
                                    (currently: + Nova API/scheduler/conductor/compute)
  hagistack compute-add [options]   add a compute node   (NOT IMPLEMENTED YET)
  hagistack status                  show stage, phase and service state
  hagistack --help                  this text
  hagistack --version               version string

options:
  --ext-nic NAME            provider/external interface            (required)
  --provider-cidr CIDR      external network, e.g. 172.24.4.0/24   (required)
  --provider-gateway IP     gateway on that network                (required)
  --floating-start IP       first floating IP                      (required)
  --floating-end IP         last floating IP                       (required)
  --mgmt-ip IP              management IP           (default: autodetected)
  --tenant-cidr CIDR        demo tenant subnet      (default: 10.10.10.0/24)
  --dns-server IP           tenant DNS              (default: provider gateway)
  --virt-type kvm|qemu      hypervisor mode         (default: autodetected)
  --region-name NAME        Keystone region         (default: RegionOne)
  --provider-physnet NAME   provider physical-network label   (default: physnet1)
  --provider-bridge NAME    OVS bridge for that physnet       (default: br-ex)
  --env-file PATH           read settings from PATH (default: ./hagistack.env)
  --check                   run preflight only, change nothing
  -h, --help                this text

configuration precedence:
  command line  >  environment  >  ./hagistack.env  >  defaults/autodetect
  Applies to every option above. Giving a key an empty value on any tier is an
  error, so "set to blank" is never mistaken for "not given".
  '--check' prints the resolved value and its source for each key.

config file:
  Parsed, never executed. Only blank lines, '#' comments and KEY=VALUE are
  accepted; KEY must be a known setting and VALUE may contain only
  letters, digits and . _ - : / @ + = — shell metacharacters are refused.
  Use --env-file /dev/null to ignore all config files.

exit status:
  0  success
  1  configuration or preflight error
  2  usage error
  3  subcommand not implemented yet
  4  ran to the end, but the base layer is incomplete (a service was
     unreachable, so its phase was skipped)

secrets:
  Generated on first run into $SECRETS_FILE (mode 0600) and reused unchanged
  afterwards. No password is hard-coded in this shell and no secret is ever
  written into the repository.

re-running:
  Safe. Databases are never dropped, existing secrets are never rotated and
  configuration is edited key-by-key rather than appended.
EOF
}

# Record that a flag was GIVEN, separately from its value, so that an explicit
# empty value is distinguishable from an absent flag.
_cli_set() {
    [ $# -eq 2 ] || die "option $1 requires a value"
    CLI_VAL[$1]="$2"; CLI_SET[$1]=1
}

parse_args() {
    while [ $# -gt 0 ]; do
        case "$1" in
            --ext-nic)          [ $# -ge 2 ] || die "--ext-nic requires a value"
                                _cli_set EXT_NIC "$2"; shift 2 ;;
            --provider-cidr)    [ $# -ge 2 ] || die "--provider-cidr requires a value"
                                _cli_set PROVIDER_CIDR "$2"; shift 2 ;;
            --provider-gateway) [ $# -ge 2 ] || die "--provider-gateway requires a value"
                                _cli_set PROVIDER_GATEWAY "$2"; shift 2 ;;
            --floating-start)   [ $# -ge 2 ] || die "--floating-start requires a value"
                                _cli_set FLOATING_START "$2"; shift 2 ;;
            --floating-end)     [ $# -ge 2 ] || die "--floating-end requires a value"
                                _cli_set FLOATING_END "$2"; shift 2 ;;
            --mgmt-ip)          [ $# -ge 2 ] || die "--mgmt-ip requires a value"
                                _cli_set MGMT_IP "$2"; shift 2 ;;
            --tenant-cidr)      [ $# -ge 2 ] || die "--tenant-cidr requires a value"
                                _cli_set TENANT_CIDR "$2"; shift 2 ;;
            --dns-server)       [ $# -ge 2 ] || die "--dns-server requires a value"
                                _cli_set DNS_SERVER "$2"; shift 2 ;;
            --virt-type)        [ $# -ge 2 ] || die "--virt-type requires a value"
                                _cli_set VIRT_TYPE "$2"; shift 2 ;;
            --region-name)      [ $# -ge 2 ] || die "--region-name requires a value"
                                _cli_set REGION_NAME "$2"; shift 2 ;;
            --provider-physnet) [ $# -ge 2 ] || die "--provider-physnet requires a value"
                                _cli_set PROVIDER_PHYSNET "$2"; shift 2 ;;
            --provider-bridge)  [ $# -ge 2 ] || die "--provider-bridge requires a value"
                                _cli_set PROVIDER_BRIDGE "$2"; shift 2 ;;
            --env-file)         [ $# -ge 2 ] || die "--env-file requires a value"
                                ENV_FILE="$2"; shift 2 ;;
            --check)            DRY_RUN=1; shift ;;
            -h|--help)          usage; exit 0 ;;
            --version)          echo "hagistack $HAGISTACK_VERSION"; exit 0 ;;
            --) shift; break ;;
            -*) log_error "unknown option: $1"; echo; usage >&2; exit 2 ;;
            *)  log_error "unexpected argument: $1"; echo; usage >&2; exit 2 ;;
        esac
    done
}

main() {
    local cmd="${1:-}"
    [ $# -gt 0 ] && shift || true
    case "$cmd" in
        all-in-one|compute-add|status) ;;
        ""|-h|--help)  usage; exit 0 ;;
        --version)     echo "hagistack $HAGISTACK_VERSION"; exit 0 ;;
        *) log_error "unknown command: $cmd"
           log_error "valid commands: all-in-one, compute-add (not yet implemented), status"
           echo; usage >&2; exit 2 ;;
    esac

    # Collect the three tiers, then resolve once. No tier overwrites another
    # by side effect; precedence lives entirely in resolve_config().
    local saved=("$@")
    parse_args "${saved[@]+"${saved[@]}"}"
    load_env_file
    resolve_config

    case "$cmd" in
        all-in-one)  cmd_all_in_one ;;
        compute-add) cmd_compute_add ;;
        status)      cmd_status ;;
    esac
}

main "$@"
