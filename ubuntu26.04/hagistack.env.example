# hagistack configuration example — copy to ./hagistack.env and edit.
#
# ./hagistack.env is git-ignored. Do NOT put passwords here: hagistack
# generates its own secrets into /etc/hagistack/secrets.env (mode 0600) on
# first run and reuses them unchanged afterwards.
#
# Only KEY=VALUE lines and comments are allowed. The file is validated, not
# sourced blindly.

# ---- required ----------------------------------------------------------
# Provider/external interface. On a single-NIC host this is the same NIC
# that carries the management IP; hagistack warns about that case.
EXT_NIC=eth1

# External network the floating IPs come from.
PROVIDER_CIDR=172.24.4.0/24
PROVIDER_GATEWAY=172.24.4.1

# Floating IP pool. Must sit inside PROVIDER_CIDR and must not contain
# PROVIDER_GATEWAY.
FLOATING_START=172.24.4.100
FLOATING_END=172.24.4.200

# ---- optional ----------------------------------------------------------
# Management IP. Autodetected from the default route when unset.
#MGMT_IP=10.146.0.10

# Demo tenant subnet.
#TENANT_CIDR=10.10.10.0/24

# DNS handed to tenant instances. Defaults to PROVIDER_GATEWAY.
#DNS_SERVER=8.8.8.8

# kvm or qemu. Autodetected from /dev/kvm when unset.
#VIRT_TYPE=kvm

# Keystone region written into the service catalogue.
#REGION_NAME=RegionOne

# Provider physical-network label and the OVS bridge it maps to.
#PROVIDER_PHYSNET=physnet1
#PROVIDER_BRIDGE=br-ex

# ---- initial guest image (all-in-one) ----------------------------------
# There is no cirros package in the Ubuntu archive, so the first image is
# fetched from a URL and checked against a digest. The defaults below are the
# cirros project's own files; the digest was verified on 2026-09-27 against the
# publisher's SHA256SUMS. hagistack refuses to download a URL without a digest.
#IMAGE_NAME=cirros-0.6.3-x86_64
#IMAGE_URL=https://download.cirros-cloud.net/0.6.3/cirros-0.6.3-x86_64-disk.img
#IMAGE_SHA256=7d6355852aeb6dbcd191bcda7cd74f1536cfe5cbf8a10495a7283a8396e4b75b
# ...or skip the download entirely and use a file you already have:
#IMAGE_FILE=/var/lib/hagistack/images/cirros-0.6.3-x86_64-disk.img

# ---- compute-add only ---------------------------------------------------
# The controller's MANAGEMENT address, as `hagistack status` reports MGMT_IP
# there. Required by `compute-add`, ignored by `all-in-one`. None of the
# provider-network settings above are needed on a compute node.
#CONTROLLER_IP=10.146.0.10
