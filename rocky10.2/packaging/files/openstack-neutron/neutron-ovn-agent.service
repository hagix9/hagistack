# Written for Hagistack.
# Reads the distribution defaults, neutron.conf and ovn_agent.ini, then the
# *.conf files in conf.d/common and conf.d/neutron-ovn-agent.
# KillMode=process: the helper processes it starts (haproxy, for the
# metadata extension) must outlive a restart of the agent, which finds them
# again through their pid files under /var/lib/neutron; stopping the unit
# therefore leaves them running.
[Unit]
Description=OpenStack Networking (Neutron) OVN agent
Wants=network-online.target
After=network-online.target openvswitch.service ovn-controller.service

[Service]
Type=simple
User=neutron
Group=neutron
ExecStart=/usr/bin/neutron-ovn-agent \
    --config-file /usr/share/neutron/neutron-dist.conf \
    --config-file /etc/neutron/neutron.conf \
    --config-file /etc/neutron/plugins/ml2/ovn_agent.ini \
    --config-dir /etc/neutron/conf.d/common \
    --config-dir /etc/neutron/conf.d/neutron-ovn-agent
KillMode=process
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
