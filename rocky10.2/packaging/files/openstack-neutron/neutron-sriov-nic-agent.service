# Written for Hagistack.
# Reads the distribution defaults, neutron.conf and sriov_agent.ini, then the
# *.conf files in conf.d/common and conf.d/neutron-sriov-nic-agent.
[Unit]
Description=OpenStack Networking (Neutron) SR-IOV NIC agent
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=neutron
Group=neutron
ExecStart=/usr/bin/neutron-sriov-nic-agent \
    --config-file /usr/share/neutron/neutron-dist.conf \
    --config-file /etc/neutron/neutron.conf \
    --config-file /etc/neutron/plugins/ml2/sriov_agent.ini \
    --config-dir /etc/neutron/conf.d/common \
    --config-dir /etc/neutron/conf.d/neutron-sriov-nic-agent
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
