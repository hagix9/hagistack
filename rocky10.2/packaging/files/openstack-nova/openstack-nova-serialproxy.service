# Written for Hagistack.
# nova-serialproxy (websockify) stays in the foreground; Type=simple.
# No --config-file is passed: oslo.config then reads its default files for
# project "nova" and this program (/etc/nova/nova.conf, then
# /etc/nova/nova-serialproxy.conf if present, and the matching .conf.d directories).
[Unit]
Description=OpenStack Compute (Nova) serial console proxy
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=nova
Group=nova
ExecStart=/usr/bin/nova-serialproxy
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
