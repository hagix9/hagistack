# Written for Hagistack.
# nova-scheduler stays in the foreground (oslo.service, threading backend); Type=simple.
# No --config-file is passed: oslo.config then reads its default files for
# project "nova" and this program (/etc/nova/nova.conf, then
# /etc/nova/nova-scheduler.conf if present, and the matching .conf.d directories).
[Unit]
Description=OpenStack Compute (Nova) scheduler
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=nova
Group=nova
ExecStart=/usr/bin/nova-scheduler
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
