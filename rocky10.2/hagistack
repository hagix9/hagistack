# One field out of `openstack ... -f json`, via python3 (always present on
# Ubuntu) so that jq is not a dependency. Custom image properties live either at
# the top level or under "properties", depending on the client version.
os_json_field() {   # os_json_field <key> < json
    python3 -c '
import json, sys
key = sys.argv[1]
try:
    doc = json.load(sys.stdin)
except Exception:
    raise SystemExit(1)
val = doc.get(key)
if val is None and isinstance(doc.get("properties"), dict):
    val = doc["properties"].get(key)
print("" if val is None else val)
' "$1"
}

