# ---------------------------------------------------------------------------
# SELinux
#
# Rocky enforces SELinux, and RDO ships `openstack-selinux` precisely because
# the stock policy does not cover OpenStack. That package lives in RDO's
# OpenStack component repositories — the ones this shell deliberately does not
# enable, because they would drag trunk libraries in with it.
#
# So this is an honest gap, not a decision made for convenience. The shell turns
# on the one boolean it can (httpd talking to the network, which every vhost
# here needs), and if `openstack-selinux` is genuinely unavailable it puts
# SELinux in permissive mode and says so in the loudest terms it has. It never
# does that silently, and `hagistack status` keeps reporting it.
# ---------------------------------------------------------------------------
SELINUX_ACTION="not-examined"

phase_selinux() {
    log_step "SELinux"
    SELINUX_ACTION="not-examined"
    if ! have getenforce; then
        _selinux_record "absent"
        log_ok "SELinux tools are not installed; nothing to do"
        return 0
    fi
    local mode; mode="$(getenforce 2>/dev/null || echo Disabled)"
    log_info "current mode: $mode"

    # Disabled is NOT the configuration this demo was verified in, and it is not
    # the same thing as permissive: with SELinux disabled there is no policy
    # loaded at all, nothing is labelled, and turning it back on later needs a
    # full relabel. Say so rather than letting it pass as "fine".
    if [ "$mode" = "Disabled" ]; then
        _selinux_record "disabled-by-host"
        log_warn "SELinux is DISABLED on this host."
        log_warn "  That is not the configuration this shell was verified in. The demo scope"
        log_warn "  is SELinux PERMISSIVE: policy loaded, decisions logged, nothing denied."
        log_warn "  Disabled means no policy is loaded and nothing is labelled, so re-enabling"
        log_warn "  it later requires a full filesystem relabel. Reported, not corrected."
        return 0
    fi

    # If the policy RDO ships for exactly this is reachable, use it and keep
    # enforcing. It is not, in a single-release repository — but check, because
    # the day it is, relaxing enforcement would be the wrong answer.
    if $SUDO dnf -q list --available openstack-selinux >/dev/null 2>&1; then
        log_info "openstack-selinux is available; installing the policy rather than relaxing enforcement"
        if $SUDO dnf -y install -q openstack-selinux >/dev/null 2>&1; then
            local after; after="$(getenforce 2>/dev/null || echo unknown)"
            _selinux_record "policy-installed"
            log_ok "openstack-selinux installed; SELinux is $after"
            return 0
        fi
        log_warn "openstack-selinux is listed but did not install; falling back to permissive"
    fi

    if have setsebool; then
        if $SUDO setsebool -P httpd_can_network_connect on 2>/dev/null; then
            log_ok "httpd_can_network_connect=on (every API vhost needs it)"
        else
            log_warn "could not set httpd_can_network_connect; continuing to permissive anyway"
        fi
    fi

    if [ "$mode" = "Permissive" ]; then
        _selinux_persist_permissive
        _selinux_record "permissive"
        log_ok "SELinux already permissive; persistent configuration confirmed"
        _selinux_warn_scope
        return 0
    fi

    # Enforcing -> permissive. Every step is checked, because a silent failure
    # here produces a host that is still enforcing while the run reports
    # "permissive", and the next thing to break is something unrelated-looking.
    $SUDO setenforce 0 \
        || die "setenforce 0 failed. SELinux is still $(getenforce 2>/dev/null).
     This shell's verified scope is SELinux permissive, so it stops here rather
     than continuing into failures that will look like OpenStack bugs."
    local now; now="$(getenforce 2>/dev/null || echo unknown)"
    [ "$now" = "Permissive" ] \
        || die "setenforce 0 reported success but getenforce says '$now'.
     Refusing to continue: the runtime mode is not what was asked for."
    log_ok "runtime mode is now Permissive (verified with getenforce)"
    _selinux_persist_permissive
    _selinux_record "permissive"
    _selinux_warn_scope
    return 0
}

# Make the mode survive a reboot, and verify the file says what we think.
_selinux_persist_permissive() {
    local cfg=/etc/selinux/config
    if [ ! -f "$cfg" ]; then
        log_warn "$cfg does not exist; the permissive mode will not survive a reboot"
        return 0
    fi
    $SUDO sed -i -E 's/^[[:space:]]*SELINUX=.*/SELINUX=permissive/' "$cfg" \
        || die "could not write $cfg"
    $SUDO grep -qx 'SELINUX=permissive' "$cfg" \
        || die "wrote $cfg but it does not contain 'SELINUX=permissive'.
     Current setting: $($SUDO grep -E '^[[:space:]]*SELINUX=' "$cfg" | head -1)
     Refusing to report a persistent change that did not happen."
    log_ok "$cfg set to SELINUX=permissive (verified by reading it back)"
}

# Persist what we did so `status` can report it on a later invocation, instead
# of always printing the initial value of a shell variable.
_selinux_record() {
    SELINUX_ACTION="$1"
    $SUDO mkdir -p "$STATE_DIR" 2>/dev/null || true
    printf '%s\n' "$1" | $SUDO tee "$STATE_DIR/selinux.action" >/dev/null 2>&1 || true
}

_selinux_warn_scope() {
    log_warn "SELinux is PERMISSIVE, and that is this demo's stated scope — not a"
    log_warn "  supported production configuration. openstack-selinux, the policy RDO"
    log_warn "  ships for exactly this, is published only in RDO's OpenStack component"
    log_warn "  repositories, which this shell refuses to enable because they carry"
    log_warn "  trunk libraries. Enforcing mode is out of scope and untested here."
}

# ---------------------------------------------------------------------------
# service helpers
# ---------------------------------------------------------------------------
declare -A SERVICE_START_METHOD
SKIPPED_PHASES=""

service_active() { $SUDO systemctl is-active --quiet "$1" 2>/dev/null; }

service_start_enable() {
    local unit="$1"
    if [ "$HAS_SYSTEMD" -ne 1 ]; then
        SERVICE_START_METHOD[$unit]="not-started-no-systemd"; return 0
    fi
    if service_active "$unit"; then
        SERVICE_START_METHOD[$unit]="already-active"; log_ok "$unit already running"
    else
        $SUDO systemctl enable --now "$unit" >/dev/null 2>&1 \
            || die "$unit failed to start; see 'journalctl -u $unit'"
        SERVICE_START_METHOD[$unit]="started"; log_ok "$unit started and enabled"
    fi
}

# Restart a unit when the configuration it reads is newer than the running
# process. ini_set only rewrites a file when the content changes, so an
# unchanged re-run restarts nothing. Carried over from the Ubuntu shell, where
# it was written because packages start their units before any configuration
# exists — EL packages do not do that, but the mtime rule is right either way.
service_apply() {   # service_apply <unit> <config-file>...
    local unit="$1"; shift
    if [ "$HAS_SYSTEMD" -ne 1 ]; then
        SERVICE_START_METHOD[$unit]="not-started-no-systemd"; return 0
    fi
    $SUDO systemctl enable "$unit" >/dev/null 2>&1 || true
    if ! service_active "$unit"; then
        $SUDO systemctl start "$unit" >/dev/null 2>&1 \
            || { log_warn "$unit failed to start; see 'journalctl -u $unit'"; return 1; }
        SERVICE_START_METHOD[$unit]="started"; log_ok "$unit started"
        return 0
    fi
    local started newest
    started="$(_unit_started_epoch "$unit" || echo 0)"
    newest="$(_newest_mtime "$@")"
    if [ "${newest:-0}" -gt "${started:-0}" ]; then
        $SUDO systemctl restart "$unit" \
            || { log_warn "$unit failed to restart"; return 1; }
        SERVICE_START_METHOD[$unit]="restarted"
        log_ok "$unit restarted (its configuration is newer than the running process)"
    else
        SERVICE_START_METHOD[$unit]="already-current"
        log_ok "$unit already running with the current configuration"
    fi
    return 0
}

httpd_grant_wsgi_dir() {   # httpd_grant_wsgi_dir <directory>
    local d="$1"
    local f="$HTTPD_CONF_D/01-hagistack-grant-$(basename "$(dirname "$d")").conf"
    local want
    want="$(printf '# WSGI scripts live outside DocumentRoot, so Apache needs an explicit grant.\n# Without it the answer is a plain Apache 403 that looks nothing like an\n# OpenStack error.\n<Directory %s>\n  Require all granted\n</Directory>' "$d")"
    local cur=""; [ -f "$f" ] && cur="$($SUDO cat "$f")"
    [ "$cur" = "$want" ] && return 1
    printf '%s\n' "$want" | $SUDO tee "$f" >/dev/null
    $SUDO chmod 0644 "$f"
    log_ok "httpd grant written for $d"
    return 0
}

# The openstack-dashboard RPM adds two ExecStartPre steps to httpd.service that
# regenerate the static assets, and both write into
# /usr/share/openstack-dashboard/static. httpd.service also sets
# ProtectSystem=yes, which makes /usr read-only for the unit, so httpd refuses
# to start at all:
#   OSError: [Errno 30] Read-only file system:
#     '/usr/share/openstack-dashboard/static/app/_app.scss'
# That is a conflict between two things the distribution ships, not a mistake
# here. The narrowest fix is to punch one writable hole rather than turn the
# protection off, so ProtectSystem keeps applying to the rest of /usr.
httpd_dashboard_writepath() {
    [ -d /usr/share/openstack-dashboard ] || return 1
    local f="/etc/systemd/system/httpd.service.d/10-hagistack-dashboard-static.conf"
    local want='[Service]
# openstack-dashboard adds ExecStartPre steps that write here, and
# ProtectSystem=yes would otherwise make it read-only and stop httpd starting.
ReadWritePaths=/usr/share/openstack-dashboard'
    local cur=""; [ -f "$f" ] && cur="$($SUDO cat "$f" 2>/dev/null)"
    [ "$cur" = "$want" ] && return 1
    $SUDO install -d -m 0755 "$(dirname "$f")"
    printf '%s\n' "$want" | $SUDO tee "$f" >/dev/null
    $SUDO chmod 0644 "$f"
    [ "$HAS_SYSTEMD" -eq 1 ] && $SUDO systemctl daemon-reload
    log_ok "httpd may write /usr/share/openstack-dashboard (the dashboard's own ExecStartPre needs it)"
    return 0
}

httpd_servername() {
    local f="$HTTPD_CONF_D/00-hagistack-servername.conf"
    local want="ServerName ${MGMT_IP}"
    $SUDO grep -qxF "$want" "$f" 2>/dev/null && return 1
    printf '%s\n' "$want" | $SUDO tee "$f" >/dev/null
    $SUDO chmod 0644 "$f"
    log_ok "httpd ServerName set to $MGMT_IP"
    return 0
}

httpd_reload() {
    if service_active httpd; then
        $SUDO systemctl reload-or-restart httpd || die "httpd failed to reload"
        log_ok "httpd reloaded"
    else
        service_start_enable httpd
    fi
}

# ---------------------------------------------------------------------------
# The vhost writer — the piece that exists because 2026.1 deleted the scripts.
#
# Every API here is an importable module, so a vhost is WSGIScriptAlias at a
# .py file under site-packages. The file is written only when its content
# changes, so a re-run reloads nothing.
# ---------------------------------------------------------------------------
write_vhost() {   # write_vhost <name> <port> <user> <module-path> [extra-alias]
    local name="$1" port="$2" user="$3" module="$4"
    local dest="$HTTPD_CONF_D/10-hagistack-$name.conf"
    [ -f "$module" ] || die "the WSGI module for $name does not exist: $module
     The package that should provide it is not installed, or 2026.1 moved it."
    local body
    body="$(cat <<EOF
# Written by hagistack. OpenStack 2026.1 removed the generated WSGI scripts
# (upstream release note: remove-wsgi-scripts), so there is nothing in
# /usr/bin to point at any more and the packaged unit for this service, where
# one exists at all, names a binary that is no longer built. mod_wsgi is
# pointed at the module instead.
Listen $port

<VirtualHost *:$port>
  WSGIDaemonProcess $name processes=3 threads=1 user=$user group=$user display-name=%{GROUP}
  WSGIProcessGroup $name
  WSGIScriptAlias / $module
  WSGIApplicationGroup %{GLOBAL}
  WSGIPassAuthorization On
  LimitRequestBody 114688
  <Directory $(dirname "$module")>
    Require all granted
  </Directory>
  ErrorLog /var/log/httpd/${name}_error.log
  CustomLog /var/log/httpd/${name}_access.log combined
</VirtualHost>
EOF
)"
    local cur=""
    [ -f "$dest" ] && cur="$($SUDO cat "$dest" 2>/dev/null)"
    if [ "$cur" = "$body" ]; then
        log_ok "vhost $name already correct (unchanged)"
        return 1
    fi
    printf '%s\n' "$body" | $SUDO tee "$dest" >/dev/null
    $SUDO chmod 0644 "$dest"
    log_ok "vhost $name written: :$port -> $module"
    return 0
}

