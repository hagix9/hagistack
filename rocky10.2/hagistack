# The name nova and OVN must agree on, pinned once and written to both sides.
#
# Neutron's OVN driver binds a port by looking up a Chassis whose HOSTNAME
# equals nova's binding:host_id. Left alone they disagree on Rocky: nova's
# CONF.host defaults to socket.gethostname() (short) while ovn-controller
# records the FQDN, and the only symptom is
#   Refusing to bind port ... due to no OVN chassis for host: <short name>
# with a chassis plainly visible in ovn-sbctl show. So both are set explicitly
# rather than left to two different defaults that happen to match on Ubuntu.
OS_HOSTNAME="$(hostname -s 2>/dev/null || hostname)"

# oslo.db defaults to max_pool_size=5 with max_overflow=50, PER PROCESS. On an
# all-in-one every service validates its tokens against Keystone, so Keystone
# runs out first and the whole cloud starts answering 500 after about forty
# minutes of use — which looks like "Neutron is broken", then "Nova is broken".
# Measured on Ubuntu with 53 GB free and MariaDB at 338 of 1024 connections:
# the server had room, the per-process pool did not.
DB_MAX_POOL_SIZE="${DB_MAX_POOL_SIZE:-25}"
DB_MAX_OVERFLOW="${DB_MAX_OVERFLOW:-50}"
DB_POOL_TIMEOUT="${DB_POOL_TIMEOUT:-30}"

SELF="${BASH_SOURCE[0]}"
SELF_DIR="$(cd "$(dirname "$SELF")" && pwd)"
# Deterministic, URL-safe secret. No fixed passwords anywhere in this file.
# A consumer-side `head` closes the pipe while the producer is still writing;
# the producer takes SIGPIPE and the pipeline reports 141 under `set -o pipefail`.
# `tr -dc … < /dev/urandom | head -c N` does that deterministically (measured:
# 141 on 200/200 runs). Bound the *producer* instead and trim with a shell
# substring, so no pipe is ever broken.
gen_secret() {
    local n="${1:-32}" out="" chunk tries=0
    while [ "${#out}" -lt "$n" ]; do
        tries=$((tries + 1))
        [ "$tries" -le 12 ] \
            || die "could not gather $n characters of randomness after $tries attempts"
        if have openssl; then
            chunk="$(openssl rand -base64 256 2>/dev/null | LC_ALL=C tr -dc 'A-Za-z0-9' || true)"
        else
            chunk="$(head -c 4096 /dev/urandom 2>/dev/null | LC_ALL=C tr -dc 'A-Za-z0-9' || true)"
        fi
        [ -n "$chunk" ] \
            || die "no usable entropy source (tried openssl and /dev/urandom)"
        out="$out$chunk"
    done
    printf '%s\n' "${out:0:n}"
}

# ---------------------------------------------------------------------------
# idempotent INI editing
#
# Replaces the old shells' `tee -a` / blanket `sed -i`, which appended a new
# copy on every run. Setting the same key twice must leave the file unchanged.
# ---------------------------------------------------------------------------
ini_set() {
    local file="$1" section="$2" key="$3" value="$4"
    [ -n "$file" ] && [ -n "$section" ] && [ -n "$key" ] \
        || die "ini_set: file, section and key are required"

    local dir; dir="$(dirname "$file")"
    [ -d "$dir" ] || $SUDO mkdir -p "$dir"
    [ -f "$file" ] || $SUDO touch "$file"

    local tmp; tmp="$(mktemp)"
    # Read through $SUDO: /etc/keystone/keystone.conf is 0640 keystone:keystone,
    # so a plain awk cannot open it when the shell runs unprivileged with sudo.
    $SUDO cat "$file" | SECTION="$section" KEY="$key" VALUE="$value" \
        awk '
        BEGIN { section=ENVIRON["SECTION"]; key=ENVIRON["KEY"]; value=ENVIRON["VALUE"]
                in_section=0; done=0; last_content=0 }
        {
            line=$0
            if (line ~ /^[[:space:]]*\[.*\][[:space:]]*$/) {
                name=line; sub(/^[[:space:]]*\[/,"",name); sub(/\][[:space:]]*$/,"",name)
                if (in_section && !done) { buf[++n]=key" = "value; done=1 }
                in_section = (name == section)
                buf[++n]=line
                if (in_section) last_content=n
                next
            }
            if (in_section && !done) {
                k=line
                sub(/^[[:space:]]*/,"",k)
                if (k ~ /^[#;]/) { buf[++n]=line; next }
                split(k, parts, "=")
                kk=parts[1]; gsub(/[[:space:]]+$/,"",kk)
                if (kk == key) { buf[++n]=key" = "value; done=1; last_content=n; next }
            }
            buf[++n]=line
            if (line !~ /^[[:space:]]*$/) last_content=n
        }
        END {
            if (!done) {
                if (!in_section) {
                    if (n > 0 && buf[n] != "") buf[++n]=""
                    buf[++n]="["section"]"
                }
                buf[++n]=key" = "value
            }
            for (i=1; i<=n; i++) print buf[i]
        }' > "$tmp"

    # Only touch the file when the content actually changes: re-running must
    # produce a byte-identical file and must not bump the mtime.
    if $SUDO cmp -s "$tmp" "$file"; then
        rm -f "$tmp"
        return 1   # unchanged
    fi
    $SUDO cp "$tmp" "$file"
    rm -f "$tmp"
    return 0       # changed
}

# Stop a key taking effect, without losing what it said.
#
# hagistack never deletes an operator's configuration, and that rule is right
# almost everywhere. It is wrong for exactly one case: a key whose mere presence
# makes a service do something harmful. A compute node that carries a
# [database] connection really does open it — nova-compute logs
#     WARNING oslo_db.sqlalchemy.engines SQL connection failed. 7 attempts left.
#     WARNING nova.context Timed out waiting for response from cell ...
# on every start, because oslo.db reads the key regardless of role.
#
# So the key is commented out rather than deleted: it stops taking effect, the
# value stays on the line so it can be put back, and a comment says who did it
# and why. Only the named key in the named section is touched — nothing else in
# the file is rewritten.
#
# Returns 0 when the file changed, 1 when it did not (key absent, or already
# commented out by an earlier run). That makes a second run a no-op, so
# service_apply sees no new mtime and restarts nothing.
ini_comment_out() {   # ini_comment_out <file> <section> <key> <why>
    local file="$1" section="$2" key="$3" why="${4:-}"
    [ -n "$file" ] && [ -n "$section" ] && [ -n "$key" ] \
        || die "ini_comment_out: file, section and key are required"
    $SUDO test -f "$file" || return 1

    local tmp; tmp="$(mktemp)"
    $SUDO cat "$file" | SECTION="$section" KEY="$key" WHY="$why" \
        awk '
        BEGIN { section=ENVIRON["SECTION"]; key=ENVIRON["KEY"]; why=ENVIRON["WHY"]
                in_section=0 }
        {
            line=$0
            if (line ~ /^[[:space:]]*\[.*\][[:space:]]*$/) {
                name=line; sub(/^[[:space:]]*\[/,"",name); sub(/\][[:space:]]*$/,"",name)
                in_section = (name == section)
                print line; next
            }
            if (in_section) {
                k=line
                sub(/^[[:space:]]*/,"",k)
                # an already-commented line is left exactly as it is
                if (k ~ /^[#;]/) { print line; next }
                eq=index(k,"=")
                if (eq > 0) {
                    kk=substr(k,1,eq-1); gsub(/[[:space:]]+$/,"",kk)
                    if (kk == key) {
                        print "# commented out by hagistack: " why
                        print "#" line
                        next
                    }
                }
            }
            print line
        }' > "$tmp"

    if $SUDO cmp -s "$tmp" "$file"; then
        rm -f "$tmp"
        return 1   # unchanged
    fi
    $SUDO cp "$tmp" "$file"
    rm -f "$tmp"
    return 0       # changed
}

ini_get() {
    local file="$1" section="$2" key="$3"
    $SUDO test -f "$file" || return 1
    $SUDO cat "$file" | SECTION="$section" KEY="$key" awk '
        BEGIN { section=ENVIRON["SECTION"]; key=ENVIRON["KEY"]; in_section=0 }
        /^[[:space:]]*\[.*\][[:space:]]*$/ {
            name=$0; sub(/^[[:space:]]*\[/,"",name); sub(/\][[:space:]]*$/,"",name)
            in_section=(name==section); next
        }
        in_section {
            k=$0; sub(/^[[:space:]]*/,"",k)
            if (k ~ /^[#;]/) next
            eq=index(k,"="); if (eq==0) next
            kk=substr(k,1,eq-1); vv=substr(k,eq+1)
            gsub(/[[:space:]]+$/,"",kk); gsub(/^[[:space:]]+/,"",vv); gsub(/[[:space:]]+$/,"",vv)
            if (kk==key) { print vv; exit }
        }'
}

load_env_file() {
    local f="${ENV_FILE:-}"
    if [ -z "$f" ]; then
        if   [ -f "./hagistack.env" ];             then f="./hagistack.env"
        elif [ -f "$SELF_DIR/hagistack.env" ];     then f="$SELF_DIR/hagistack.env"
        elif [ -f "$HAGISTACK_ETC/hagistack.env" ];then f="$HAGISTACK_ETC/hagistack.env"
        fi
    fi
    [ -n "$f" ] || return 0
    # Any readable path, not just a regular file, so --env-file /dev/null works.
    [ -r "$f" ] || die "env file not readable: $f"

    local -A seen=()
    local lineno=0 line key val
    while IFS= read -r line || [ -n "$line" ]; do
        lineno=$((lineno + 1))
        line="${line%$'\r'}"                       # tolerate CRLF
        [[ "$line" =~ ^[[:space:]]*(#|$) ]] && continue

        if [[ ! "$line" =~ ^[[:space:]]*([A-Za-z_][A-Za-z0-9_]*)[[:space:]]*=(.*)$ ]]; then
            die "$f line $lineno: not a KEY=VALUE assignment.
     Only blank lines, '#' comments and KEY=VALUE are allowed."
        fi
        key="${BASH_REMATCH[1]}"
        val="${BASH_REMATCH[2]}"
        val="${val%"${val##*[![:space:]]}"}"        # trim trailing blanks
        # strip one matching quote pair, if present
        if   [[ "$val" =~ ^\"(.*)\"$ ]]; then val="${BASH_REMATCH[1]}"
        elif [[ "$val" =~ ^\'(.*)\'$ ]]; then val="${BASH_REMATCH[1]}"
        fi

        # CONFIG_KEYS is written over several lines, so a key that happens to sit
        # at the end of one is followed by a NEWLINE, not a space. Matching
        # against " $CONFIG_KEYS " therefore missed those keys and reported them
        # as unknown — which is how FLOATING_START and REGION_NAME were refused
        # from a config file while working perfectly on the command line. The
        # list is normalised to single spaces before it is searched.
        case "$CONFIG_KEYS_FLAT" in
            *" $key "*) ;;
            *) die "$f line $lineno: unknown key '$key'.
     Allowed keys:${CONFIG_KEYS_FLAT%?}" ;;
        esac
        [ -z "${seen[$key]:-}" ] || die "$f line $lineno: duplicate key '$key'"
        seen[$key]=1

        # The value is deliberately NOT echoed back on failure.
        if [[ ! "$val" =~ $ENVFILE_VALUE_RE ]]; then
            die "$f line $lineno: the value of '$key' contains characters that are
     not allowed. Permitted: letters, digits and . _ - : / @ + =
     (the value itself is not shown). Shell metacharacters such as \$ \` ( ) ; & |
     are refused because this file is configuration, not a script."
        fi
        FILE_VAL[$key]="$val"
        FILE_SET[$key]=1
    done < "$f"
    log_info "config file: $f (parsed, not executed)"
}

# Precedence: command line > environment > config file > default.
# A tier that sets a key to the empty string is an error rather than a silent
# fall-through, so "explicitly blank" can never be mistaken for "not given".
resolve_config() {
    local k val src
    for k in $CONFIG_KEYS; do
        if   [ -n "${CLI_SET[$k]:-}" ];  then val="${CLI_VAL[$k]}";  src="command line"
        elif [ -n "${ENV_SET[$k]:-}" ];  then val="${ENV_VAL[$k]}";  src="environment"
        elif [ -n "${FILE_SET[$k]:-}" ]; then val="${FILE_VAL[$k]}"; src="config file"
        else                          val="${DEFAULT_VAL[$k]:-}"; src="default"
        fi
        if [ "$src" != "default" ] && [ -z "$val" ]; then
            die "$k was given an empty value on the $src.
     Remove it to fall back to the default, or give it a real value."
        fi
        CONFIG_SOURCE[$k]="$src"
        printf -v "$k" '%s' "$val"
    done
}

print_resolved_config() {
    local k
    echo
    log_step "resolved configuration"
    for k in $CONFIG_KEYS; do
        printf '    %-18s %-22s [%s]\n' "$k" "${!k:-<unset>}" "${CONFIG_SOURCE[$k]:-default}"
    done
}

# ---------------------------------------------------------------------------
# input validation
# ---------------------------------------------------------------------------
valid_ipv4() {
    local ip="$1" o
    [[ "$ip" =~ ^([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})$ ]] || return 1
    for o in "${BASH_REMATCH[@]:1:4}"; do
        [ "$o" -le 255 ] 2>/dev/null || return 1
        # reject 01, 007 and friends
        [ "${#o}" -eq 1 ] || [ "${o#0}" = "$o" ] || return 1
    done
    return 0
}

valid_cidr() {
    local cidr="$1" ip prefix
    case "$cidr" in */*) ;; *) return 1 ;; esac
    ip="${cidr%%/*}"; prefix="${cidr#*/}"
    valid_ipv4 "$ip" || return 1
    [[ "$prefix" =~ ^[0-9]{1,2}$ ]] || return 1
    [ "$prefix" -ge 8 ] && [ "$prefix" -le 30 ] || return 1
    return 0
}

ip_to_int() {
    local IFS=. ; read -r a b c d <<< "$1"
    echo $(( (a<<24) + (b<<16) + (c<<8) + d ))
}

ip_in_cidr() {
    local ip="$1" cidr="$2" net prefix mask ipi neti
    net="${cidr%%/*}"; prefix="${cidr#*/}"
    mask=$(( 0xFFFFFFFF ^ ((1 << (32-prefix)) - 1) ))
    ipi=$(ip_to_int "$ip"); neti=$(ip_to_int "$net")
    [ $(( ipi & mask )) -eq $(( neti & mask )) ]
}

valid_nic_name() {
    local n="$1"
    [ -n "$n" ] || return 1
    [ "${#n}" -le 15 ] || return 1
    [[ "$n" =~ ^[A-Za-z0-9_.-]+$ ]] || return 1
    case "$n" in .|..) return 1 ;; esac
    return 0
}

nic_exists() { [ -e "/sys/class/net/$1" ]; }

valid_region_name() {
    [ -n "$1" ] || return 1
    [ "${#1}" -le 64 ] || return 1
    [[ "$1" =~ ^[A-Za-z0-9._-]+$ ]]
}

# A name hagistack gives to something it creates in OpenStack (image, network,
# router, flavor, keypair). Deliberately narrow: these values end up in
# `openstack ... create` arguments, so no whitespace and no shell metacharacter
# is allowed through, even though the client is exec'd without a shell.
valid_resource_name() {
    [ -n "$1" ] || return 1
    [ "${#1}" -le 64 ] || return 1
    [[ "$1" =~ ^[A-Za-z0-9._-]+$ ]]
}

valid_sha256() { [[ "$1" =~ ^[0-9a-f]{64}$ ]]; }

# An absolute path with no traversal and no shell metacharacter. Used for
# IMAGE_FILE, which is read by root.
valid_abs_path() {
    local p="$1"
    case "$p" in /*) ;; *) return 1 ;; esac
    case "$p" in *..*) return 1 ;; esac
    [[ "$p" =~ ^[A-Za-z0-9._/-]+$ ]]
}

# http(s) URL restricted to the characters the config-file parser already
# allows, so a URL that survives the file cannot smuggle anything new in.
valid_http_url() {
    local u="$1"
    [[ "$u" =~ ^https?://[A-Za-z0-9._~:/@+=-]+$ ]] || return 1
    [ "${#u}" -le 512 ]
}

# An address that is supposed to belong to ANOTHER machine. Rejects the values
# that are never a peer: this catches "--controller-ip 127.0.0.1" and
# "--controller-ip 0.0.0.0", which otherwise fail much later with an opaque
# connection error. Caller must still compare it against MGMT_IP.
valid_peer_ipv4() {
    local ip="$1" a
    valid_ipv4 "$ip" || return 1
    a="${ip%%.*}"
    case "$ip" in
        0.*|127.*|255.255.255.255|169.254.*) return 1 ;;
    esac
    [ "$a" -lt 224 ] || return 1      # multicast / reserved
    return 0
}


# Start a unit, or RESTART it when the configuration it reads is newer than the
# running process.
#
# Measured on a GCE Ubuntu 26.04 host, and invisible in a container because a
# container has no systemd: every one of these packages starts its unit at
# install time, which is BEFORE hagistack writes any configuration —
#   memcached, glance-api, neutron-rpc-server, neutron-periodic-workers,
#   neutron-ovn-metadata-agent, nova-conductor, nova-scheduler, nova-compute.
# `systemctl enable --now` is a no-op on an already-active unit, so the daemon
# keeps running on the stock configuration (sqlite, 127.0.0.1) while the file on
# disk says otherwise, and `systemctl is-active` cheerfully reports success.
#
# Comparing the unit's start time with the mtime of the files it reads is what
# makes this self-correcting: ini_set only rewrites a file when its content
# actually changes, so an unchanged re-run restarts nothing.
_unit_started_epoch() {
    local t; t="$($SUDO systemctl show -p ExecMainStartTimestamp --value "$1" 2>/dev/null || true)"
    [ -n "$t" ] || return 1
    date -d "$t" +%s 2>/dev/null || return 1
}

_newest_mtime() {
    local f newest=0 m
    for f in "$@"; do
        $SUDO test -f "$f" || continue
        m="$($SUDO stat -c %Y "$f" 2>/dev/null || echo 0)"
        [ "$m" -gt "$newest" ] && newest="$m"
    done
    printf '%s\n' "$newest"
}

# Wait, bounded, for something to become true.
#
# `systemctl restart` returns as soon as the unit is active, which is seconds
# before the socket is listening. Probing immediately after a restart is a race,
# and on GCE it lost: memcached, glance-api and the Apache vhosts were each
# reported as "active but not answering" while they were simply still starting.
# Nothing here waits forever — that is the point of the bound.
wait_for() {   # wait_for <seconds> <what> <command...>
    local limit="$1" what="$2"; shift 2
    local waited=0
    while : ; do
        if "$@"; then
            [ "$waited" -gt 0 ] && log_info "$what became ready after ${waited}s"
            return 0
        fi
        [ "$waited" -lt "$limit" ] || return 1
        sleep 2; waited=$((waited + 2))
    done
}

note_skip() {
    SKIPPED_PHASES="${SKIPPED_PHASES}${SKIPPED_PHASES:+ }$1"
    log_warn "phase '$1' SKIPPED: $2"
    log_warn "  -> this run will NOT be reported as complete"
}

# Apply the pool settings to a service configuration file.
write_db_pool() {   # write_db_pool <conf> [section]
