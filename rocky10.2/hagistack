#!/usr/bin/env bash
# hagistack — OpenStack 2026.1 Gazpacho on Rocky Linux 10.2 (x86_64)
#
# A plain Bash installer. No Ansible, no Kolla, no Packstack, no DevStack: the
# point of this repository is that you can read the whole thing and see exactly
# what it does to your machine.
#
# WHERE THE PACKAGES COME FROM, which is the whole story on Rocky.
#
# Rocky does not ship OpenStack, and neither RDO nor the CentOS Cloud SIG
# publishes 2026.1 for EL10 — there is no `gazpacho-rdo` distgit branch and no
# `centos10-gazpacho` repository. So the RPMs are built from the released 2026.1
# tarballs against RDO's `rpm-master` specs, with every input pinned by commit
# id and sha256, by ../rocky10.2/build-rpms.sh. That build is a prerequisite for
# this shell, not a part of it: point --repo-url at its output.
#
# This shell deliberately does NOT enable RDO's `delorean-component-*`
# repositories. Those carry trunk snapshots of the OpenStack libraries and would
# silently replace a 2026.1 library with a 2025-era build. It does use RDO's
# dependency repository, which carries third-party Python libraries (eventlet,
# httplib2, pysaml2 and friends) that neither Rocky nor EPEL package. That is a
# different tree and mixes no OpenStack releases.
#
# HOW THE APIs ARE STARTED, which is the other half of the story.
#
# OpenStack 2026.1 removed the generated WSGI scripts across the board and
# replaced them with importable modules. On Rocky that leaves the packaging with
# nothing usable for four of the five APIs — `openstack-nova-api.service` and
# friends still name `/usr/bin/nova-api`, which 33.0.2 does not build. Measured
# on a real install, not assumed:
#
#   keystone    no unit, no vhost          -> this shell writes the vhost
#   placement   vhost ships and works      -> used as shipped
#   glance      openstack-glance-api.service works (glance kept its daemon)
#   neutron     API has no unit and no vhost -> this shell writes the vhost
#   nova API    three units, all dead      -> this shell writes the vhosts
#
# So every vhost below points mod_wsgi at a module path, and the dead units are
# left disabled rather than "fixed" by inventing an ExecStart.
set -euo pipefail

HAGISTACK_VERSION="0.1.0-rocky"
HAGISTACK_STAGE="rocky step1: all-in-one and compute-add implemented; verification in progress"
TARGET_OS="Rocky Linux 10.2 (x86_64)"
TARGET_RELEASE="OpenStack 2026.1 Gazpacho"
VERIFIED_ON_HARDWARE="see rocky10.2/README.md; nothing here is claimed until it is measured"
UNVERIFIED_ITEMS="Horizon (its XStatic/qrcode dependencies are unresolved on EL10); SELinux in enforcing mode; any physical-LAN path"

C_RESET=''; C_RED=''; C_GRN=''; C_YEL=''; C_BLU=''; C_DIM=''
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
    C_RESET=$'\033[0m'; C_RED=$'\033[31m'; C_GRN=$'\033[32m'
    C_YEL=$'\033[33m';  C_BLU=$'\033[34m'; C_DIM=$'\033[2m'
fi
log_step()  { printf '%s==>%s %s\n'      "$C_BLU" "$C_RESET" "$*"; }
log_info()  { printf '    %s\n'                                "$*"; }
log_ok()    { printf '    %sok%s   %s\n' "$C_GRN" "$C_RESET" "$*"; }
log_warn()  { printf '%swarn:%s %s\n'    "$C_YEL" "$C_RESET" "$*" >&2; }
log_error() { printf '%serror:%s %s\n'   "$C_RED" "$C_RESET" "$*" >&2; }
log_skip()  { printf '    %sskip%s %s\n' "$C_DIM" "$C_RESET" "$*"; }
die() { log_error "$*"; exit 1; }

_on_err() {
    local rc=$? line=${1:-?}
    log_error "aborted at line $line (exit $rc). Nothing is rolled back: this shell"
    log_error "  only ever adds or edits, so a re-run continues from where it stopped."
    exit "$rc"
}
trap '_on_err $LINENO' ERR

SUDO=""
_need_privilege() {
    if [ "$(id -u)" -ne 0 ]; then
        command -v sudo >/dev/null 2>&1 || die "not root and sudo is not installed"
        sudo -n true 2>/dev/null || sudo true || die "sudo authentication failed"
        SUDO="sudo"
    fi
}

have() { command -v "$1" >/dev/null 2>&1; }

