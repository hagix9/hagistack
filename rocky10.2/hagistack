print_banner() {
    local rule="────────────────────────────────────────────────────────────────"
    echo; echo " $rule"
    if [ -n "$SKIPPED_PHASES" ]; then
        printf ' %sINCOMPLETE%s — these phases were skipped: %s\n' "$C_YEL" "$C_RESET" "$SKIPPED_PHASES"
        echo " Nothing here is a working cloud. Fix the cause and re-run; it is safe."
    else
        printf ' %severy phase completed%s\n' "$C_GRN" "$C_RESET"
    fi
    echo
    echo " $TARGET_RELEASE on $TARGET_OS — this host: $DEPLOY_ROLE"
    case "$RPM_SOURCE" in
        repo-url) echo " RPMs       : your repository $REPO_URL (not verified by hagistack)" ;;
        *)        echo " RPMs       : $RPM_SOURCE, set ${RPM_SET_SHA256:0:16}… in $RPM_SET_DIR" ;;
    esac
    case "$SELINUX_ACTION" in
      permissive)
        printf ' %sSELinux is PERMISSIVE%s (verified with getenforce) — the stated scope of\n this demo. Enforcing is out of scope; openstack-selinux is not available\n in a single-release repository.\n' "$C_YEL" "$C_RESET" ;;
      disabled-by-host)
        printf ' %sSELinux is DISABLED on this host%s — NOT the configuration this shell was\n verified in, and not the same as permissive. Reported, not corrected.\n' "$C_YEL" "$C_RESET" ;;
    esac
    echo
    if [ "$REMOTE_COMPUTE" -eq 0 ]; then
        echo " Credentials: $HAGISTACK_ETC/admin-openrc (mode 0600)"
        if phase_done horizon; then
            echo " Dashboard  : http://$MGMT_IP$HORIZON_URL_PATH/   (user: admin)"
            echo "              the admin password is in admin-openrc; it is never printed here"
        fi
        echo
        if [ "$DEPLOY_ROLE" = "controller" ]; then
            echo " This is a controller with NO hypervisor: guests cannot boot until a"
            echo " compute node exists. That is expected. Add one:"
            echo "   on this host : sudo hagistack compute-add --local"
        else
            echo " Boot a guest to find out whether any of this actually works:"
            echo "   . $HAGISTACK_ETC/admin-openrc"
            echo "   openstack server create --flavor m1.tiny --image ${IMAGE_NAME} \\"
            echo "       --network hagistack-tenant --key-name hagistack-key demo1"
        fi
        echo
        echo " Add a compute node on another host:"
        echo "   here      : sudo hagistack compute-secrets > compute-secrets.env"
        if [ "$RPM_SOURCE" = "build" ] || [ "$RPM_SOURCE" = "bundle" ]; then
            echo "               sudo hagistack rpm-bundle --output /root/hagistack-rpms.tar"
            echo "   on node2  : sudo hagistack compute-add --controller-ip $MGMT_IP \\"
            echo "                   --rpm-source bundle --rpm-bundle /root/hagistack-rpms.tar"
        elif [ "$RPM_SOURCE" = "repo-url" ]; then
            echo "   on node2  : sudo hagistack compute-add --controller-ip $MGMT_IP --repo-url $REPO_URL"
        else
            echo "   on node2  : sudo hagistack compute-add --controller-ip $MGMT_IP"
        fi
        echo "   back here : sudo hagistack discover-hosts"
    fi
    echo " $rule"
    [ -n "$SKIPPED_PHASES" ] && return 4
    return 0
}

# What each command may do to a host that hagistack has already deployed.
# The rule is that nothing ever silently changes what a host is:
#   controller  -> all-in-one (by `all-in-one` or `compute-add --local`): allowed,
#                  it only adds the hypervisor
#   anything else that changes the role: refused
role_guard() {
    local cur="${DEPLOY[ROLE]:-}"
    case "$SUBCOMMAND:$LOCAL_COMPUTE:$cur" in
        *:*:)                          [ "$LOCAL_COMPUTE" -eq 0 ] \
                                           || die "compute-add --local runs on a hagistack controller; this host has no deployment record ($DEPLOYMENT_FILE)" ;;
        all-in-one:0:all-in-one|all-in-one:0:controller) ;;
        controller:0:controller) ;;
        controller:0:all-in-one)       die "this host is already all-in-one (it runs nova-compute).
     hagistack does not remove a hypervisor; 'controller' would leave it running
     while reporting a controller-only host." ;;
        compute-add:1:controller|compute-add:1:all-in-one) ;;
        compute-add:0:compute) ;;
        compute-add:0:*)               die "this host is a hagistack $cur. A remote compute node must be a separate host;
     to add a hypervisor HERE use: sudo hagistack compute-add --local" ;;
        *:*:compute)                   die "this host is a hagistack compute node; refusing to turn it into a $SUBCOMMAND" ;;
        *)                             die "refusing: '$SUBCOMMAND' on a host recorded as '$cur' ($DEPLOYMENT_FILE)" ;;
    esac
    [ -z "$cur" ] || log_ok "deployment record: this host is '$cur'"
}

_deploy_common_controller() {
    phase_rpm_source
    phase_repos
    phase_selinux
    phase_secrets
    phase_packages
    phase_database
    phase_rabbitmq
    phase_memcached
    phase_keystone
    phase_glance
    phase_placement
    phase_ovn
    phase_neutron
    phase_nova
}

cmd_all_in_one() {
    SUBCOMMAND="all-in-one"; DEPLOY_ROLE="all-in-one"
    phase_preflight
    [ "$CHECK_ONLY" -eq 1 ] && { print_resolved_config; return 0; }
    _deploy_common_controller
    phase_nova_compute
    phase_bootstrap_resources
    phase_horizon
    print_banner
}

cmd_controller() {
    SUBCOMMAND="controller"; DEPLOY_ROLE="controller"
    phase_preflight
    [ "$CHECK_ONLY" -eq 1 ] && { print_resolved_config; return 0; }
    _deploy_common_controller
    # No nova-compute here, on purpose. Nova API, scheduler and conductor run;
    # a guest cannot be scheduled until a compute node registers.
    phase_bootstrap_resources
    phase_horizon
    print_banner
}

cmd_compute_add() {
    SUBCOMMAND="compute-add"
    if [ "$LOCAL_COMPUTE" -eq 1 ]; then
        REMOTE_COMPUTE=0; DEPLOY_ROLE="all-in-one"
        phase_preflight
        [ "$CHECK_ONLY" -eq 1 ] && { print_resolved_config; return 0; }
        # The controller is left exactly as it is: no configuration phase of
        # the controller is run again. nova.conf already carries the compute
        # settings (driver, virt_type) because the controller wrote them.
        phase_rpm_source
        phase_repos
        phase_selinux
        phase_packages
        phase_nova_compute
        print_banner
        return
    fi
    REMOTE_COMPUTE=1; DEPLOY_ROLE="compute"
    phase_preflight
    [ "$CHECK_ONLY" -eq 1 ] && { print_resolved_config; return 0; }
    phase_secrets
    phase_compute_preflight
    phase_rpm_source
    phase_repos
    phase_selinux
    phase_packages
    phase_ovn
    phase_compute_nova
    phase_compute_metadata
    print_banner
}

# Prepare (download/build/unpack and verify) the RPM set without installing
# anything. Useful to start a long source build ahead of time; a later
# all-in-one/controller run reuses the result.
cmd_rpm_prepare() {
    _need_privilege
    log_step "preflight (RPM preparation only)"
    _preflight_host
    rpm_source_resolve
    if [ "$RPM_SOURCE" = "bundle" ] && [ -z "$RPM_SET_EXPECTED" ]; then
        die "--rpm-source bundle needs --rpm-set-sha256 here (there is no compute-secrets to read it from)"
    fi
    [ "$RPM_SOURCE" != "repo-url" ] || die "rpm-prepare has nothing to prepare for --repo-url"
    phase_rpm_source
    echo
    echo "RPM_SET_SHA256=$RPM_SET_SHA256"
    echo "RPM_SET_DIR=$RPM_SET_DIR"
}

# Write the RPM set this host was deployed from as a tarball, for compute nodes.
cmd_rpm_bundle() {
    _need_privilege
    [ -n "$BUNDLE_OUTPUT" ] || die "rpm-bundle needs --output FILE"
    valid_abs_path "$BUNDLE_OUTPUT" || die "--output must be an absolute path without '..'"
    $SUDO test -e "$BUNDLE_OUTPUT" && die "$BUNDLE_OUTPUT already exists; refusing to overwrite it"
    deploy_load
    local d="${DEPLOY[RPM_SET_DIR]:-}" want="${DEPLOY[RPM_SET_SHA256]:-}"
    [ -n "$d" ] && [ -n "$want" ] && [ "$want" != "repo-url" ] \
        || die "this host has no hagistack-managed RPM set to bundle (deployed with --repo-url, or not deployed)"
    rpm_verify_set "$d" "$want" >/dev/null || die "the deployed RPM set no longer verifies; not bundling it"
    local tmp; tmp="$($SUDO mktemp "$(dirname "$BUNDLE_OUTPUT")/.rpm-bundle.XXXXXX")"
    $SUDO tar -cf "$tmp" -C "$d" --owner=0 --group=0 --numeric-owner RPM-SHA256SUMS repo \
        || { $SUDO rm -f "$tmp"; die "could not write the bundle"; }
    $SUDO chmod 0644 "$tmp"; $SUDO mv "$tmp" "$BUNDLE_OUTPUT"
    log_ok "wrote $BUNDLE_OUTPUT ($($SUDO stat -c %s "$BUNDLE_OUTPUT") bytes)"
    echo "RPM_SET_SHA256=$want"
    log_info "compute-secrets carries this identity; compute-add verifies the bundle against it"
}

cmd_compute_secrets() {
    _need_privilege
    [ -t 1 ] && die "refusing to print secrets to a terminal. Redirect to a file:
       sudo hagistack compute-secrets > compute-secrets.env"
    [ -f "$SECRETS_FILE" ] || die "$SECRETS_FILE does not exist; run all-in-one or controller first"
    deploy_load
    # Diagnostics go to stderr, because stdout IS the credentials file.
    log_info "reading $SECRETS_FILE" >&2
    echo "# hagistack compute-node credentials — generated $(date -u +%FT%TZ)"
    echo "# Install as $SECRETS_FILE, mode 0600, and delete this copy."
    echo "# Deliberately NOT included: every database password and ADMIN_PASSWORD."
    local line k v
    while IFS= read -r line; do
        case "$line" in ''|\#*) continue ;; esac
        k="${line%%=*}"; v="${line#*=}"
        case " $COMPUTE_SECRET_KEYS " in *" $k "*) printf '%s=%s\n' "$k" "$v" ;; esac
    done < <($SUDO cat "$SECRETS_FILE")
    # Not a secret: which RPM set the controller runs, so a compute node can
    # refuse to join with different packages.
    if [ -n "${DEPLOY[RPM_SET_SHA256]:-}" ]; then
        echo "# The controller's RPM set (not a secret); compute-add refuses any other."
        printf 'RPM_SET_SHA256=%s\n' "${DEPLOY[RPM_SET_SHA256]}"
    fi
}

cmd_discover_hosts() {
    _need_privilege
    log_step "mapping new compute hosts into a cell"
    nova_manage cell_v2 discover_hosts --verbose 2>&1 | sed 's/^/    /'
    set -a; . "$HAGISTACK_ETC/admin-openrc"; set +a
    openstack hypervisor list 2>/dev/null | sed 's/^/    /'
    log_warn "a mapped hypervisor is not a booted guest."
}

cmd_status() {
    _need_privilege
    deploy_load
    echo "hagistack $HAGISTACK_VERSION"
    echo "  stage        : $HAGISTACK_STAGE"
    echo "  target       : $TARGET_RELEASE on $TARGET_OS"
    echo "  role         : ${DEPLOY[ROLE]:-not deployed}"
    echo "  rpm source   : ${DEPLOY[RPM_SOURCE]:--}  set ${DEPLOY[RPM_SET_SHA256]:--}"
    echo "  unverified   : $UNVERIFIED_ITEMS"
    local sel_now sel_cfg sel_act
    sel_now="$(have getenforce && getenforce 2>/dev/null || echo n/a)"
    sel_cfg="$($SUDO grep -hE '^[[:space:]]*SELINUX=' /etc/selinux/config 2>/dev/null | head -1 | cut -d= -f2)"
    sel_act="$($SUDO cat "$STATE_DIR/selinux.action" 2>/dev/null || echo not-examined)"
    echo "  selinux      : now=$sel_now  on-boot=${sel_cfg:-unknown}  (hagistack action: $sel_act)"
    case "$sel_now" in
      Disabled) echo "                 NOTE: Disabled is NOT the verified configuration; the demo scope is Permissive" ;;
      Enforcing) echo "                 NOTE: enforcing is out of scope here and untested" ;;
    esac
    echo "  phases done  :"
    $SUDO ls "$STATE_DIR" 2>/dev/null | grep '\.done$' | sed 's/\.done$//; s/^/    /' || echo "    (none)"
    echo "  services     :"
    local u
    for u in mariadb rabbitmq-server memcached httpd openstack-glance-api \
             ovn-northd ovn-controller openvswitch neutron-rpc-server \
             neutron-periodic-workers neutron-ovn-maintenance-worker \
             neutron-ovn-metadata-agent openstack-nova-conductor \
             openstack-nova-scheduler openstack-nova-compute libvirtd; do
        printf '    %-32s %s\n' "$u" "$($SUDO systemctl is-active "$u" 2>/dev/null || echo -)"
    done
}

usage() {
    cat <<EOF
hagistack $HAGISTACK_VERSION — $TARGET_RELEASE on $TARGET_OS

  STAGE: $HAGISTACK_STAGE

usage:
  hagistack all-in-one   [options]   controller + compute on one host
  hagistack controller   [options]   controller services only, no hypervisor
  hagistack compute-add --local      add nova-compute to THIS controller
  hagistack compute-add --controller-ip IP [options]
                                     this host becomes an extra compute node
  hagistack compute-secrets          (controller) emit only the credentials a
                                     compute node needs; refuses a terminal
  hagistack discover-hosts           (controller) map new compute hosts into a cell
  hagistack rpm-prepare  [rpm options]  prepare and verify the RPM set only
  hagistack rpm-bundle --output FILE (controller) write this host's RPM set as a
                                     tarball for compute nodes
  hagistack status                   role, RPM set, phases, SELinux and services

where the RPMs come from (Rocky ships no OpenStack):
  --rpm-source github      download the release pinned in rpm-release.lock and
                           verify it against that pin                 (default)
  --rpm-source build       build every RPM from source with build-rpms.sh, in
                           a disposable container on this host (takes hours)
  --rpm-source bundle      use a tarball made by 'hagistack rpm-bundle'
    --rpm-bundle FILE        the tarball
    --rpm-set-sha256 HEX     expected set identity (read from compute-secrets
                             when omitted on compute-add)
  --rpm-source repo-url    a repository you run yourself (same as --repo-url)
    --repo-url URL           http(s)://... or file:///path
  --rpm-lock-file PATH     another lock file (testing a mirror)   [github only]
  --build-image REF@sha256:...  another pinned build image         [build only]
  A failed download never starts a build, and a failed build never downloads.
  A re-run reuses an already verified set; nothing is fetched or built twice.

options for all-in-one and controller:
  --ext-nic NAME           provider/external interface            (required)
  --provider-cidr CIDR     external network, e.g. 172.24.4.0/24   (required)
  --provider-gateway IP    gateway on that network                (required)
  --floating-start IP      first floating IP                      (required)
  --floating-end IP        last floating IP                       (required)
  --tenant-cidr CIDR       demo tenant subnet      (default: 10.10.10.0/24)
  --dns-server IP          tenant DNS              (default: provider gateway)
  --image-name/--image-url/--image-sha256/--image-file

options for compute-add:
  --controller-ip IP       the controller's management address (remote compute)
  --local                  add the hypervisor to this controller instead

common options:
  --mgmt-ip IP             management IP           (default: autodetected)
  --virt-type kvm|qemu     hypervisor mode         (default: autodetected)
  --region-name NAME       Keystone region         (default: RegionOne)
  --env-file PATH          read settings from PATH (default: ./hagistack.env)
  --check                  preflight only, change nothing
  -h, --help               this text

exit status:
  0 success   1 configuration or preflight error   2 usage error
  4 ran to the end but a phase was skipped, so the deployment is incomplete
EOF
}

_cli_set() { [ $# -eq 2 ] || die "option $1 requires a value"; CLI_VAL[$1]="$2"; CLI_SET[$1]=1; }
BUNDLE_OUTPUT=""

parse_args() {
    [ $# -gt 0 ] || { usage; exit 2; }
    SUBCOMMAND="$1"; shift
    case "$SUBCOMMAND" in
        all-in-one|controller|compute-add|compute-secrets|discover-hosts|status|rpm-prepare|rpm-bundle) ;;
        -h|--help) usage; exit 0 ;;
        --version) echo "hagistack $HAGISTACK_VERSION"; exit 0 ;;
        *) log_error "unknown command: $SUBCOMMAND"; usage; exit 2 ;;
    esac
    while [ $# -gt 0 ]; do
        case "$1" in
            --mgmt-ip)          _cli_set MGMT_IP "${2:-}"; shift 2 ;;
            --ext-nic)          _cli_set EXT_NIC "${2:-}"; shift 2 ;;
            --provider-cidr)    _cli_set PROVIDER_CIDR "${2:-}"; shift 2 ;;
            --provider-gateway) _cli_set PROVIDER_GATEWAY "${2:-}"; shift 2 ;;
            --floating-start)   _cli_set FLOATING_START "${2:-}"; shift 2 ;;
            --floating-end)     _cli_set FLOATING_END "${2:-}"; shift 2 ;;
            --tenant-cidr)      _cli_set TENANT_CIDR "${2:-}"; shift 2 ;;
            --dns-server)       _cli_set DNS_SERVER "${2:-}"; shift 2 ;;
            --virt-type)        _cli_set VIRT_TYPE "${2:-}"; shift 2 ;;
            --region-name)      _cli_set REGION_NAME "${2:-}"; shift 2 ;;
            --provider-physnet) _cli_set PROVIDER_PHYSNET "${2:-}"; shift 2 ;;
            --provider-bridge)  _cli_set PROVIDER_BRIDGE "${2:-}"; shift 2 ;;
            --controller-ip)    _cli_set CONTROLLER_IP "${2:-}"; shift 2 ;;
            --repo-url)         _cli_set REPO_URL "${2:-}"; shift 2 ;;
            --rpm-source)       _cli_set RPM_SOURCE "${2:-}"; shift 2 ;;
            --rpm-bundle)       _cli_set RPM_BUNDLE "${2:-}"; shift 2 ;;
            --rpm-lock-file)    _cli_set RPM_LOCK_FILE "${2:-}"; shift 2 ;;
            --build-image)      _cli_set BUILD_IMAGE "${2:-}"; shift 2 ;;
            --rpm-set-sha256)   _cli_set RPM_SET_EXPECTED "${2:-}"; shift 2 ;;
            --image-name)       _cli_set IMAGE_NAME "${2:-}"; shift 2 ;;
            --image-url)        _cli_set IMAGE_URL "${2:-}"; shift 2 ;;
            --image-sha256)     _cli_set IMAGE_SHA256 "${2:-}"; shift 2 ;;
            --image-file)       _cli_set IMAGE_FILE "${2:-}"; shift 2 ;;
            --local)            LOCAL_COMPUTE=1; shift ;;
            --output)           [ -n "${2:-}" ] || die "--output requires a value"; BUNDLE_OUTPUT="$2"; shift 2 ;;
            --env-file)         ENV_FILE="${2:-}"; shift 2 ;;
            --check)            CHECK_ONLY=1; shift ;;
            -h|--help)          usage; exit 0 ;;
            *) log_error "unknown option: $1"; usage; exit 2 ;;
        esac
    done
    if [ "$LOCAL_COMPUTE" -eq 1 ] && [ "$SUBCOMMAND" != "compute-add" ]; then
        log_error "--local only applies to compute-add"; exit 2
    fi
    if [ -n "$BUNDLE_OUTPUT" ] && [ "$SUBCOMMAND" != "rpm-bundle" ]; then
        log_error "--output only applies to rpm-bundle"; exit 2
    fi
}

main() {
    parse_args "$@"
    case "$SUBCOMMAND" in
        compute-secrets) cmd_compute_secrets; exit 0 ;;
        discover-hosts)  cmd_discover_hosts;  exit 0 ;;
        status)          cmd_status;          exit 0 ;;
        rpm-bundle)      cmd_rpm_bundle;      exit 0 ;;
    esac
    _need_privilege
    _capture_defaults
    _capture_env
    load_env_file
    resolve_config
    case "$SUBCOMMAND" in
        all-in-one)  cmd_all_in_one ;;
        controller)  cmd_controller ;;
        compute-add) cmd_compute_add ;;
        rpm-prepare) cmd_rpm_prepare ;;
    esac
}

# Sourcing the file (tests) defines the functions without running anything.
if [ "${HAGISTACK_LIB_ONLY:-0}" != "1" ]; then
    main "$@"
fi
