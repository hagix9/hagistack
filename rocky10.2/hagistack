    # -k: escalate to SIGKILL. `rabbitmqctl` does not die on SIGTERM, so a
    # plain `timeout` waits forever on it — measured in a container where the
    # node never became ready.
    if have timeout; then $SUDO timeout -k 5 "$PROBE_TIMEOUT" "$@"
    else                  $SUDO "$@"
